---
/**
 * NotFoundView — shared 404 body (zh/en).
 */
import Icon from './ui/Icon.astro';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="measure-wrap py-[clamp(3rem,8vw,6rem)]">
  <p class="label mb-6">404</p>
  <h1 class="h2 max-w-[26rem]">{t('notFound.title')}</h1>
  <p class="lede mt-5 max-w-[30rem] text-[1.0625rem]">{t('notFound.text')}</p>

  <div class="mt-10 flex flex-wrap items-center gap-3">
    <a href={localizePath('/', lang)} class="btn btn--solid">
      <Icon name="arrow-left" size={15} />
      {t('notFound.back')}
    </a>
    <a href={localizePath('/works', lang)} class="btn">{t('nav.works')}</a>
    <a href={localizePath('/writing', lang)} class="btn">{t('nav.writing')}</a>
  </div>
</section>
