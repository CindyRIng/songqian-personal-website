---
/**
 * LanguageSwitcher — a quiet glass popover with the six locales.
 *
 * It is rendered in three places (desktop rail, mobile bar, footer), each with
 * a different placement. One hoisted script drives every instance: toggle on
 * click, close on Escape / outside click / focus loss, aria-expanded kept in
 * sync, and the current path is preserved per locale via `getAlternates`.
 */
import Icon from '../ui/Icon.astro';
import { useTranslations, getAlternates, stripLocale } from '../../i18n/utils';
import { localeMeta, type Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
  /** Locale-free pathname to preserve. Defaults to the current URL. */
  path?: string;
  variant?: 'rail' | 'bar' | 'footer';
  class?: string;
}

const { lang, path, variant = 'rail', class: className = '' } = Astro.props;

const t = useTranslations(lang);
const currentPath = path ?? stripLocale(Astro.url.pathname).path;
const alternates = getAlternates(currentPath);
const panelId = `lang-panel-${variant}`;
const currentLabel = localeMeta[lang].nativeLabel;

const placement: Record<NonNullable<Props['variant']>, string> = {
  // Opens to the right of the desktop rail.
  rail: 'left-full top-1/2 ml-3 w-56 -translate-y-1/2 origin-left',
  // Opens below the mobile top bar, right-aligned to the trigger.
  bar: 'right-0 top-full mt-2 w-60 origin-top-right',
  // Opens above the footer trigger.
  footer: 'bottom-full right-0 mb-2 w-60 origin-bottom-right',
};

const triggerClass: Record<NonNullable<Props['variant']>, string> = {
  rail: 'size-9',
  bar: 'size-8',
  footer: 'h-6 gap-1.5 px-0.5',
};
---

<div data-lang-root class:list={['relative', className]}>
  {variant === 'footer' ? (
    <button
      type="button"
      data-lang-trigger
      aria-expanded="false"
      aria-controls={panelId}
      aria-haspopup="true"
      aria-label={`${t('lang.switch')}: ${currentLabel}`}
      class:list={[
        'inline-flex items-center rounded-full font-sans text-[0.75rem] text-subtle transition-colors duration-200 hover:text-ink',
        triggerClass[variant],
      ]}
    >
      <Icon name="globe" size={12} class="text-faint" />
      <span class="max-w-24 truncate">{currentLabel}</span>
      <Icon name="chevron-down" size={11} class="text-faint" />
    </button>
  ) : (
    <button
      type="button"
      data-lang-trigger
      aria-expanded="false"
      aria-controls={panelId}
      aria-haspopup="true"
      aria-label={`${t('lang.switch')}: ${currentLabel}`}
      title={t('lang.switch')}
      class:list={[
        'grid place-items-center rounded-full text-subtle transition-colors duration-200 hover:bg-hover hover:text-ink',
        triggerClass[variant],
      ]}
    >
      <Icon name="globe" size={17} />
    </button>
  )}

  <div id={panelId} data-lang-panel hidden class:list={['glass absolute z-60 rounded-[1.125rem] p-1.5', placement[variant]]}>
    <p class="eyebrow px-2 pb-1.5 pt-1">{t('lang.choose')}</p>
    <ul class="flex flex-col">
      {alternates.map((alt) => (
        <li>
          <a
            href={alt.href}
            hreflang={localeMeta[alt.lang].htmlLang}
            lang={localeMeta[alt.lang].htmlLang}
            aria-current={alt.lang === lang ? 'true' : undefined}
            class:list={[
              'flex items-center gap-2.5 rounded-[0.7rem] px-2 py-1.5 font-sans text-[0.8125rem] leading-none transition-colors duration-150',
              alt.lang === lang ? 'text-ink-strong' : 'text-muted hover:bg-hover hover:text-ink',
            ]}
          >
            <span class="flex-1 truncate">{localeMeta[alt.lang].nativeLabel}</span>
            <span
              class:list={[
                'font-mono text-[0.625rem] uppercase tracking-[0.08em]',
                alt.lang === lang ? 'text-accent' : 'text-faint',
              ]}
            >
              {alt.lang}
            </span>
            {alt.lang === lang && <Icon name="check" size={13} class="text-accent" />}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  [data-lang-panel]:not([hidden]) {
    animation: lang-pop 180ms var(--ease-out);
  }

  @keyframes lang-pop {
    from {
      opacity: 0;
      scale: 0.97;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-lang-panel]:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  type LangRoot = HTMLElement;

  const roots = Array.from(document.querySelectorAll<LangRoot>('[data-lang-root]'));

  function parts(root: LangRoot) {
    return {
      trigger: root.querySelector<HTMLButtonElement>('[data-lang-trigger]'),
      panel: root.querySelector<HTMLElement>('[data-lang-panel]'),
    };
  }

  function close(root: LangRoot) {
    const { trigger, panel } = parts(root);
    if (!trigger || !panel || panel.hidden) return;
    panel.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
    delete root.dataset.open;
  }

  function open(root: LangRoot, focusFirst = false) {
    roots.forEach((other) => other !== root && close(other));
    const { trigger, panel } = parts(root);
    if (!trigger || !panel) return;
    panel.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
    root.dataset.open = '';
    if (focusFirst) panel.querySelector<HTMLAnchorElement>('a')?.focus();
  }

  roots.forEach((root) => {
    const { trigger, panel } = parts(root);
    if (!trigger || !panel) return;

    trigger.addEventListener('click', () => {
      if (panel.hidden) open(root);
      else close(root);
    });

    // Escape closes and returns focus to the trigger.
    root.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || panel.hidden) return;
      event.preventDefault();
      close(root);
      trigger.focus();
    });

    // Tabbing out of the popover closes it.
    root.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !root.contains(next)) close(root);
    });

    // Following a language link resets the popover for bfcache restores.
    panel.addEventListener('click', (event) => {
      if ((event.target as Element | null)?.closest('a')) close(root);
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    roots.forEach((root) => {
      if (!target || !root.contains(target)) close(root);
    });
  });
</script>
