---
/**
 * SiteFooter — the global "contact + colophon" close for every page.
 *
 * Interaction contract (polish pass A):
 *   - email / phone copy to the clipboard on click with an aria-live toast;
 *   - GitHub / RSS are real links with an underline that draws on hover;
 *   - the WeChat QR (when configured) opens a quiet native-dialog lightbox;
 *   - back-to-top is a real button: smooth scroll, reduced-motion → instant;
 *   - every control has a ≥44px hit area, a visible focus ring, and hovers
 *     only on capable pointers (all hover rules inside the media query).
 *
 * Optional channels stay hidden when absent: `profile.contact.phone` is blank
 * until a number is public, and the QR only renders when the image exists in
 * `public/images/`.
 */
import { existsSync } from 'node:fs';
import { copy, c, pair } from '../../data/copy';
import { profile, lt } from '../../data/profile';
import type { Locale } from '../../i18n/config';
import { localizePath, useTranslations } from '../../i18n/utils';

interface Props {
  lang: Locale;
  /** Locale-free current path (passed by BaseLayout). */
  path?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
const heading = c(copy.contact.heading, lang);
const contactLabel = pair(copy.sections.contact.title, lang);
const shortCta = c(copy.sections.contact.lede, lang);
const body = c(copy.contact.body, lang);
const tagline = lt(profile.tagline, lang);
const availability = c(copy.home.availability, lang);

const email = profile.contact.email;
const phone = profile.contact.phone?.trim() || '';
const github = profile.socials.find((social) => social.label === 'GitHub');
const rssHref = localizePath('/rss.xml', lang);

const qrCandidates = [
  'public/images/wechat-qr.png',
  'public/images/wechat-qr.webp',
  'public/images/wechat-qr.jpg',
];
const qrSrc = qrCandidates.find((candidate) => existsSync(candidate));
const qrUrl = qrSrc ? `/${qrSrc.replace(/^public\//, '')}` : '';

const wechatLabel = c(copy.contact.wechatLabel, lang);
const wechatHint = c(copy.contact.wechatHint, lang);
const copiedLabel = t('writing.codeCopied');
const closeLabel = t('a11y.close');

type Row =
  | { kind: 'copy'; label: string; value: string }
  | { kind: 'link'; label: string; value: string; href: string; external?: boolean };

const contactRows: Row[] = [
  { kind: 'copy', label: c(copy.contact.emailLabel, lang), value: email },
  ...(phone
    ? [{ kind: 'copy' as const, label: c(copy.contact.phoneLabel, lang), value: phone }]
    : []),
  ...(github
    ? [
        {
          kind: 'link' as const,
          label: c(copy.contact.githubLabel, lang),
          value: github.href.replace(/^https?:\/\//, ''),
          href: github.href,
          external: true,
        },
      ]
    : []),
  { kind: 'link', label: c(copy.contact.rssLabel, lang), value: 'RSS', href: rssHref },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="contact-block">
      <div class="contact-lead">
        <p class="footer-label">
          <span class="footer-number" aria-hidden="true">◎</span>
          {contactLabel.title} / {contactLabel.secondary}
        </p>
        <h2 class="contact-heading">{heading}</h2>
        <p class="contact-body">{body}</p>
        <p class="contact-tagline">“{tagline}”</p>
      </div>

      <div class="contact-side">
        <dl class="contact-rows">
          {
            contactRows.map((row) => (
              <div class="contact-row">
                <dt>{row.label}</dt>
                <dd>
                  {row.kind === 'copy' ? (
                    <button
                      type="button"
                      class="contact-control contact-copy focus-ring"
                      data-copy={row.value}
                      aria-label={`${row.label}: ${row.value}`}
                    >
                      <span class="contact-value">{row.value}</span>
                      <span class="copy-glyph" aria-hidden="true">
                        ⧉
                      </span>
                    </button>
                  ) : (
                    <a
                      class="contact-control contact-link focus-ring"
                      href={row.href}
                      target={row.external ? '_blank' : undefined}
                      rel={row.external ? 'noreferrer noopener' : undefined}
                    >
                      <span class="contact-value draw-underline">{row.value}</span>
                      <span class="link-glyph" aria-hidden="true">
                        {row.external ? '↗' : '→'}
                      </span>
                    </a>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>

        {
          qrUrl && (
            <button
              type="button"
              class="wechat-button focus-ring"
              data-qr-open
              aria-label={`${wechatLabel} — ${wechatHint}`}
            >
              <img
                src={qrUrl}
                alt={wechatLabel}
                width="112"
                height="112"
                loading="lazy"
                decoding="async"
              />
              <span class="wechat-meta">
                <span class="wechat-hint">{wechatHint}</span>
                <span class="wechat-zoom mono" aria-hidden="true">
                  ⤢ {wechatLabel}
                </span>
              </span>
            </button>
          )
        }

        <p class="contact-status">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{availability}</span>
        </p>
      </div>
    </div>

    <div class="footer-bar">
      <p class="footer-copy">
        {t('footer.copyright', { year })}
        <span class="footer-sep" aria-hidden="true">·</span>
        <span class="footer-muted">{t('footer.builtWith')}</span>
      </p>

      <div class="footer-email">
        <span class="footer-email-label">{shortCta}</span>
        <button
          type="button"
          class="footer-email-copy focus-ring"
          data-copy={email}
          aria-label={`${c(copy.contact.emailLabel, lang)}: ${email}`}
        >
          <span class="draw-underline">{email}</span>
        </button>
      </div>

      <nav class="footer-links" aria-label={contactLabel.title}>
        <a class="footer-link focus-ring" href="/notes">{t('nav.notes')}</a>
        <a class="footer-link focus-ring" href="/reading">{t('nav.reading')}</a>
        <a class="footer-link focus-ring" href="/now">{t('nav.now')}</a>
        <span class="footer-links-sep" aria-hidden="true"></span>
        {
          github && (
            <a
              class="footer-link focus-ring"
              href={github.href}
              target="_blank"
              rel="noreferrer noopener"
            >
              GitHub
            </a>
          )
        }
        <a class="footer-link focus-ring" href={rssHref}>{t('footer.rss')}</a>
        <button type="button" class="footer-link footer-top focus-ring" data-back-to-top>
          {t('footer.top')} <span aria-hidden="true">↑</span>
        </button>
      </nav>
    </div>
  </div>

  <span
    class="copy-toast"
    data-copy-toast
    role="status"
    aria-live="polite"
    data-copied-label={copiedLabel}></span>

  {
    qrUrl && (
      <dialog class="qr-dialog" data-qr-dialog aria-label={wechatLabel}>
        <figure class="qr-figure">
          <img data-qr-image src={qrUrl} alt={wechatLabel} width="520" height="520" />
          <figcaption>{wechatHint}</figcaption>
        </figure>
        <button type="button" class="qr-close focus-ring" data-qr-close aria-label={closeLabel}>
          ×
        </button>
      </dialog>
    )
  }
</footer>

<script>
  /* Page-agnostic footer interactions: one delegated listener, no per-page
     re-binding. Everything degrades to nothing when JS is absent. */
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      try {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.append(area);
        area.select();
        const ok = document.execCommand('copy');
        area.remove();
        return ok;
      } catch {
        return false;
      }
    }
  }

  let toastTimer = 0;
  let lastQrTrigger: HTMLElement | null = null;

  function showToast(message: string) {
    const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
    if (!toast) return;
    toast.textContent = message;
    toast.setAttribute('data-visible', '');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.removeAttribute('data-visible'), 1600);
  }

  document.addEventListener('click', async (event) => {
    const target = event.target as Element | null;

    const copyButton = target?.closest<HTMLElement>('[data-copy]');
    if (copyButton) {
      const value = copyButton.dataset.copy ?? '';
      const ok = await copyText(value);
      if (!ok) return;
      const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
      showToast(toast?.dataset.copiedLabel ?? 'Copied');
      copyButton.setAttribute('data-copied', '');
      window.setTimeout(() => copyButton.removeAttribute('data-copied'), 1200);
      return;
    }

    const topButton = target?.closest<HTMLElement>('[data-back-to-top]');
    if (topButton) {
      window.scrollTo({ top: 0, behavior: reduced() ? 'auto' : 'smooth' });
      return;
    }

    const qrTrigger = target?.closest<HTMLElement>('[data-qr-open]');
    if (qrTrigger) {
      const dialog = document.querySelector<HTMLDialogElement>('[data-qr-dialog]');
      const image = dialog?.querySelector<HTMLImageElement>('[data-qr-image]');
      const source = qrTrigger.querySelector<HTMLImageElement>('img');
      if (!dialog || !image || !source) return;
      lastQrTrigger = qrTrigger;
      image.src = source.currentSrc || source.src;
      dialog.showModal();
      dialog.querySelector<HTMLElement>('[data-qr-close]')?.focus();
    }
  });

  /* QR lightbox: backdrop click closes; the native dialog owns Esc + focus
     trap; on close, focus returns to the trigger. */
  document.addEventListener('click', (event) => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-qr-dialog]');
    if (!dialog || !dialog.open) return;
    if (event.target === dialog) dialog.close();
    if ((event.target as Element | null)?.closest('[data-qr-close]')) dialog.close();
  });

  document.addEventListener(
    'close',
    (event) => {
      if (!(event.target instanceof HTMLDialogElement)) return;
      if (!event.target.matches('[data-qr-dialog]')) return;
      lastQrTrigger?.focus();
      lastQrTrigger = null;
    },
    true
  );
</script>

<style>
  .site-footer {
    position: relative;
    z-index: 10;
    margin-top: clamp(3.5rem, 5.5vw, 5rem);
    border-top: 2px solid var(--ink);
    background: var(--canvas);
  }

  .contact-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
    gap: clamp(2.5rem, 6vw, 5.25rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    align-items: start;
  }

  .footer-label {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-number {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .contact-heading {
    margin-top: 1.125rem;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 3.4vw, 2.875rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--ink-strong);
    text-wrap: balance;
  }

  .contact-body {
    margin-top: 1.125rem;
    max-width: 34rem;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.78;
    color: var(--muted);
    text-wrap: pretty;
  }

  .contact-tagline {
    margin-top: 1.625rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--line);
    max-width: 34rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--subtle);
  }

  .contact-side {
    padding-top: 0.25rem;
  }

  .contact-rows {
    border-top: 1px solid var(--line);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.875rem;
    align-items: center;
    min-height: 3.25rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .contact-row dt {
    font-family: var(--font-mono);
    font-size: 0.5938rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--subtle);
  }

  .contact-row dd {
    min-width: 0;
    margin: 0;
  }

  /* Email / phone: a full-width copy button with a quiet affordance glyph.
     GitHub / RSS: real links with a drawing underline. Both share the same
     44px hit row and the same focus ring. */
  .contact-control {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    max-width: 100%;
    margin-inline: -0.25rem;
    padding: 0.25rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.7813rem;
    letter-spacing: 0.01em;
    line-height: 1.5;
    color: var(--ink);
    text-align: start;
    text-decoration: none;
    cursor: pointer;
    transition:
      color var(--dur-1, 120ms) ease-out,
      background-color var(--dur-1, 120ms) ease-out;
  }

  .contact-value {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .copy-glyph,
  .link-glyph {
    flex: 0 0 auto;
    color: var(--subtle);
    transition:
      color var(--dur-1, 120ms) ease-out,
      transform var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  .contact-control:active {
    transform: translateY(1px);
  }

  .contact-control[data-copied] {
    color: var(--accent-strong);
  }

  .contact-control[data-copied] .copy-glyph {
    color: var(--accent);
    transform: scale(1.1);
  }

  /* --- wechat QR (only when configured) ---------------------------------- */
  .wechat-button {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 1.125rem;
    margin-inline: -0.5rem;
    padding: 0.5rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--ink);
    text-align: start;
    cursor: pointer;
  }

  .wechat-button img {
    display: block;
    width: 112px;
    height: 112px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper, var(--canvas));
    transition: border-color var(--dur-1, 120ms) ease-out;
  }

  .wechat-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--subtle);
  }

  .wechat-zoom {
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--accent-strong);
  }

  .wechat-button:active {
    transform: translateY(1px);
  }

  .contact-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.375rem 0.8125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill, 999px);
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    letter-spacing: 0.03em;
    color: var(--ink);
  }

  .status-dot {
    position: relative;
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    opacity: 0;
    animation: footer-breathe 3s var(--ease-out, cubic-bezier(0.22, 0.61, 0.36, 1)) infinite;
  }

  @keyframes footer-breathe {
    0% {
      opacity: 0.5;
      transform: scale(0.9);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  /* --- narrow bar -------------------------------------------------------- */
  .footer-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: 1.125rem max(1.75rem, env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.5938rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--subtle);
  }

  .footer-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .footer-sep {
    color: var(--faint);
  }

  .footer-muted {
    color: var(--subtle);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .footer-email {
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .footer-email-label {
    color: var(--faint);
  }

  .footer-email-copy {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.25rem 0;
    border: 0;
    background: transparent;
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink);
    cursor: pointer;
  }

  .footer-email-copy .draw-underline {
    padding-bottom: 2px;
  }

  .footer-links-sep {
    width: 1px;
    height: 0.875rem;
    background: var(--line);
    align-self: center;
  }

  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.125rem;
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--muted);
    text-decoration: none;
    cursor: pointer;
  }

  .footer-top {
    gap: 0.25rem;
  }

  .footer-top span {
    color: var(--accent);
    transition: transform var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  /* --- toast ------------------------------------------------------------- */
  .copy-toast {
    position: fixed;
    left: 50%;
    bottom: max(1.5rem, env(safe-area-inset-bottom, 0px));
    z-index: 90;
    translate: -50% 8px;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill, 999px);
    background: var(--ink-strong);
    color: var(--canvas);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--dur-2, 200ms) var(--ease-out, ease-out),
      translate var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  .copy-toast:empty {
    display: none;
  }

  .copy-toast[data-visible] {
    opacity: 1;
    translate: -50% 0;
  }

  /* --- QR lightbox ------------------------------------------------------- */
  .qr-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    width: fit-content;
    max-width: min(92vw, 34rem);
    max-height: 88dvh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .qr-dialog[open] {
    display: grid;
    place-items: center;
  }

  .qr-dialog::backdrop {
    background: var(--overlay);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .qr-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    margin: 0;
    padding: 1rem;
    border-radius: 6px;
    background: var(--paper, var(--canvas));
    box-shadow: var(--shadow-lg);
  }

  .qr-figure img {
    display: block;
    width: min(72vw, 420px);
    height: auto;
    aspect-ratio: 1;
    border-radius: 4px;
    background: #fff;
  }

  .qr-figure figcaption {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .qr-close {
    position: fixed;
    top: max(0.75rem, env(safe-area-inset-top, 0px));
    right: max(0.75rem, env(safe-area-inset-right, 0px));
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--overlay-line);
    border-radius: var(--radius-pill, 999px);
    background: color-mix(in oklab, var(--overlay-ink) 10%, transparent);
    color: var(--overlay-ink);
    font-family: var(--font-sans);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  /* --- hover: only on capable pointers ---------------------------------- */
  @media (hover: hover) and (pointer: fine) {
    .contact-control:hover {
      color: var(--accent-strong);
      background: var(--hover);
    }

    .contact-control:hover .copy-glyph,
    .contact-control:hover .link-glyph {
      color: var(--accent);
      transform: translateX(2px);
    }

    .wechat-button:hover img {
      border-color: var(--accent-line);
    }

    .footer-links a:hover,
    .footer-links button:hover {
      color: var(--accent-strong);
    }

    .footer-top:hover span {
      transform: translateY(-2px);
    }
  }

  @media (max-width: 900px) {
    .contact-block {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact-side {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .contact-heading {
      font-size: 2.25rem;
    }

    .footer-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.875rem;
    }

    .wechat-button img {
      width: 96px;
      height: 96px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot::after {
      animation: none;
    }

    .contact-control,
    .copy-glyph,
    .link-glyph,
    .wechat-button img,
    .footer-top span,
    .copy-toast {
      transition: none;
    }

    .copy-toast {
      translate: -50% 0;
    }

    .contact-control:active,
    .wechat-button:active {
      transform: none;
    }
  }
</style>
