---
/**
 * SiteNav — the floating chrome.
 *
 * Desktop (xl+): a fixed vertical glass rail at the left edge — five icon links
 * with a pill active state and hover/focus tooltips to the right, then a
 * theme toggle + language switcher below it.
 *
 * Mobile / tablet: a single horizontal glass pill pinned below the safe area
 * at the top of the viewport (icons, theme toggle, language switcher).
 *
 * Icons only, so every link keeps an accessible name; the tooltip is decorative
 * and hidden on touch devices.
 */
import Icon from '../ui/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, localizePath, stripLocale } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type NavKey = 'home' | 'about' | 'writing' | 'projects' | 'timeline';

const items: { key: NavKey; icon: 'home' | 'user' | 'writing' | 'projects' | 'timeline'; href: string; labelKey: 'nav.home' | 'nav.about' | 'nav.writing' | 'nav.projects' | 'nav.timeline' }[] = [
  { key: 'home', icon: 'home', href: '/', labelKey: 'nav.home' },
  { key: 'about', icon: 'user', href: '/about', labelKey: 'nav.about' },
  { key: 'writing', icon: 'writing', href: '/writing', labelKey: 'nav.writing' },
  { key: 'projects', icon: 'projects', href: '/projects', labelKey: 'nav.projects' },
  { key: 'timeline', icon: 'timeline', href: '/timeline', labelKey: 'nav.timeline' },
];

const currentPath = stripLocale(Astro.url.pathname).path;
const isActive = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);

const navLabel = t('nav.menu');
---

{/* Desktop — fixed vertical rail */}
<nav
  aria-label={navLabel}
  class="fixed left-5 top-24 z-50 hidden flex-col items-center gap-2.5 2xl:left-8 2xl:top-28 xl:flex"
>
  <div class="glass flex flex-col items-center gap-1 rounded-[1.25rem] p-1.5">
    {
      items.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={localizePath(item.href, lang)}
            aria-label={t(item.labelKey)}
            aria-current={active ? 'page' : undefined}
            style={active ? 'view-transition-name: nav-active' : undefined}
            class:list={[
              'group/nav relative grid size-10 place-items-center rounded-[1rem] transition-[color,background-color,box-shadow] duration-[var(--dur-2)] ease-out',
              active
                ? 'bg-elevated text-accent shadow-sm ring-1 ring-line'
                : 'text-subtle hover:bg-hover hover:text-ink',
            ]}
          >
          <Icon
            name={item.icon}
            size={19}
            class="transition-transform duration-300 ease-out motion-safe:group-hover/nav:scale-110"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute left-full top-1/2 ml-3 hidden -translate-x-1 -translate-y-1/2 whitespace-nowrap rounded-full border border-line bg-elevated px-3 py-1 font-sans text-[0.8125rem] font-medium text-ink opacity-0 shadow-md transition-[opacity,translate] duration-200 ease-out group-hover/nav:translate-x-0 group-hover/nav:opacity-100 group-focus-visible/nav:translate-x-0 group-focus-visible/nav:opacity-100 [@media(hover:hover)]:flex"
          >
            {t(item.labelKey)}
          </span>
          </a>
        );
      })
    }
  </div>

  <div class="glass flex flex-col items-center gap-1 rounded-full p-1">
    <ThemeToggle lang={lang} />
    <LanguageSwitcher lang={lang} path={currentPath} variant="rail" />
  </div>
</nav>

{/* Mobile / tablet — sticky horizontal pill */}
<nav
  aria-label={navLabel}
  class="fixed left-1/2 top-[calc(env(safe-area-inset-top,0px)+0.75rem)] z-50 flex -translate-x-1/2 items-center rounded-full p-1 min-[360px]:p-1.5 xl:hidden glass"
>
  {
    items.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={localizePath(item.href, lang)}
          aria-label={t(item.labelKey)}
          aria-current={active ? 'page' : undefined}
          style={active ? 'view-transition-name: nav-active' : undefined}
          class:list={[
            'grid size-11 place-items-center rounded-full transition-colors duration-200 ease-out',
            active
              ? 'bg-elevated text-accent shadow-sm ring-1 ring-line'
              : 'text-subtle hover:bg-hover hover:text-ink active:bg-hover-strong',
          ]}
        >
          <Icon name={item.icon} size={18} />
        </a>
      );
    })
  }
  <span aria-hidden="true" class="mx-1 hidden h-5 w-px bg-line min-[360px]:block" />
  <ThemeToggle lang={lang} compact />
  <LanguageSwitcher lang={lang} path={currentPath} variant="bar" />
</nav>
