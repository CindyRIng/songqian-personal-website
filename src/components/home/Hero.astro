---
/**
 * Hero — short, plain opening. Kicker, name, one role line, two paragraphs,
 * three CTAs. No quick-facts column (that content now lives in "现在"),
 * no bilingual role line, no availability badge.
 *
 * Each block opts into BaseLayout's [data-hero-step] stagger via --stagger.
 */
import { copy, c } from '../../data/copy';
import { localizePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const kicker = c(copy.home.kicker, lang);
const primaryName = lang === 'zh' ? copy.home.name.zh : copy.home.latinName;
const secondaryName = lang === 'zh' ? copy.home.latinName : copy.home.name.zh;
const role = c(copy.home.role, lang);
const intro = copy.home.intro.map((paragraph) => c(paragraph, lang));

const ctas = [
  {
    label: c(copy.home.ctas.writing, lang),
    href: localizePath('/writing', lang),
    primary: true,
  },
  {
    label: c(copy.home.ctas.works, lang),
    href: localizePath('/works', lang),
    primary: false,
  },
  {
    label: c(copy.home.ctas.contact, lang),
    href: '/now/',
    primary: false,
  },
];
---

<section class="hero wrap" aria-labelledby="hero-title">
  <p class="hero-kicker" data-hero-step style="--stagger:0">
    <span class="hero-kicker-line" aria-hidden="true"></span>
    <span>{kicker}</span>
  </p>

  <h1 id="hero-title" class="hero-title" data-hero-step style="--stagger:1">
    {primaryName}
    <span class:list={['hero-alt', lang === 'zh' && 'hero-alt--latin']}>{secondaryName}</span>
  </h1>

  <p class="hero-role" data-hero-step style="--stagger:2">{role}</p>

  <div class="hero-bio" data-hero-step style="--stagger:3">
    {intro.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <div class="hero-cta" data-hero-step style="--stagger:4">
    {
      ctas.map((cta) => (
        <a
          href={cta.href}
          class:list={['btn', cta.primary ? 'btn--solid' : 'btn--quiet']}
        >
          <span>{cta.label}</span>
          <span class="hero-cta-arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(1.5rem, 2.5vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6563rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-kicker-line {
    width: 2.5rem;
    height: 1px;
    background: color-mix(in oklab, var(--ink) 26%, transparent);
  }

  .hero-title {
    margin-top: 1.375rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 1.125rem;
    font-family: var(--font-serif);
    font-size: var(--text-display);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.06;
    color: var(--ink-strong);
  }

  .hero-alt {
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 3.2vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--subtle);
    font-style: normal;
  }

  .hero-alt--latin {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: -0.02em;
  }

  .hero-role {
    margin-top: 1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .hero-bio {
    margin-top: 1.625rem;
    max-width: 39rem;
  }

  .hero-bio p {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.82;
    color: var(--ink);
    text-wrap: pretty;
  }

  .hero-bio p + p {
    margin-top: 1rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-cta-arrow {
    display: inline-block;
    color: var(--accent);
    transition: transform var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  .btn--solid .hero-cta-arrow {
    color: inherit;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-cta .btn:hover .hero-cta-arrow {
      transform: translateX(3px);
    }
  }

  @media (max-width: 640px) {
    .hero-bio {
      margin-top: 1.375rem;
    }

    .hero-bio p {
      font-size: 1rem;
      line-height: 1.78;
    }

    .hero-cta {
      gap: 0.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta-arrow {
      transition: none;
    }

    .hero-cta .btn:hover .hero-cta-arrow {
      transform: none;
    }
  }
</style>
