---
/**
 * NotesSection — "最近在想": three recent fragments from the diary/notes,
 * dated, dense, two columns on desktop. No cards, no numbers, no English.
 */
import SectionHead from '../ui/SectionHead.astro';
import { copy, c } from '../../data/copy';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

export interface NoteItem {
  date: string;
  text: string;
  tags?: string[];
}

interface Props {
  lang: Locale;
  notes: NoteItem[];
  class?: string;
}

const { lang, notes, class: className = '' } = Astro.props;
const t = useTranslations(lang);

const dashDate = (iso: string) => iso.slice(0, 10).replaceAll('-', '.');
---

{
  notes.length > 0 && (
    <section class:list={['notes', className]} aria-labelledby="notes-title">
      <div class="wrap">
        <SectionHead
          title={c(copy.home.notesTitle, lang)}
          lede={c(copy.home.notesLede, lang)}
          href="/notes/"
          actionLabel={t('common.more')}
          id="notes-title"
        />

        <ul class="note-list">
          {notes.map((note) => (
            <li class="note">
              <p class="note-date mono">{dashDate(note.date)}</p>
              <p class="note-text">{note.text}</p>
              {note.tags && note.tags.length > 0 && (
                <p class="note-tags mono">{note.tags.slice(0, 3).join(' · ')}</p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .notes {
    margin-top: clamp(2.75rem, 4.5vw, 4rem);
  }

  .note-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: 0;
    margin-top: 1.25rem;
  }

  .note {
    padding-block: 1.25rem 1.375rem;
    border-top: 1px solid var(--line);
    min-width: 0;
  }

  .note-date {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--subtle);
    font-variant-numeric: tabular-nums;
  }

  .note-text {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.0313rem;
    line-height: 1.82;
    letter-spacing: 0.005em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .note-tags {
    margin-top: 0.625rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--subtle);
  }

  @media (max-width: 900px) {
    .note-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .note {
      padding-block: 1.125rem 1.25rem;
    }
  }
</style>
