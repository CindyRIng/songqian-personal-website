---
/**
 * ProjectCard — one "selected work" entry on the home page.
 *
 * A compact horizontal editorial row: generated cover plate on the left, then a
 * quiet `year · status` meta line above the serif title and a two-line tagline.
 * The whole row is the link; hover washes the row and zooms the plate slightly.
 */
import Icon from '../ui/Icon.astro';
import CoverArt from '../projects/CoverArt.astro';
import { useTranslations } from '../../i18n/utils';
import { initialsOf } from '../../lib/format';
import type { Locale } from '../../i18n/config';
import type { ProjectStatus } from '../../lib/projects';

interface Props {
  lang: Locale;
  slug: string;
  title: string;
  tagline: string;
  year: number | string;
  status: ProjectStatus;
  href: string;
  index: number;
  eyebrow?: string;
}

const { lang, slug, title, tagline, year, status, href, index } = Astro.props;
const t = useTranslations(lang);

/** The plate wordmark is intentionally short so it never wraps at card size. */
const shortTitle = /^[\u3040-\u30ff\u3400-\u9fff]/.test(title.trim())
  ? [...title.trim()].slice(0, 2).join('')
  : (title.trim().split(/\s+/)[0] ?? title);

const statusKey = {
  live: 'status.live',
  shipped: 'status.shipped',
  'in-progress': 'status.inProgress',
  archived: 'status.archived',
  concept: 'status.concept',
} as const;

const isQuiet = status === 'archived' || status === 'concept';
const dotClass = isQuiet ? 'bg-faint' : 'bg-accent';
---

<a
  href={href}
  class="group/card -mx-2 flex flex-col gap-3 rounded-[18px] p-2 transition-colors duration-200 hover:bg-hover focus-visible:outline-offset-2 min-[480px]:flex-row min-[480px]:items-center min-[480px]:gap-5 min-[480px]:pr-3"
>
  <div
    class="relative w-full shrink-0 overflow-hidden rounded-[13px] border border-line-strong motion-safe:transition-shadow motion-safe:duration-300 group-hover/card:shadow-md min-[480px]:w-[7.5rem] sm:w-[9rem]"
  >
    <CoverArt
      slug={slug}
      title={shortTitle}
      mono={initialsOf(title, 2)}
      index={index}
      class="aspect-[16/9] w-full motion-safe:transition-transform motion-safe:duration-[900ms] motion-safe:ease-out motion-safe:group-hover/card:scale-[1.04] min-[480px]:aspect-[4/3]"
    />
  </div>

  <div class="flex min-w-0 flex-1 flex-col gap-1">
    <p class="flex items-center gap-1.5 font-mono text-[0.6875rem] uppercase leading-none tracking-[0.1em]">
      <span class="text-subtle">{year}</span>
      <span aria-hidden="true" class="text-faint">·</span>
      <span class="inline-flex items-center gap-1.5 text-subtle">
        <span aria-hidden="true" class:list={['size-1 rounded-full', dotClass]}></span>
        {t(statusKey[status])}
      </span>
    </p>
    <h3
      class="text-pretty font-serif text-[1.0625rem] font-[550] leading-snug tracking-[-0.012em] text-ink-strong"
    >
      {title}
    </h3>
    <p class="line-clamp-2 text-pretty font-serif text-[0.8125rem] leading-[1.5] text-muted">{tagline}</p>
  </div>

  <Icon
    name="arrow-up-right"
    size={15}
    class="hidden shrink-0 text-faint opacity-0 min-[480px]:block transition-[opacity,transform] duration-300 ease-out group-hover/card:-translate-y-0.5 group-hover/card:translate-x-0.5 group-hover/card:text-accent group-hover/card:opacity-100"
  />
</a>
