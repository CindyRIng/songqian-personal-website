---
/**
 * ProjectCard — one "selected work" card on the home page.
 *
 * A shared generated cover plate (src/components/projects/CoverArt.astro, so
 * home and the Projects page use identical art), a gentle zoom on hover, then a
 * single quiet meta line (`year · status`) above the serif title and tagline.
 */
import Icon from '../ui/Icon.astro';
import CoverArt from '../projects/CoverArt.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import type { ProjectStatus } from '../../lib/projects';

interface Props {
  lang: Locale;
  slug: string;
  title: string;
  tagline: string;
  year: number | string;
  status: ProjectStatus;
  href: string;
  index: number;
  eyebrow?: string;
}

const { lang, slug, title, tagline, year, status, href, index, eyebrow } = Astro.props;
const t = useTranslations(lang);

const statusKey = {
  live: 'status.live',
  shipped: 'status.shipped',
  'in-progress': 'status.inProgress',
  archived: 'status.archived',
  concept: 'status.concept',
} as const;

const isQuiet = status === 'archived' || status === 'concept';
const dotClass = isQuiet ? 'bg-faint' : 'bg-accent';
const statusClass = isQuiet ? 'text-faint' : 'text-subtle';
---

<a
  href={href}
  class="group/card flex flex-col gap-3 rounded-[18px] focus-visible:outline-offset-4"
>
  <div
    class="relative overflow-hidden rounded-[18px] border border-line motion-safe:transition-[box-shadow,border-color] motion-safe:duration-500 group-hover/card:border-line-strong group-hover/card:shadow-md"
  >
    <CoverArt
      slug={slug}
      title={title}
      index={index}
      eyebrow={eyebrow}
      class="aspect-[4/3] w-full motion-safe:transition-transform motion-safe:duration-[900ms] motion-safe:ease-out motion-safe:group-hover/card:scale-[1.03]"
    />
    <span
      aria-hidden="true"
      class="pointer-events-none absolute bottom-2.5 right-2.5 grid size-7 translate-y-1 place-items-center rounded-full border border-line bg-elevated/95 text-ink opacity-0 shadow-sm backdrop-blur transition-[opacity,translate] duration-300 ease-out group-hover/card:translate-y-0 group-hover/card:opacity-100 motion-safe:transition-[opacity,translate]"
    >
      <Icon name="arrow-up-right" size={13} />
    </span>
  </div>

  <div class="flex flex-col gap-1.5">
    <p
      class="flex flex-wrap items-center gap-x-1.5 gap-y-1 font-mono text-[0.625rem] uppercase leading-none tracking-[0.12em]"
    >
      <span class="text-subtle">{year}</span>
      <span aria-hidden="true" class="text-faint">·</span>
      <span class:list={['inline-flex items-center gap-1.5', statusClass]}>
        <span aria-hidden="true" class:list={['size-1 rounded-full', dotClass]}></span>
        {t(statusKey[status])}
      </span>
    </p>
    <h3
      class="font-serif text-[0.9375rem] font-[550] leading-snug tracking-[-0.01em] text-ink-strong sm:text-[1rem]"
    >
      {title}
    </h3>
    <p class="line-clamp-2 font-serif text-[0.8125rem] leading-[1.45] text-muted">{tagline}</p>
  </div>
</a>
