---
/**
 * ProjectCover — deterministic CSS cover art for a project card.
 *
 * No stock photography and no external assets: a paper-toned gradient field
 * chosen by hashing the slug, a typographic monogram, a tiny year and index.
 * The art layer scales gently on card hover (the card is the `group`).
 */
import { hashString, initialsOf } from '../../lib/format';

interface Props {
  title: string;
  slug: string;
  year?: number | string;
  index?: number;
  class?: string;
}

const { title, slug, year, index, class: className = '' } = Astro.props;

const variant = hashString(slug) % 4;
const monogram = initialsOf(title);
---

<div
  class:list={[
    'relative isolate overflow-hidden rounded-[18px] border border-line bg-surface',
    className,
  ]}
>
  <div
    aria-hidden="true"
    class:list={[
      'absolute inset-0 motion-safe:transition-transform motion-safe:duration-[900ms] motion-safe:ease-out motion-safe:group-hover:scale-[1.04]',
      `cover-art-${variant}`,
    ]}
  >
  </div>

  <span
    aria-hidden="true"
    class="absolute inset-0 grid place-items-center font-serif text-[3.25rem] font-[550] leading-none tracking-[-0.04em] text-ink-strong/10 select-none"
  >
    {monogram}
  </span>

  {year && (
    <span
      class="absolute left-3 top-2.5 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-subtle/90"
    >{year}</span>
  )}
  {typeof index === 'number' && (
    <span class="absolute bottom-2.5 left-3 font-mono text-[0.625rem] text-faint/90">
      {String(index).padStart(2, '0')}
    </span>
  )}
</div>

<style>
  .cover-art-0 {
    background-image:
      radial-gradient(120% 110% at 10% 0%, var(--accent-soft) 0%, transparent 58%),
      radial-gradient(90% 90% at 98% 100%, var(--hover-strong) 0%, transparent 62%);
  }

  .cover-art-1 {
    background-image:
      radial-gradient(120% 120% at 92% 0%, var(--accent-soft) 0%, transparent 55%),
      radial-gradient(80% 100% at 0% 100%, var(--hover-strong) 0%, transparent 62%);
  }

  .cover-art-2 {
    background-image:
      linear-gradient(133deg, var(--accent-soft) 0%, transparent 46%),
      radial-gradient(110% 100% at 50% 124%, var(--hover-strong) 0%, transparent 66%);
  }

  .cover-art-3 {
    background-image:
      radial-gradient(72% 72% at 50% 44%, var(--accent-soft) 0%, transparent 72%),
      linear-gradient(180deg, transparent 52%, var(--hover-strong) 100%);
  }
</style>
