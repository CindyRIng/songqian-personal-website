---
/**
 * ReadingStrip — three books from the desk (`currentlyReading`), shown as
 * plain reading-record rows: title — author, a small progress/hours note,
 * then one honest sentence. No covers, no cards.
 */
import SectionHead from '../ui/SectionHead.astro';
import { copy, c } from '../../data/copy';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

export interface BookItem {
  title: string;
  author: string;
  status?: string;
  year?: string;
  hours?: string;
  progress?: string;
  note: string;
}

interface Props {
  lang: Locale;
  books: BookItem[];
  class?: string;
}

const { lang, books, class: className = '' } = Astro.props;
const t = useTranslations(lang);

const metaLine = (book: BookItem) =>
  [book.author, book.progress ?? book.hours].filter(Boolean).join(' · ');
---

{
  books.length > 0 && (
    <section class:list={['desk', className]} aria-labelledby="desk-title">
      <div class="wrap">
        <SectionHead
          title={c(copy.home.readingTitle, lang)}
          lede={c(copy.home.readingLede, lang)}
          href="/reading"
          actionLabel={t('common.more')}
          id="desk-title"
        />

        <ul class="desk-list">
          {books.map((book) => (
            <li class="desk-row">
              <div class="desk-line">
                <span class="desk-title">{book.title}</span>
                <span class="desk-meta mono">{metaLine(book)}</span>
              </div>
              <p class="desk-note">{book.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .desk {
    margin-top: clamp(3.5rem, 6vw, 5.5rem);
  }

  .desk-list {
    margin-top: 1.125rem;
  }

  .desk-row {
    padding-block: 1.0625rem 1.1875rem;
    border-top: 1px solid var(--line);
  }

  .desk-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 1rem;
  }

  .desk-title {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.45;
    color: var(--ink-strong);
    text-wrap: balance;
  }

  .desk-meta {
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--subtle);
  }

  .desk-note {
    margin-top: 0.4375rem;
    max-width: 44rem;
    font-family: var(--font-serif);
    font-size: 0.9688rem;
    line-height: 1.8;
    color: var(--muted);
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .desk-title {
      font-size: 1.125rem;
    }

    .desk-note {
      font-size: 0.9375rem;
    }
  }
</style>
