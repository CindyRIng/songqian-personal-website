---
/**
 * SubscribeBand — a rounded, input-like row that opens a pre-filled email to
 * the owner, with a quiet RSS pill on the right. Static site: no form backend.
 */
import Icon from '../ui/Icon.astro';
import { useTranslations, localizePath } from '../../i18n/utils';
import { profile } from '../../data/profile';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);

const rssHref = localizePath('/rss.xml', lang);
const subscribeHref = `mailto:${profile.email}?subject=${encodeURIComponent(t('home.subscribe'))}`;
---

<div class:list={['flex flex-col gap-2.5', className]}>
  <div
    class="flex items-center gap-2 rounded-full border border-line bg-surface/60 p-1 pl-4 transition-colors duration-300 hover:border-line-strong hover:bg-surface"
  >
    <a
      href={subscribeHref}
      class="group/sub flex min-w-0 flex-1 items-center gap-2 py-1.5 font-sans text-[0.8125rem] leading-none text-subtle transition-colors duration-200 hover:text-ink"
    >
      <Icon
        name="mail"
        size={15}
        class="text-faint transition-colors duration-200 group-hover/sub:text-accent"
      />
      <span class="truncate">{t('home.subscribe')}</span>
    </a>

    <a
      href={rssHref}
      class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-line bg-elevated px-3 py-1.5 font-sans text-[0.6875rem] font-medium leading-none tracking-[0.02em] text-muted shadow-sm transition-colors duration-200 hover:border-line-strong hover:text-ink"
    >
      <Icon name="rss" size={13} class="text-faint" />
      <span>{t('home.rss')}</span>
    </a>
  </div>

  <p class="px-4 font-sans text-[0.6875rem] leading-relaxed text-faint">
    {t('home.subscribeNote')}
  </p>
</div>
