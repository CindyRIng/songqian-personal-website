---
/**
 * TimelineStrip — the five home-page milestones on one horizontal rail.
 * Nodes come from src/data/timeline.ts (homeMilestones); year is displayed
 * large, month as a mono sup, then role → org → a short note.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import { copy, c, pair } from '../../data/copy';
import type { ResolvedTimelineEntry } from '../../data/timeline';
import { localizePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
  entries: ResolvedTimelineEntry[];
}

const { lang, entries } = Astro.props;

const section = copy.sections.timeline;
const sectionTitle = pair(section.title, lang);
const timelineHref = localizePath('/timeline', lang);

const monthAbbr = (start: string) => {
  const [, month] = start.split('-');
  const date = new Date(Date.UTC(2000, Number(month ?? 1) - 1, 1));
  return new Intl.DateTimeFormat('en', { month: 'short', timeZone: 'UTC' })
    .format(date)
    .toUpperCase();
};
---

<section class="timeline section" aria-labelledby="timeline-title">
  <div class="wrap">
    <SectionHeading
      number={section.number}
      title={sectionTitle.title}
      en={sectionTitle.secondary}
      lede={c(section.lede, lang)}
      href={timelineHref}
      actionLabel={c(section.action, lang)}
      id="timeline-title"
    />

    <ol class="timeline-track" data-reveal>
      {
        entries.map((entry) => {
          const note = entry.summary;
          return (
            <li class:list={['timeline-node', entry.current && 'is-current']}>
              <span class="timeline-dot" aria-hidden="true" />
              <p class="timeline-year">
                {entry.start.slice(0, 4)}
                <sup class="mono">{monthAbbr(entry.start)}</sup>
              </p>
              <p class="timeline-role">{entry.role}</p>
              <p class="timeline-org">{entry.org}</p>
              <p class="timeline-note">{note}</p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .timeline-track {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 2.25rem;
    border-top: 1px solid var(--line-strong);
  }

  .timeline-node {
    position: relative;
    padding: 1.5rem 1.5rem 0 0;
    min-width: 0;
  }

  .timeline-node + .timeline-node {
    border-inline-start: 1px solid var(--line);
    padding-inline-start: 1.5rem;
  }

  .timeline-dot {
    position: absolute;
    top: -3.5px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .timeline-node + .timeline-node .timeline-dot {
    left: 1.5rem;
  }

  .timeline-node.is-current .timeline-dot {
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .timeline-node.is-current .timeline-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: node-breathe 3s var(--ease-out, ease-out) infinite;
  }

  @keyframes node-breathe {
    0% {
      opacity: 0.45;
      transform: scale(0.9);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  .timeline-year {
    font-family: var(--font-serif);
    font-size: clamp(1.625rem, 2.2vw, 2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--ink-strong);
    font-variant-numeric: tabular-nums;
  }

  .timeline-year sup {
    margin-inline-start: 0.3125rem;
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    vertical-align: super;
    line-height: 0;
  }

  .timeline-role {
    margin-top: 0.9375rem;
    font-family: var(--font-sans);
    font-size: 0.8438rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.55;
    color: var(--ink);
  }

  .timeline-org {
    margin-top: 0.375rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--subtle);
  }

  .timeline-note {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: var(--accent-strong);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1023px) {
    .timeline-track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-top: 0;
      gap: 0;
    }

    .timeline-node {
      border-top: 1px solid var(--line);
      padding: 1.25rem 1.25rem 1.25rem 0;
    }

    .timeline-node + .timeline-node {
      border-inline-start: 0;
    }

    .timeline-node:nth-child(2n) {
      border-inline-start: 1px solid var(--line);
      padding-inline-start: 1.25rem;
    }

    .timeline-node:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .timeline-node + .timeline-node .timeline-dot {
      left: 0;
    }

    .timeline-node:nth-child(2n) .timeline-dot {
      left: 1.25rem;
    }

    .timeline-node:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .timeline-track {
      grid-template-columns: minmax(0, 1fr);
    }

    .timeline-node,
    .timeline-node:nth-child(2n) {
      border-inline-start: 0;
      padding: 1.125rem 0 1.125rem 0;
    }

    .timeline-node .timeline-dot,
    .timeline-node + .timeline-node .timeline-dot,
    .timeline-node:nth-child(2n) .timeline-dot {
      left: 0;
      top: 1.5rem;
    }

    .timeline-node {
      padding-left: 1.25rem;
      border-top: 0;
      border-bottom: 1px solid var(--line);
    }

    .timeline-node.is-current {
      border-bottom-color: var(--accent-line);
    }

    .timeline-note {
      -webkit-line-clamp: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-node.is-current .timeline-dot::after {
      animation: none;
    }
  }
</style>
