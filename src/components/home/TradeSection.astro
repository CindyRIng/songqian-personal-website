---
/**
 * TradeSection — the compact "外贸" entry point on the home page.
 *
 * A hanging 外贸 label + one plain line, then two or three guide rows from the
 * `guides` content collection (ordered by `order`, empty-safe). Dense rules,
 * no cards, single language. Secondary links: 全部 → /foreign-trade/,
 * 咨询 → /consulting/. Both are Chinese-only pages.
 */
import { copy, c } from '../../data/copy';
import type { Locale } from '../../i18n/config';

export interface TradeGuide {
  title: string;
  description: string;
  keyword: string;
  href: string;
}

interface Props {
  lang: Locale;
  guides: TradeGuide[];
  class?: string;
}

const { lang, guides, class: className = '' } = Astro.props;

const label = c(copy.home.tradeTitle, lang);
const lede = c(copy.home.tradeLede, lang);
---

<section class:list={['trade', className]} aria-labelledby="trade-title">
  <div class="wrap">
    <div class="trade-head" data-reveal>
      <h2 class="trade-label mono" id="trade-title">{label}</h2>
      <p class="trade-lede">{lede}</p>
      <p class="trade-actions">
        <a class="trade-action focus-ring" href="/foreign-trade/">
          全部 <span class="trade-arrow" aria-hidden="true">→</span>
        </a>
        <a class="trade-action focus-ring" href="/consulting/">
          咨询 <span class="trade-arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    {
      guides.length > 0 && (
        <ul class="trade-list">
          {guides.map((guide) => (
            <li>
              <a class="trade-row focus-ring" href={guide.href}>
                <span class="trade-row-head">
                  <span class="trade-title">{guide.title}</span>
                  {guide.keyword && <span class="trade-key mono">{guide.keyword}</span>}
                  <span class="trade-row-arrow" aria-hidden="true">
                    →
                  </span>
                </span>
                <span class="trade-desc">{guide.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .trade {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .trade-head {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    padding-top: 0.9375rem;
    border-top: 1px solid var(--line-strong);
  }

  .trade-label {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--subtle);
    font-weight: 400;
  }

  .trade-lede {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 38rem;
    text-wrap: pretty;
  }

  .trade-actions {
    display: inline-flex;
    align-items: baseline;
    gap: 1.125rem;
    justify-self: end;
  }

  .trade-action {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    min-height: 2.75rem;
    margin-block: -0.8125rem;
    padding-block: 0.8125rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    touch-action: manipulation;
    transition:
      color var(--dur-1, 120ms) ease-out,
      border-color var(--dur-1, 120ms) ease-out;
  }

  .trade-arrow {
    color: var(--accent);
    display: inline-block;
    transition: transform var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  .trade-action:active {
    transform: translateY(1px);
  }

  .trade-action:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: var(--ring-offset, 3px);
    border-radius: 4px;
  }

  .trade-list {
    margin-top: 0.875rem;
  }

  .trade-row {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
    padding-block: 0.9375rem 1.0625rem;
    border-top: 1px solid var(--line);
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
    transition: background-color var(--dur-1, 120ms) ease-out;
  }

  .trade-row:active {
    background: color-mix(in oklab, var(--accent) 6%, transparent);
  }

  .trade-row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.875rem;
    min-width: 0;
  }

  .trade-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0.01em;
    color: var(--ink-strong);
    text-wrap: balance;
    transition: color var(--dur-1, 120ms) ease-out;
  }

  .trade-key {
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--accent-strong);
    white-space: nowrap;
  }

  .trade-row-arrow {
    margin-inline-start: auto;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--subtle);
    transition:
      transform var(--dur-2, 200ms) var(--ease-out, ease-out),
      color var(--dur-1, 120ms) ease-out;
  }

  .trade-desc {
    max-width: 46rem;
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.72;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-wrap: pretty;
  }

  @media (hover: hover) and (pointer: fine) {
    .trade-action:hover {
      color: var(--accent-strong);
      border-bottom-color: var(--accent);
    }

    .trade-action:hover .trade-arrow {
      transform: translateX(3px);
    }

    .trade-row:hover {
      background: color-mix(in oklab, var(--accent) 4%, transparent);
    }

    .trade-row:hover .trade-title {
      color: var(--accent-strong);
    }

    .trade-row:hover .trade-row-arrow {
      color: var(--accent-strong);
      transform: translateX(3px);
    }
  }

  @media (max-width: 767px) {
    .trade-head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.375rem 1rem;
    }

    .trade-label {
      order: 0;
    }

    .trade-actions {
      order: 1;
      justify-self: end;
    }

    .trade-lede {
      order: 2;
      grid-column: 1 / -1;
    }

    .trade-action {
      margin-block: 0;
    }

    .trade-title {
      flex: 1 0 100%;
      font-size: 1.0625rem;
    }

    .trade-key {
      order: 2;
    }

    .trade-row-arrow {
      order: 3;
    }

    .trade-desc {
      font-size: 0.9063rem;
      -webkit-line-clamp: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trade-action,
    .trade-arrow,
    .trade-row,
    .trade-title,
    .trade-row-arrow {
      transition: none;
    }

    .trade-action:active,
    .trade-action:hover .trade-arrow,
    .trade-row:hover .trade-row-arrow {
      transform: none;
    }
  }
</style>
