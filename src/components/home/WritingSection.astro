---
/**
 * WritingSection — the four newest essays, plain list.
 *
 * Date, title, one-line summary, whole row is the link. No numbering,
 * no featured slot, no English secondary titles.
 */
import SectionHead from '../ui/SectionHead.astro';
import { copy, c } from '../../data/copy';
import { localizePath, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

export interface WritingItem {
  title: string;
  description: string;
  category: string;
  dateLabel: string;
  readingTime: number;
  href: string;
}

interface Props {
  lang: Locale;
  posts: WritingItem[];
  class?: string;
}

const { lang, posts, class: className = '' } = Astro.props;
const t = useTranslations(lang);
const section = copy.sections.writing;
---

{
  posts.length > 0 && (
    <section class:list={['writing section', className]} aria-labelledby="writing-title">
      <div class="wrap">
        <SectionHead
          title={c(section.title, lang)}
          lede={c(section.lede, lang)}
          href={localizePath('/writing', lang)}
          actionLabel={c(section.action, lang)}
          id="writing-title"
        />

        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a class="post-row focus-ring" href={post.href}>
                <span class="post-date mono">{post.dateLabel}</span>
                <span class="post-main">
                  <span class="post-title">{post.title}</span>
                  <span class="post-desc">{post.description}</span>
                </span>
                <span class="post-meta mono">
                  <span>{t('common.minRead', { n: post.readingTime })}</span>
                  <span class="post-arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .post-list {
    margin-top: 1.125rem;
  }

  .post-row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: baseline;
    padding-block: 1.0625rem 1.125rem;
    border-top: 1px solid var(--line);
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
    transition: background-color var(--dur-1, 120ms) ease-out;
  }

  .post-row:active {
    background: color-mix(in oklab, var(--accent) 6%, transparent);
  }

  .post-date {
    font-size: 0.6563rem;
    letter-spacing: 0.06em;
    color: var(--subtle);
    font-variant-numeric: tabular-nums;
  }

  .post-main {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
    min-width: 0;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--ink-strong);
    text-wrap: balance;
    transition: color var(--dur-1, 120ms) ease-out;
  }

  .post-desc {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 42rem;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--subtle);
    white-space: nowrap;
  }

  .post-arrow {
    color: var(--accent);
    display: inline-block;
    transition: transform var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .post-row:hover {
      background: color-mix(in oklab, var(--accent) 4%, transparent);
    }

    .post-row:hover .post-title {
      color: var(--accent-strong);
    }

    .post-row:hover .post-arrow {
      transform: translateX(3px);
    }
  }

  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.375rem;
      padding-block: 1rem 1.0625rem;
    }

    .post-date {
      order: -1;
    }

    .post-meta {
      margin-top: 0.25rem;
    }

    .post-title {
      font-size: 1.1563rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-row,
    .post-title,
    .post-arrow {
      transition: none;
    }

    .post-row:hover .post-arrow {
      transform: none;
    }
  }
</style>
