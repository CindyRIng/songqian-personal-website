---
/**
 * WritingSection — "写作 Writing": a numbered index.
 *   01  featured essay, larger, with the English title as an italic secondary
 *   02–05 rows: title + secondary title + one-line summary + category/date
 */
import SectionHeading from '../ui/SectionHeading.astro';
import { copy, c, pair } from '../../data/copy';
import { localizePath, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { chromeLabel } from './labels';

export interface WritingItem {
  title: string;
  secondaryTitle: string;
  description: string;
  category: string;
  tag: string;
  dateLabel: string;
  readingTime: number;
  href: string;
  number: string;
}

interface Props {
  lang: Locale;
  featured: WritingItem;
  rows: WritingItem[];
  total: number;
  yearRange: string;
}

const { lang, featured, rows, total, yearRange } = Astro.props;
const t = useTranslations(lang);

const section = copy.sections.writing;
const sectionTitle = pair(section.title, lang);
const writingHref = localizePath('/writing', lang);
const rssHref = localizePath('/rss.xml', lang);
---

<section class="writing section" aria-labelledby="writing-title" data-reveal>
  <div class="wrap">
    <SectionHeading
      number={section.number}
      title={sectionTitle.title}
      en={sectionTitle.secondary}
      lede={c(section.lede, lang)}
      href={writingHref}
      actionLabel={c(section.action, lang)}
      id="writing-title"
    />

    <article class="post-featured">
      <p class="post-num mono">{featured.number}</p>
      <div class="post-main">
        <p class="post-category mono">
          {featured.category}
          {featured.tag && <span> · {featured.tag}</span>}
        </p>
        <h3 class="post-title">
          <a href={featured.href}>{featured.title}</a>
        </h3>
        <p class="post-secondary">{featured.secondaryTitle}</p>
        <p class="post-desc">{featured.description}</p>
      </div>
      <div class="post-side">
        <p class="post-date mono">
          {featured.dateLabel}<br />
          {t('common.minRead', { n: featured.readingTime })}
        </p>
        <a class="post-read" href={featured.href}>
          {chromeLabel('readEssay', lang)} <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>

    <div class="post-rows">
      {
        rows.map((post) => (
          <article class="post-row">
            <p class="post-num mono">{post.number}</p>
            <div class="post-main">
              <h4 class="post-row-title">
                <a href={post.href}>{post.title}</a>
              </h4>
              <p class="post-secondary post-secondary--small">{post.secondaryTitle}</p>
              <p class="post-row-desc">{post.description}</p>
            </div>
            <p class="post-meta mono">
              <span class="post-meta-cat">{post.category}</span>
              <span class="post-meta-date">{post.dateLabel}</span>
              <a class="post-meta-read" href={post.href}>
                {chromeLabel('read', lang)} <span aria-hidden="true">→</span>
              </a>
            </p>
          </article>
        ))
      }
    </div>

    <div class="writing-foot">
      <span>{yearRange} · {chromeLabel('writingFoot', lang)}</span>
      <a href={rssHref}>{t('footer.rss')} →</a>
    </div>
  </div>
</section>

<style>
  .post-featured {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 10.5rem;
    gap: 1.875rem;
    margin-top: 2.125rem;
    padding-bottom: 2.125rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .post-num {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    padding-top: 0.5625rem;
  }

  .post-category {
    font-size: 0.5938rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--subtle);
  }

  .post-title {
    margin-top: 0.625rem;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 2.6vw, 2.125rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.012em;
    color: var(--ink-strong);
    text-wrap: balance;
  }

  .post-title a {
    text-decoration: none;
    transition: color var(--dur-1, 120ms) ease-out;
  }

  .post-title a:hover {
    color: var(--accent-strong);
  }

  .post-secondary {
    margin-top: 0.375rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9063rem;
    letter-spacing: 0.01em;
    color: var(--subtle);
  }

  .post-secondary--small {
    font-size: 0.7813rem;
    margin-top: 0.1875rem;
  }

  .post-desc {
    margin-top: 0.9375rem;
    max-width: 38.5rem;
    font-family: var(--font-serif);
    font-size: 1.0313rem;
    line-height: 1.78;
    color: var(--muted);
  }

  .post-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 0.5rem;
    text-align: right;
  }

  .post-date {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--subtle);
    line-height: 1.8;
  }

  .post-read {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.7188rem;
    letter-spacing: 0.05em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 3px;
    margin-top: 1.375rem;
    transition:
      color var(--dur-1, 120ms) ease-out,
      border-color var(--dur-1, 120ms) ease-out;
  }

  .post-read span {
    color: var(--accent);
  }

  .post-featured:hover .post-read {
    color: var(--accent-strong);
    border-color: var(--accent);
  }

  /* --- rows -------------------------------------------------------------- */
  .post-rows {
    margin-top: 0;
  }

  .post-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 10.5rem;
    gap: 1.875rem;
    align-items: baseline;
    padding-block: 1.1875rem;
    border-bottom: 1px solid var(--line);
  }

  .post-row-title {
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.015em;
    color: var(--ink);
    text-wrap: balance;
  }

  .post-row-title a {
    text-decoration: none;
    transition: color var(--dur-1, 120ms) ease-out;
  }

  .post-row:hover .post-row-title a {
    color: var(--accent-strong);
  }

  .post-row-desc {
    margin-top: 0.4375rem;
    max-width: 37.5rem;
    font-family: var(--font-serif);
    font-size: 0.9063rem;
    line-height: 1.68;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1875rem;
    font-size: 0.6563rem;
    letter-spacing: 0.06em;
    color: var(--subtle);
    text-align: right;
    line-height: 1.8;
  }

  .post-meta-cat {
    color: var(--subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.5938rem;
  }

  .post-meta-read {
    color: var(--ink);
    text-decoration: none;
    margin-top: 0.125rem;
  }

  .post-meta-read span {
    color: var(--accent);
    display: inline-block;
    transition: transform var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  .post-row:hover .post-meta-read span {
    transform: translateX(3px);
  }

  /* --- foot -------------------------------------------------------------- */
  .writing-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.375rem;
    font-family: var(--font-sans);
    font-size: 0.6563rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--subtle);
  }

  .writing-foot a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition:
      color var(--dur-1, 120ms) ease-out,
      border-color var(--dur-1, 120ms) ease-out;
  }

  .writing-foot a:hover {
    color: var(--accent-strong);
    border-color: var(--accent);
  }

  @media (max-width: 1023px) {
    .post-featured,
    .post-row {
      grid-template-columns: 3rem minmax(0, 1fr) 9rem;
      gap: 1.25rem;
    }
  }

  @media (max-width: 767px) {
    .post-featured {
      grid-template-columns: minmax(0, 1fr);
      position: relative;
      padding-left: 2.75rem;
    }

    .post-featured .post-num {
      position: absolute;
      left: 0;
      top: 0.5625rem;
    }

    .post-side {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      text-align: left;
      padding-top: 0;
      margin-top: 1rem;
    }

    .post-row {
      grid-template-columns: minmax(0, 1fr);
      position: relative;
      padding-left: 2.75rem;
    }

    .post-row .post-num {
      position: absolute;
      left: 0;
      top: 1.3125rem;
      padding-top: 0;
    }

    .post-meta {
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      gap: 0.75rem;
      margin-top: 0.5rem;
      text-align: left;
    }

    .post-title {
      font-size: 1.625rem;
    }

    .post-row-title {
      font-size: 1.1875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-title a,
    .post-read,
    .post-row-title a,
    .post-meta-read span,
    .writing-foot a {
      transition: none;
    }

    .post-row:hover .post-meta-read span {
      transform: none;
    }
  }
</style>
