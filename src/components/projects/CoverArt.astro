---
/**
 * CoverArt — deterministic, generated cover artwork. No stock photos anywhere.
 *
 * Every project (and the About portrait) gets an abstract "art plate" composed
 * from layered CSS gradients, a hairline grid, thin SVG rings and an oversized
 * serif monogram. The palette is derived only from design tokens, so it adapts
 * to light/dark automatically; the *composition* is deterministic from the seed
 * string (the project slug), so a given project always looks the same.
 *
 * Variants
 *   cover    — project card / detail plate: index, category, monogram, wordmark
 *   panel    — gallery plate: centred outlined letter, rings, small label
 *   portrait — About hero: large centred monogram with caption
 *
 * Usage:
 *   <CoverArt slug={project.slug} title={project.title} index={i + 1} class="aspect-[16/10]" />
 *
 * To use a real photograph later: add an `image` prop and swap the `.art-*`
 * layers for an <Image> — the surrounding card/detail layout stays identical.
 * (See src/content.config.ts → cover/gallery fields.)
 */
interface Props {
  /** Deterministic seed — usually the project slug. */
  slug: string;
  /** Used for the wordmark and the monogram initial. */
  title: string;
  year?: number | string;
  /** 1-based index shown as a mono counter, e.g. 01. */
  index?: number | string;
  /** Small uppercase label in the top-right corner, e.g. "Product". */
  eyebrow?: string;
  /** Small label in the bottom corner (gallery panels). */
  label?: string;
  /** `cover` = project plate, `panel` = gallery plate, `portrait` = About hero. */
  variant?: 'cover' | 'panel' | 'portrait';
  /** Override the monogram, e.g. the initials "SQ" for the portrait. */
  mono?: string;
  /** Small caption under the portrait monogram (localized by the caller). */
  caption?: string;
  /** Extra classes on the root — aspect ratio, hover zoom, radius, etc. */
  class?: string;
}

const {
  slug,
  title,
  year,
  index,
  eyebrow,
  label,
  variant = 'cover',
  mono,
  caption,
  class: className = '',
} = Astro.props;

/** FNV-1a — tiny, stable, dependency-free hash. */
function hash(value: string): number {
  let h = 2166136261;
  for (let i = 0; i < value.length; i += 1) {
    h ^= value.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const h = hash(slug);
const accentAmount = 22 + (h % 20); // 22–41% accent in the main glow
const inkAmount = 6 + ((h >> 4) % 10); // 6–15% ink depth
const mutedAmount = 24 + ((h >> 8) % 22); // 24–45% muted counter-glow
const angle = 96 + ((h >> 12) % 88); // 96–183deg sweep
const gx1 = 6 + ((h >> 3) % 38); // glow positions (%)
const gy1 = 2 + ((h >> 6) % 30);
const gx2 = 56 + ((h >> 10) % 38);
const gy2 = 48 + ((h >> 14) % 42);
const ringOffset = 8 + ((h >> 17) % 24); // px bleed of the ring cluster
const ghostX = 8 + ((h >> 19) % 12); // px offset of the outlined echo
const ghostRise = 6 + ((h >> 21) % 8); // px the echo rises above the monogram

/**
 * Monogram: supplied `mono` wins; otherwise use the initials of up to two
 * Latin words (Fuma Platform → FP) so sibling projects never share a mark,
 * and fall back to the first character for CJK titles.
 */
function monogramOf(value: string): string {
  const words = value.trim().split(/[\s\-–—/]+/).filter(Boolean);
  if (words.length >= 2) {
    const letters = words.slice(0, 2).map((word) => word[0]);
    if (letters.every((letter) => /[A-Za-z]/.test(letter))) {
      return letters.join('').toUpperCase();
    }
  }
  return value.trim().charAt(0).toUpperCase();
}

const initial = (mono ?? monogramOf(title) ?? 'S').slice(0, 2).toUpperCase();
/** The outlined echo reads as a designed offset for Latin letters; on dense
 *  CJK glyphs it reads as a misprint, so it is only rendered for Latin marks. */
const latinMonogram = /^[A-Z]{1,2}$/.test(initial);
const wordmark = title.toUpperCase();
const paddedIndex = typeof index === 'number' ? String(index).padStart(2, '0') : index;

const style = [
  `--art-angle:${angle}deg`,
  `--art-accent:${accentAmount}%`,
  `--art-ink:${inkAmount}%`,
  `--art-muted:${mutedAmount}%`,
  `--art-x1:${gx1}%`,
  `--art-y1:${gy1}%`,
  `--art-x2:${gx2}%`,
  `--art-y2:${gy2}%`,
  `--art-ring:${ringOffset}px`,
  `--art-ghost-x:${ghostX}px`,
  `--art-ghost-rise:${ghostRise}px`,
].join(';');
---

<div
  class:list={['cover-art', `cover-art--${variant}`, className]}
  style={style}
  data-cover-seed={slug}
  data-latin-monogram={latinMonogram ? 'true' : 'false'}
  aria-hidden="true"
>
  <div class="art-base"></div>
  <div class="art-grid"></div>

  <svg class="art-rings" viewBox="0 0 320 320" fill="none" aria-hidden="true">
    <circle cx="232" cy="88" r="140" stroke="currentColor" stroke-width="1" opacity="0.24"></circle>
    <circle cx="232" cy="88" r="94" stroke="currentColor" stroke-width="1" opacity="0.2"></circle>
    <circle cx="232" cy="88" r="48" stroke="currentColor" stroke-width="1" opacity="0.15"></circle>
    <circle cx="232" cy="88" r="2.5" fill="currentColor" opacity="0.5"></circle>
    <path d="M232 88 320 34" stroke="currentColor" stroke-width="1" opacity="0.16"></path>
  </svg>

  {
    variant === 'portrait' ? (
      <div class="art-portrait">
        <span class="art-ghost art-initial is-portrait" aria-hidden="true">{initial}</span>
        <span class="art-initial is-portrait">{initial}</span>
        {caption && <span class="art-portrait-caption">{caption}</span>}
      </div>
    ) : variant === 'panel' ? (
      <div class="art-panel">
        {paddedIndex && <span class="art-counter art-panel-index">{paddedIndex}</span>}
        <span class="art-panel-echo" aria-hidden="true">{initial}</span>
        {label ? <span class="art-panel-word">{label}</span> : <span class="art-panel-letter">{initial}</span>}
      </div>
    ) : (
      <>
        <div class="art-top">
          <span class="art-counter">{paddedIndex ?? '—'}</span>
          {eyebrow && <span class="art-eyebrow">{eyebrow}</span>}
        </div>

        <div class="art-bottom">
          <div class="art-mono">
            <span class="art-ghost art-initial" aria-hidden="true">{initial}</span>
            <span class="art-initial">{initial}</span>
          </div>
          <div class="art-meta">
            <span class="art-wordmark">{wordmark}</span>
            {year && <span class="art-year tabular">{year}</span>}
          </div>
        </div>
      </>
    )
  }
</div>

<style>
  .cover-art {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    background: var(--surface);
    container-type: inline-size;
    color: var(--ink);
  }

  /* Layered gradient field ------------------------------------------------- */
  .art-base {
    position: absolute;
    inset: -12%;
    background:
      radial-gradient(
        115% 92% at var(--art-x1) var(--art-y1),
        color-mix(in oklab, var(--accent) var(--art-accent), transparent) 0%,
        transparent 64%
      ),
      radial-gradient(
        82% 76% at var(--art-x2) var(--art-y2),
        color-mix(in oklab, var(--ink) var(--art-ink), transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        95% 85% at 82% 104%,
        color-mix(in oklab, var(--muted) var(--art-muted), transparent) 0%,
        transparent 68%
      ),
      linear-gradient(
        var(--art-angle),
        color-mix(in oklab, var(--elevated) 82%, var(--canvas)) 0%,
        var(--surface) 52%,
        color-mix(in oklab, var(--canvas) 72%, var(--surface)) 100%
      );
  }

  /* Hairline grid fading away from the top --------------------------------- */
  .art-grid {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        0deg,
        color-mix(in oklab, var(--ink) 7%, transparent) 0 1px,
        transparent 1px 30px
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in oklab, var(--ink) 7%, transparent) 0 1px,
        transparent 1px 30px
      );
    -webkit-mask-image: linear-gradient(180deg, black 0%, transparent 74%);
    mask-image: linear-gradient(180deg, black 0%, transparent 74%);
  }

  .art-rings {
    position: absolute;
    top: calc(-1 * var(--art-ring));
    right: calc(-1 * var(--art-ring));
    width: min(78%, 420px);
    height: auto;
    color: var(--muted);
  }

  /* Composition ------------------------------------------------------------ */
  .cover-art--cover {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .art-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: clamp(0.95rem, 4.5cqw, 1.5rem) clamp(1rem, 5cqw, 1.6rem) 0;
  }

  .art-bottom {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: clamp(4.25rem, 34cqw, 11rem);
    padding: 0 clamp(0.85rem, 4cqw, 1.4rem) clamp(0.9rem, 4.5cqw, 1.4rem);
  }

  .art-counter,
  .art-eyebrow {
    font-family: var(--font-sans);
    font-size: clamp(0.625rem, 2.1cqw, 0.6875rem);
    font-weight: 560;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .art-counter {
    font-family: var(--font-mono);
    font-weight: 450;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--subtle);
  }

  /* The oversized serif initial + its outlined echo ------------------------ */
  .art-mono {
    position: relative;
    z-index: 1;
    line-height: 0;
  }

  .art-initial {
    position: relative;
    z-index: 1;
    display: block;
    font-family: var(--font-serif);
    font-weight: 520;
    font-size: clamp(3.25rem, 36cqw, 11rem);
    line-height: 0.7;
    letter-spacing: -0.055em;
    margin-bottom: -0.085em;
    margin-left: -0.06em;
    color: color-mix(in oklab, var(--ink-strong) 84%, var(--accent));
    text-shadow: 0 1px 0 color-mix(in oklab, var(--canvas) 36%, transparent);
    user-select: none;
  }

  .cover-art[data-latin-monogram='false'] .art-ghost {
    display: none;
  }

  /* CJK glyphs fill the full em box: give them line-height and no crop. */
  .cover-art[data-latin-monogram='false'] .art-initial {
    line-height: 1;
    margin-bottom: 0;
    margin-left: -0.02em;
    letter-spacing: 0;
  }

  .art-ghost {
    position: absolute;
    z-index: 0;
    color: transparent;
    -webkit-text-stroke: 1.25px color-mix(in oklab, var(--ink) 26%, transparent);
    text-shadow: none;
  }

  .art-mono .art-ghost {
    left: var(--art-ghost-x);
    bottom: var(--art-ghost-rise);
  }

  /* Meta block, bottom-right */

  .art-meta {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    margin-inline-start: auto;
    padding-inline-start: 0.75rem;
    padding-bottom: 0.1rem;
    text-align: right;
  }

  .art-year {
    font-family: var(--font-mono);
    font-size: clamp(0.625rem, 2.1cqw, 0.6875rem);
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .art-wordmark {
    font-family: var(--font-sans);
    font-size: clamp(0.5625rem, 2.2cqw, 0.6875rem);
    font-weight: 560;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .art-label {
    font-family: var(--font-sans);
    font-size: clamp(0.5625rem, 2.2cqw, 0.6875rem);
    font-weight: 560;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    background: color-mix(in oklab, var(--canvas) 62%, transparent);
    border: 1px solid color-mix(in oklab, var(--ink) 10%, transparent);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    white-space: nowrap;
  }

  /* Panel variant: gallery plate with a centred outlined letter ------------- */
  .cover-art--panel .art-rings {
    top: 50%;
    right: 50%;
    width: min(118%, 560px);
    translate: 50% -50%;
    color: var(--ink);
    opacity: 0.6;
  }

  .art-panel {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: clamp(0.85rem, 4cqw, 1.25rem);
  }

  .art-panel-echo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(7rem, 62cqw, 20rem);
    line-height: 0.7;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--ink) 17%, transparent);
    user-select: none;
    pointer-events: none;
  }

  .art-panel-word {
    position: relative;
    z-index: 2;
    max-width: 88%;
    text-align: center;
    text-wrap: balance;
    font-family: var(--font-serif);
    font-weight: 520;
    font-size: clamp(1.5rem, 13.5cqw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: color-mix(in oklab, var(--ink-strong) 88%, var(--accent));
  }

  .art-panel-letter {
    position: relative;
    z-index: 2;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 20cqw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: color-mix(in oklab, var(--ink-strong) 80%, var(--accent));
  }

  .art-panel-index {
    position: absolute;
    top: clamp(0.85rem, 4cqw, 1.25rem);
    left: clamp(0.95rem, 4.5cqw, 1.4rem);
    z-index: 3;
  }

  /* Portrait variant: big centred monogram --------------------------------- */
  .cover-art--portrait {
    display: grid;
    place-items: center;
  }

  .cover-art--portrait .art-rings {
    top: 50%;
    right: 50%;
    width: min(128%, 720px);
    translate: 50% -50%;
    color: var(--muted);
    opacity: 1;
  }

  .cover-art--portrait .art-rings circle {
    stroke-width: 1.25;
  }

  .art-portrait {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: clamp(1.5rem, 8cqw, 3rem);
  }

  .art-initial.is-portrait {
    position: relative;
    z-index: 1;
    font-size: clamp(4rem, 30cqw, 11rem);
    line-height: 0.74;
    letter-spacing: -0.06em;
    margin: 0;
  }

  .art-portrait .art-ghost {
    left: 50%;
    bottom: auto;
    top: 50%;
    translate: calc(-50% + var(--art-ghost-x)) calc(-50% - var(--art-ghost-rise));
  }

  .art-portrait-caption {
    position: absolute;
    left: clamp(1rem, 4.5cqw, 1.6rem);
    bottom: clamp(0.9rem, 4.5cqw, 1.4rem);
    z-index: 3;
    font-family: var(--font-sans);
    font-size: clamp(0.5625rem, 2.1cqw, 0.6875rem);
    font-weight: 560;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-art {
      transition: none;
    }
  }
</style>
