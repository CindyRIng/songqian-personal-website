---
/**
 * LayerDiagram — a CSS/SVG architecture figure used on the work detail page
 * for projects that are better explained as a system than as a CLI window
 * (currently the tennis-ball robot's five-layer design).
 */
interface Layer {
  label: string;
  en?: string;
  note?: string;
}

interface Props {
  label: string;
  title: string;
  layers: Layer[];
  class?: string;
}

const { label, title, layers, class: className = '' } = Astro.props;
---

<figure class:list={['w-full rounded-[6px] border border-line bg-[var(--paper)] p-5 sm:p-6', className]}>
  <figcaption class="flex items-baseline justify-between gap-3 border-b border-line pb-3">
    <span class="label">{label}</span>
    <span class="mono text-[0.6875rem] text-subtle">{title}</span>
  </figcaption>

  <ol class="relative mt-4 flex flex-col">
    <span
      class="pointer-events-none absolute bottom-3 left-[0.4375rem] top-3 w-px bg-[var(--line-strong)]"
      aria-hidden="true"
    ></span>
    {
      layers.map((layer, index) => (
        <li class="relative grid grid-cols-[1.5rem_1fr] items-baseline gap-x-3 py-2.5">
          <span class="relative z-10 mt-[0.3rem] flex size-3.5 items-center justify-center rounded-full border border-line-strong bg-[var(--paper)]">
            <span class="size-1 rounded-full bg-accent"></span>
          </span>
          <span class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
            <span class="font-serif text-[1rem] font-[540] leading-snug tracking-[-0.01em] text-ink-strong">
              {layer.label}
            </span>
            <span class="mono text-[0.6875rem] uppercase tracking-[0.1em] text-subtle">
              L{index + 1} {layer.en ? `· ${layer.en}` : ''}
            </span>
          </span>
          {layer.note && (
            <span class="col-start-2 mt-0.5 text-pretty text-[0.8125rem] leading-[1.55] text-muted">{layer.note}</span>
          )}
        </li>
      ))
    }
  </ol>
</figure>
