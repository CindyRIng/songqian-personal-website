---
/**
 * ProjectCard — editorial, single-column project card used on /projects
 * (and any other list surface that needs the full card).
 *
 * The cover is generated (see CoverArt.astro); the card body carries the
 * quiet metadata that makes the list scannable: index, year, status, title,
 * tagline, role and stack.
 */
import CoverArt from './CoverArt.astro';
import Icon from '../ui/Icon.astro';
import { localizePath, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import {
  PROJECT_CATEGORY_LABELS,
  PROJECT_STATUS_KEYS,
  projectCategories,
  type ProjectEntry,
} from '../../lib/projects';

interface Props {
  lang: Locale;
  project: ProjectEntry;
  /** 1-based position in the list. */
  index: number;
  /** The first project is presented larger. */
  featured?: boolean;
  /** Stagger for the scroll-reveal entrance, in ms. */
  delay?: number;
}

const { lang, project, index, featured = false, delay = 0 } = Astro.props;

const t = useTranslations(lang);
const href = localizePath(`/projects/${project.slug}`, lang);
const categories = projectCategories(project).map((category) => PROJECT_CATEGORY_LABELS[category][lang]);
const statusLabel = t(PROJECT_STATUS_KEYS[project.status]);
const isCurrent = project.status === 'live' || project.status === 'in-progress';
const stack = project.stack.slice(0, 2);
const titleId = `project-${project.slug}-title`;
---

<article
  class="group relative"
  data-project-card
  data-tags={project.tags.join(' ')}
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  <a
    href={href}
    class="card block"
    aria-labelledby={titleId}
  >
    <div class="relative overflow-hidden rounded-t-lg">
      <CoverArt
        slug={project.coverSeed}
        title={project.title}
        index={index}
        eyebrow={categories[0]}
        class:list={[
          featured ? 'aspect-[4/3]' : 'aspect-[16/10]',
          'transition-transform duration-[900ms] ease-[var(--ease-out)] motion-safe:group-hover:scale-[1.035]',
        ]}
      />
      <span
        class="pointer-events-none absolute right-4 top-4 flex size-9 translate-y-1 items-center justify-center rounded-full border border-line bg-canvas/75 text-ink opacity-0 backdrop-blur-md transition duration-300 ease-[var(--ease-out)] group-hover:translate-y-0 group-hover:opacity-100"
        aria-hidden="true"
      >
        <Icon name="arrow-up-right" size={15} />
      </span>
    </div>

    <div class:list={['p-5 sm:p-6', featured && 'sm:p-7']}>
      <div class="flex items-center justify-between gap-4">
        <span
          class:list={[
            'inline-flex items-center gap-1.5 font-sans text-[0.6875rem] font-medium tracking-[0.01em]',
            isCurrent ? 'text-accent' : 'text-muted',
          ]}
        >
          <span
            class:list={['size-1.5 rounded-full', isCurrent ? 'bg-accent' : 'bg-subtle']}
          ></span>
          {statusLabel}
        </span>
        <span class="font-mono text-[0.6875rem] tabular text-muted">{project.year}</span>
      </div>

      <h3
        id={titleId}
        class:list={[
          'mt-3 text-balance font-serif font-[550] tracking-[-0.02em] text-ink-strong transition-colors duration-200 group-hover:text-ink-strong',
          featured ? 'text-[1.5rem] leading-[1.15] sm:text-[1.75rem]' : 'text-[1.25rem] leading-[1.2]',
        ]}
      >
        {project.title}
      </h3>

      <p class:list={['mt-2 text-pretty leading-relaxed text-muted', featured ? 'text-base' : 'text-[0.9375rem]']}>
        {project.tagline}
      </p>

      <div class="mt-5 flex items-end justify-between gap-4 border-t border-line pt-4">
        <div class="min-w-0">
          <p class="truncate font-sans text-[0.6875rem] font-medium text-subtle">{project.role}</p>
          {
            stack.length > 0 && (
              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {stack.map((item) => (
                  <span class="chip">{item}</span>
                ))}
              </div>
            )
          }
        </div>
        <span
          class="mb-0.5 flex size-7 shrink-0 items-center justify-center rounded-full text-subtle transition duration-300 ease-[var(--ease-out)] group-hover:bg-hover group-hover:text-ink"
          aria-hidden="true"
        >
          <Icon name="arrow-right" size={16} />
        </span>
      </div>
    </div>
  </a>
</article>
