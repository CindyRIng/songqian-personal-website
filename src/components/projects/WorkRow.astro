---
/**
 * WorkRow — the compact tool row used for the four non-featured projects on
 * the Works index (and as the "next project" row on a work detail page).
 *
 * Rule from the spec: mono metadata left, serif name in the middle, one-line
 * summary, type + status + arrow right.
 */
import Icon from '../ui/Icon.astro';
import { localizePath, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { PROJECT_CATEGORIES, PROJECT_STATUS_KEYS, type ProjectEntry } from '../../lib/projects';

interface Props {
  lang: Locale;
  project: ProjectEntry;
  /** Two-digit index shown at the start of the row, e.g. "03". */
  index: number;
  /** Optional extra classes (the "next project" footer uses no border). */
  class?: string;
}

const { lang, project, index, class: className = '' } = Astro.props;

const t = useTranslations(lang);
const href = localizePath(`/works/${project.slug}`, lang);
const statusLabel = t(PROJECT_STATUS_KEYS[project.status]);
const primaryCategory = PROJECT_CATEGORIES.find((category) => project.tags.includes(category));
const typeLabel = primaryCategory ? t(`filter.${primaryCategory}` as never) : t('filter.tool');
const paddedIndex = String(index).padStart(2, '0');
---

<a
  href={href}
  class:list={[
    'group flex flex-col gap-3 border-t border-line py-5 transition-colors duration-200 hover:bg-[var(--sage-tint)] md:grid md:grid-cols-[3rem_4.5rem_1fr_auto] md:items-baseline md:gap-5 md:px-3 md:-mx-3 md:rounded-[6px]',
    className,
  ]}
  data-work-item
  data-tags={project.tags.join(' ')}
>
  <span class="mono hidden text-[0.6875rem] text-subtle md:block">{paddedIndex}</span>

  <span class="mono text-[0.6875rem] text-subtle">{project.year}</span>

  <span class="flex min-w-0 flex-col gap-1">
    <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-serif text-[1.125rem] font-[540] leading-snug tracking-[-0.01em] text-ink-strong transition-colors duration-200 group-hover:text-accent-deep">
        {project.title}
      </span>
      <span class="mono text-[0.6875rem] text-subtle">{project.slug}</span>
    </span>
    <span class="max-w-[58ch] text-pretty text-[0.9375rem] leading-[1.55] text-muted md:hidden lg:block">
      {project.tagline}
    </span>
  </span>

  <span class="flex items-center gap-4 md:justify-end">
    <span class="label">{typeLabel}</span>
    <span class="mono text-[0.6875rem] uppercase tracking-[0.1em] text-subtle">{statusLabel}</span>
    <Icon
      name="arrow-right"
      size={16}
      class="text-subtle transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5 group-hover:text-accent"
    />
  </span>
</a>
