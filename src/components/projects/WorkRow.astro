---
/**
 * WorkRow — the compact tool row used for the four non-featured projects on
 * the Works index (and as the "next project" row on a work detail page).
 *
 * Rule from the spec: mono metadata left, serif name in the middle, one-line
 * summary, type + status + arrow right.
 *
 * Interaction polish: hover wash slides in behind the row (hover-capable
 * pointers only), title warms, arrow nudges; focus ring + press feedback;
 * reduced-motion safe.
 */
import Icon from '../ui/Icon.astro';
import { localizePath, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { PROJECT_CATEGORIES, PROJECT_STATUS_KEYS, type ProjectEntry } from '../../lib/projects';

interface Props {
  lang: Locale;
  project: ProjectEntry;
  /** Two-digit index shown at the start of the row, e.g. "03". */
  index: number;
  /** Optional extra classes (the "next project" footer uses no border). */
  class?: string;
}

const { lang, project, index, class: className = '' } = Astro.props;

const t = useTranslations(lang);
const href = localizePath(`/works/${project.slug}`, lang);
const statusLabel = t(PROJECT_STATUS_KEYS[project.status]);
const primaryCategory = PROJECT_CATEGORIES.find((category) => project.tags.includes(category));
const typeLabel = primaryCategory ? t(`filter.${primaryCategory}` as never) : t('filter.tool');
const paddedIndex = String(index).padStart(2, '0');
---

<a
  href={href}
  class:list={[
    'work-row group focus-ring press flex flex-col gap-3 border-t border-line py-5 md:grid md:grid-cols-[3rem_4.5rem_1fr_auto] md:items-baseline md:gap-5 md:px-3 md:-mx-3 md:rounded-[6px]',
    className,
  ]}
  data-work-item
  data-tags={project.tags.join(' ')}
>
  <span class="mono hidden text-[0.6875rem] text-subtle md:block">{paddedIndex}</span>

  <span class="mono text-[0.6875rem] text-subtle">{project.year}</span>

  <span class="flex min-w-0 flex-col gap-1">
    <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="row-title font-serif text-[1.125rem] font-[540] leading-snug tracking-[-0.01em] text-ink-strong">
        {project.title}
      </span>
      <span class="mono text-[0.6875rem] text-subtle">{project.slug}</span>
    </span>
    <span class="max-w-[58ch] text-pretty text-[0.9375rem] leading-[1.55] text-muted md:hidden lg:block">
      {project.tagline}
    </span>
  </span>

  <span class="flex items-center gap-4 md:justify-end">
    <span class="label">{typeLabel}</span>
    <span class="mono text-[0.6875rem] uppercase tracking-[0.1em] text-subtle">{statusLabel}</span>
    <span class="row-arrow inline-flex text-subtle">
      <Icon name="arrow-right" size={16} />
    </span>
  </span>
</a>

<style>
  .work-row {
    position: relative;
    isolation: isolate;
  }

  /* Wash slides in behind the row; content paints above it. */
  .work-row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 6px;
    background: var(--sage-tint);
    opacity: 0;
    transform: scaleY(0.96);
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .row-title {
    transition: color var(--dur-1) var(--ease-out);
  }

  .row-arrow {
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-row:hover::before {
      opacity: 1;
      transform: none;
    }

    .work-row:hover .row-title {
      color: var(--accent-strong);
    }

    .work-row:hover .row-arrow {
      transform: translateX(4px);
      color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-row::before,
    .row-title,
    .row-arrow {
      transition: none;
    }

    .work-row:hover::before {
      transform: none;
    }

    .work-row:hover .row-arrow {
      transform: none;
    }
  }
</style>
