---
/**
 * TimelineEntry — one stop on the Timeline rail.
 *
 * The vertical rail itself lives in TimelineView (a single hairline); this
 * component only owns its dot and content so the rail stays continuous across
 * year groups and survives client-side filtering.
 */
import Icon from '../ui/Icon.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { TIMELINE_TYPE_KEYS, type ResolvedTimelineEntry, type TimelineType } from '../../data/timeline';

interface Props {
  lang: Locale;
  entry: ResolvedTimelineEntry;
  /** Stagger for the scroll-reveal entrance, in ms. */
  delay?: number;
}

const { lang, entry, delay = 0 } = Astro.props;

const t = useTranslations(lang);
const typeLabel = t(TIMELINE_TYPE_KEYS[entry.type]);

const TYPE_ICONS: Record<TimelineType, 'layers' | 'book' | 'sparkle' | 'camera'> = {
  work: 'layers',
  education: 'book',
  milestone: 'sparkle',
  life: 'camera',
};
---

<article
  class="group relative pl-8"
  data-timeline-item
  data-type={entry.type}
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  <span
    class:list={['timeline-dot', entry.current && 'is-current']}
    data-current={entry.current ? '' : undefined}
    aria-hidden="true"
  ></span>

  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-serif text-[1.0625rem] font-[550] leading-snug tracking-[-0.01em] text-ink-strong">
      {entry.org}
    </h3>
    <span class="whitespace-nowrap font-sans text-[0.6875rem] tabular tracking-[0.02em] text-subtle">
      {entry.period}
    </span>
  </div>

  <p class="mt-0.5 text-[0.9375rem] leading-snug text-muted">{entry.role}</p>

  <p class="mt-2 text-pretty text-[0.9375rem] leading-[1.65] text-muted">{entry.summary}</p>

  {
    entry.highlights.length > 0 && (
      <ul class="mt-3 space-y-1.5 border-l border-line pl-3.5">
        {entry.highlights.map((highlight) => (
          <li class="text-[0.875rem] leading-[1.6] text-muted">{highlight}</li>
        ))}
      </ul>
    )
  }

  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    <span class="timeline-chip">
      <Icon name={TYPE_ICONS[entry.type]} size={11} />
      {typeLabel}
    </span>
    {
      entry.location && (
        <span class="timeline-chip">
          <Icon name="map-pin" size={11} />
          {entry.location}
        </span>
      )
    }
    {
      entry.tags.slice(0, 2).map((tag) => (
        <span class="timeline-chip timeline-chip--tag">{tag}</span>
      ))
    }
  </div>
</article>

<style>
  .timeline-dot {
    position: absolute;
    left: 0;
    top: 0.5rem;
    height: 9px;
    width: 9px;
    translate: -50% 0;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--canvas);
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  .timeline-dot.is-current {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .timeline-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: 999px;
    background: var(--hover);
    border: 1px solid transparent;
    padding: 0.1875rem 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--muted);
    white-space: nowrap;
  }

  .timeline-chip--tag {
    color: var(--subtle);
    background: transparent;
    border-color: var(--line);
  }

  @media (hover: hover) {
    .group:hover .timeline-dot:not(.is-current) {
      border-color: var(--accent);
      background: var(--accent-soft);
    }
  }
</style>
