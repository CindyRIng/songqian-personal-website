---
/**
 * TimelineEntry — one card on the right side of the v3 timeline.
 *
 * The left column of the page owns the large serif year; this component only
 * renders the entry card so the grid stays aligned across a year group.
 */
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { TIMELINE_TYPE_KEYS, type ResolvedTimelineEntry } from '../../data/timeline';

interface Props {
  lang: Locale;
  entry: ResolvedTimelineEntry;
  delay?: number;
}

const { lang, entry, delay = 0 } = Astro.props;
const t = useTranslations(lang);
const typeLabel = t(TIMELINE_TYPE_KEYS[entry.type]);
---

<article
  class="border-t border-line py-5 first:border-t-0 first:pt-0"
  data-timeline-item
  data-type={entry.type}
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <span class="label inline-flex items-center gap-2">
      {entry.current && <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>}
      {typeLabel}
    </span>
    <span class="mono whitespace-nowrap text-[0.6875rem] text-subtle">{entry.period}</span>
  </div>

  <h3 class="mt-2 font-serif text-[1.25rem] font-[540] leading-snug tracking-[-0.015em] text-ink-strong">
    {entry.org}
  </h3>
  <p class="mt-0.5 text-[0.9375rem] leading-snug text-muted">{entry.role}</p>
  <p class="mt-2 max-w-[62ch] text-pretty text-[0.9375rem] leading-[1.7] text-muted">{entry.summary}</p>

  {
    (entry.tags.length > 0 || entry.location) && (
      <div class="mt-3 flex flex-wrap items-center gap-1.5">
        {entry.location && <span class="chip">{entry.location}</span>}
        {entry.tags.slice(0, 3).map((tag) => (
          <span class="chip">{tag}</span>
        ))}
      </div>
    )
  }
</article>
