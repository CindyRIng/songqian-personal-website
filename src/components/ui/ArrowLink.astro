---
/**
 * ArrowLink — the one text-link affordance: label + an arrow that nudges right.
 * The underline is a 1px hairline that turns sage on hover.
 */
interface Props {
  href: string;
  label?: string;
  /** Arrow direction; `none` renders a plain link. */
  arrow?: 'right' | 'up-right' | 'none';
  external?: boolean;
  class?: string;
}

const { href, label, arrow = 'right', external = false, class: className = '' } = Astro.props;
const isExternal = external || /^(https?:|mailto:)/.test(href);
---

<a
  href={href}
  class:list={['arrow-link inline-flex items-baseline gap-2 whitespace-nowrap', className]}
  target={isExternal && !href.startsWith('mailto:') ? '_blank' : undefined}
  rel={isExternal && !href.startsWith('mailto:') ? 'noreferrer noopener' : undefined}
>
  <span class="arrow-label"><slot />{label}</span>
  {arrow !== 'none' && (
    <span aria-hidden="true" class="arrow-glyph">{arrow === 'up-right' ? '↗' : '→'}</span>
  )}
</a>

<style>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-block: -0.6875rem;
    padding-block: 0.6875rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    line-height: 1.6;
    color: var(--ink);
    text-decoration: none;
    touch-action: manipulation;
    transition: color var(--dur-1, 120ms) ease-out;
  }

  .arrow-label {
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition: border-color var(--dur-1, 120ms) ease-out;
  }

  .arrow-glyph {
    color: var(--accent);
    transition: transform var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  .arrow-link:active {
    transform: translateY(1px);
  }

  .arrow-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: var(--ring-offset, 3px);
    border-radius: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .arrow-link:hover {
      color: var(--accent-strong);
    }

    .arrow-link:hover .arrow-label {
      border-color: var(--accent);
    }

    .arrow-link:hover .arrow-glyph {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow-glyph,
    .arrow-label,
    .arrow-link {
      transition: none;
    }

    .arrow-link:active {
      transform: none;
    }

    .arrow-link:hover .arrow-glyph {
      transform: none;
    }
  }
</style>
