---
/**
 * ArtPlate — the full-bleed "paper plate": engraved wheel, warm sun disc,
 * hairline grid, corner registration crosses, a manifesto pair and mono
 * coordinates. Pure CSS + inline SVG, so it adapts to both themes and never
 * depends on an image.
 *
 * Motion (owned by HomeMotion): the wheel gets a subtle scroll parallax
 * (data-plate-wheel) and the inner content is mask-revealed when the plate
 * enters the viewport (data-plate). Reduced motion renders it static.
 */
interface Props {
  quote: string;
  quoteEn?: string;
  meta?: string;
  variant?: 'sun' | 'rings';
  class?: string;
}

const { quote, quoteEn, meta, variant = 'sun', class: className = '' } = Astro.props;

/* Outer ring radii + opacities — deterministic, engraved feel. */
const rings = [
  { r: 300, o: 0.2 },
  { r: 274, o: 0.34 },
  { r: 236, o: 0.19 },
  { r: 190, o: 0.16 },
  { r: 146, o: 0.23 },
  { r: 110, o: 0.31 },
  { r: 96, o: 0.3 },
];

/* 72 ticks around the outer rim, 24 on the inner hub. */
const outerTicks = Array.from({ length: 72 }, (_, i) => i * 5);
const innerTicks = Array.from({ length: 24 }, (_, i) => i * 15);
---

<section
  class:list={['art-plate grain', className]}
  aria-label="纸墨图版"
  data-plate
  data-plate-variant={variant}
>
  <span class="plate-field" aria-hidden="true"></span>
  <span class="plate-horizon" aria-hidden="true"></span>

  <div class="plate-wheel" data-plate-wheel aria-hidden="true">
    <svg viewBox="0 0 640 640" fill="none">
      <defs>
        <radialGradient id="plate-disc" cx="46%" cy="42%" r="58%">
          <stop offset="0%" stop-color="var(--terra, #b98357)"></stop>
          <stop offset="58%" stop-color="var(--terra, #b98357)" stop-opacity="0.82"></stop>
          <stop offset="100%" stop-color="var(--terra, #b98357)" stop-opacity="0.6"></stop>
        </radialGradient>
      </defs>

      <g stroke="var(--accent)">
        {
          rings.map((ring) => (
            <circle cx="320" cy="320" r={ring.r} stroke-opacity={ring.o} />
          ))
        }
        <line x1="20" y1="320" x2="620" y2="320" stroke-opacity="0.1"></line>
        <line x1="320" y1="20" x2="320" y2="620" stroke-opacity="0.1"></line>
      </g>

      <g stroke="var(--accent)" stroke-linecap="butt">
        {
          outerTicks.map((deg, index) => (
            <line
              x1="320"
              y1={index % 6 === 0 ? 40 : 54}
              x2="320"
              y2="62"
              stroke-width={index % 6 === 0 ? 1 : 0.8}
              stroke-opacity={index % 6 === 0 ? 0.42 : 0.2}
              transform={`rotate(${deg} 320 320)`}
            />
          ))
        }
        {
          innerTicks.map((deg) => (
            <line
              x1="320"
              y1="224"
              x2="320"
              y2="232"
              stroke-width="0.8"
              stroke-opacity="0.22"
              transform={`rotate(${deg} 320 320)`}
            />
          ))
        }
      </g>

      <circle cx="320" cy="320" r="86" fill="url(#plate-disc)" opacity="0.92"></circle>
      <circle
        cx="320"
        cy="320"
        r="86"
        stroke="var(--accent-deep, var(--accent))"
        stroke-opacity="0.18"></circle>
      <circle cx="320" cy="320" r="4.5" fill="var(--accent-deep, var(--accent))" opacity="0.55"></circle>
    </svg>
  </div>

  <span class="plate-reg plate-reg--tl" aria-hidden="true"></span>
  <span class="plate-reg plate-reg--tr" aria-hidden="true"></span>
  <span class="plate-reg plate-reg--bl" aria-hidden="true"></span>
  <span class="plate-reg plate-reg--br" aria-hidden="true"></span>
  <span class="plate-frame" aria-hidden="true"></span>

  <div class="plate-inner wrap" data-plate-inner>
    <p class="plate-label">
      <span>Plate I</span>
      <span class="plate-label-line" aria-hidden="true"></span>
      <span class="plate-label-en">Compounding</span>
    </p>
    <p class="plate-manifesto">{quote}</p>
    {quoteEn && <p class="plate-en">{quoteEn}</p>}
    {meta && <p class="plate-meta">{meta}</p>}
  </div>
</section>

<style>
  .art-plate {
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    margin-top: clamp(4rem, 8vw, 7rem);
    height: clamp(26rem, 38vw, 34rem);
    overflow: hidden;
    background: linear-gradient(
      180deg,
      var(--paper, var(--canvas)) 0%,
      var(--sage-tint, var(--surface)) 58%,
      color-mix(in oklab, var(--sage-tint, var(--surface)) 82%, var(--terra, var(--accent)))
        100%
    );
  }

  .plate-field {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 40%;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--accent) 4%, transparent),
        color-mix(in oklab, var(--accent) 13%, transparent)
      ),
      repeating-linear-gradient(
        180deg,
        color-mix(in oklab, var(--accent-deep, var(--accent)) 12%, transparent) 0 1px,
        transparent 1px 15px
      );
  }

  .plate-field::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--paper, var(--canvas)) 92%, transparent),
      transparent 30%,
      transparent 78%,
      color-mix(in oklab, var(--paper, var(--canvas)) 85%, transparent)
    );
  }

  .plate-horizon {
    position: absolute;
    inset-inline: 0;
    top: 64%;
    height: 1px;
    background: color-mix(in oklab, var(--accent-deep, var(--accent)) 24%, transparent);
  }

  .plate-wheel {
    position: absolute;
    right: 3.5%;
    top: 50%;
    width: min(46rem, 58vw);
    height: min(46rem, 58vw);
    translate: 0 -50%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 26%);
    mask-image: linear-gradient(90deg, transparent 0, #000 26%);
    will-change: transform;
  }

  .plate-wheel svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plate-frame {
    position: absolute;
    inset: 1.625rem;
    border: 1px solid color-mix(in oklab, var(--ink) 14%, transparent);
    pointer-events: none;
  }

  .plate-reg {
    position: absolute;
    width: 13px;
    height: 13px;
    opacity: 0.55;
    pointer-events: none;
  }

  .plate-reg::before,
  .plate-reg::after {
    content: '';
    position: absolute;
    background: color-mix(in oklab, var(--ink) 50%, transparent);
  }

  .plate-reg::before {
    left: 6px;
    top: 0;
    width: 1px;
    height: 13px;
  }

  .plate-reg::after {
    left: 0;
    top: 6px;
    width: 13px;
    height: 1px;
  }

  .plate-reg--tl {
    left: 1.875rem;
    top: 1.875rem;
  }
  .plate-reg--tr {
    right: 1.875rem;
    top: 1.875rem;
  }
  .plate-reg--bl {
    left: 1.875rem;
    bottom: 1.875rem;
  }
  .plate-reg--br {
    right: 1.875rem;
    bottom: 1.875rem;
  }

  .plate-inner {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .plate-label {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .plate-label-line {
    width: 4.5rem;
    height: 1px;
    background: color-mix(in oklab, var(--ink) 26%, transparent);
  }

  .plate-label-en {
    color: var(--subtle);
  }

  .plate-manifesto {
    margin-top: 1.75rem;
    max-width: 44rem;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 2.8vw, 2.5625rem);
    font-weight: 500;
    letter-spacing: 0.015em;
    line-height: 1.45;
    color: var(--ink-strong);
    text-wrap: balance;
  }

  .plate-en {
    margin-top: 1.25rem;
    max-width: 40rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.8;
    color: var(--muted);
  }

  .plate-meta {
    position: absolute;
    inset-inline: 0;
    bottom: 1.75rem;
    padding-inline: var(--gutter);
  }
    font-family: var(--font-mono);
    font-size: 0.5938rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--subtle);
    line-height: 1.9;
  }

  /* Mask reveal — the inner block wipes in from the left when the plate
     enters the viewport (HomeMotion toggles .is-inview). */
  :global(.js) .plate-inner {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 900ms var(--ease-out, cubic-bezier(0.22, 0.61, 0.36, 1));
  }

  :global(.js) .art-plate.is-inview .plate-inner {
    clip-path: inset(0 0 0 0);
  }

  @media (max-width: 900px) {
    .art-plate {
      height: clamp(24rem, 72vw, 30rem);
    }

    .plate-wheel {
      width: 130vw;
      height: 130vw;
      right: -46vw;
    }

    .plate-frame {
      inset: 1rem;
    }

    .plate-reg {
      display: none;
    }

    .plate-meta {
      bottom: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .plate-inner {
      clip-path: none;
      transition: none;
    }

    .plate-wheel {
      will-change: auto;
    }
  }
</style>
