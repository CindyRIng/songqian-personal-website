---
/**
 * Badge — a tiny status label (used for project status, tags and metadata).
 */
interface Props {
  label: string;
  tone?: 'accent' | 'muted' | 'faint';
  dot?: boolean;
  class?: string;
}

const { label, tone = 'muted', dot = false, class: className = '' } = Astro.props;

const toneClass = {
  accent: 'text-accent',
  muted: 'text-subtle',
  faint: 'text-faint',
}[tone];

const dotClass = {
  accent: 'bg-accent',
  muted: 'bg-subtle',
  faint: 'bg-faint',
}[tone];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 whitespace-nowrap font-sans text-[0.625rem] font-medium uppercase leading-none tracking-[0.09em]',
    toneClass,
    className,
  ]}
>
  {dot && <span aria-hidden="true" class:list={['size-1 rounded-full', dotClass]} />}
  <span>{label}</span>
</span>
