---
/**
 * SectionHead — the V4 "de-templated" section header.
 *
 * One plain single-language label, one plain lede, an optional quiet link.
 * No numbering, no English italic subtitle, no bilingual pair — the content
 * should do the talking.
 */
interface Props {
  title: string;
  lede?: string;
  href?: string;
  actionLabel?: string;
  id?: string;
  class?: string;
}

const { title, lede, href, actionLabel, id, class: className = '' } = Astro.props;
---

<header class:list={['sec-head', className]} data-reveal>
  <h2 class="sec-title" id={id}>{title}</h2>
  {lede && <p class="sec-lede">{lede}</p>}
  {
    href && actionLabel && (
      <a class="sec-action" href={href}>
        {actionLabel}
        <span class="sec-arrow" aria-hidden="true">
          →
        </span>
      </a>
    )
  }
</header>

<style>
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.75rem;
    padding-top: 0.9375rem;
    border-top: 1px solid var(--line-strong);
  }

  .sec-title {
    flex: 0 0 auto;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.3;
    color: var(--ink-strong);
  }

  .sec-lede {
    flex: 1 1 16rem;
    min-width: 0;
    max-width: 40rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--muted);
    text-wrap: pretty;
  }

  .sec-action {
    flex: 0 0 auto;
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin-block: -0.8125rem;
    padding-block: 0.8125rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    touch-action: manipulation;
    transition:
      color var(--dur-1, 120ms) ease-out,
      border-color var(--dur-1, 120ms) ease-out;
  }

  .sec-arrow {
    color: var(--accent);
    display: inline-block;
    transition: transform var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  .sec-action:active {
    transform: translateY(1px);
  }

  .sec-action:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: var(--ring-offset, 3px);
    border-radius: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .sec-action:hover {
      color: var(--accent-strong);
      border-bottom-color: var(--accent);
    }

    .sec-action:hover .sec-arrow {
      transform: translateX(3px);
    }
  }

  @media (max-width: 640px) {
    .sec-head {
      gap: 0.375rem 1rem;
    }

    .sec-title {
      font-size: 1.3125rem;
    }

    /* Title + action on one line, lede underneath: less vertical template. */
    .sec-title {
      order: 0;
    }

    .sec-action {
      order: 1;
      margin-inline-start: auto;
    }

    .sec-lede {
      order: 2;
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sec-action,
    .sec-arrow {
      transition: none;
    }

    .sec-action:active,
    .sec-action:hover .sec-arrow {
      transform: none;
    }
  }
</style>
