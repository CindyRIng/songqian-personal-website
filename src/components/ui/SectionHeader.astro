---
/**
 * SectionHeader — a quiet section title with an optional arrow link on the
 * right. Used by the home page sections and available to every other view.
 */
import ArrowLink from './ArrowLink.astro';

interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  /** Heading level, keeps the document outline meaningful. */
  as?: 'h2' | 'h3';
  class?: string;
}

const { title, href, linkLabel, as = 'h2', class: className = '' } = Astro.props;
const Tag = as;
---

<div class:list={['flex items-baseline justify-between gap-4', className]}>
  <Tag class="font-serif text-[1.0625rem] font-[550] tracking-[-0.012em] text-ink-strong">
    {title}
  </Tag>
  {href && linkLabel && (
    <ArrowLink href={href} label={linkLabel} class="shrink-0 pb-px" />
  )}
</div>
