---
/**
 * StatBar — the mono number band under the hero.
 *   5          6           43            93
 *   篇文章      个工具       项能力        项测试通过
 *
 * Values are animated by the home motion script via [data-count]; the numbers
 * in the markup are the final values, so no-JS renders correctly and the
 * count-up can never change layout (tabular-nums + reserved min-width).
 */
interface Stat {
  value: string;
  label: string;
  en?: string;
}

interface Props {
  stats: Stat[];
  label?: string;
  class?: string;
}

const { stats, label = 'At a glance', class: className = '' } = Astro.props;
---

<section aria-label={label} class:list={['stat-bar', className]}>
  {
    stats.map((stat, index) => {
      const digits = String(stat.value).replace(/\D/g, '').length || 1;
      return (
        <div class="stat-cell">
          <p class="stat-num mono" data-stat-index={index}>
            <span data-count={stat.value} style={`min-width:${digits}ch`}>{stat.value}</span>
          </p>
          <p class="stat-label">
            {stat.label}
            {stat.en && <span class="stat-label-en">{stat.en}</span>}
          </p>
        </div>
      );
    })
  }
</section>

<style>
  .stat-bar {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1.5px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .stat-cell {
    padding: 1.375rem 1.75rem 1.5rem 0;
    border-inline-end: 1px solid var(--line);
    min-width: 0;
  }

  .stat-cell + .stat-cell {
    padding-inline-start: 1.75rem;
  }

  .stat-cell:last-child {
    border-inline-end: 0;
    padding-inline-end: 0;
  }

  .stat-num {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 2.6vw, 2.625rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--ink-strong);
    font-variant-numeric: tabular-nums;
  }

  .stat-num > span {
    display: inline-block;
  }

  .stat-label {
    margin-top: 0.6875rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.4;
  }

  .stat-label-en {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.5938rem;
    letter-spacing: 0.14em;
    font-weight: 400;
    color: var(--subtle);
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .stat-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat-cell {
      padding: 1.25rem 1rem 1.25rem 0;
    }

    .stat-cell + .stat-cell {
      padding-inline-start: 1rem;
    }

    .stat-cell:nth-child(2n) {
      border-inline-end: 0;
    }

    .stat-cell:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .stat-num {
      font-size: 2rem;
    }
  }
</style>
