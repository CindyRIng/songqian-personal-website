---
/**
 * EssayRow — one entry of the numbered writing index (A+ direction).
 *
 * Layout: mono number → title + English/Chinese subtitle + one-liner → right
 * meta (category · date) with a quiet arrow. The first (featured) row is set
 * larger and shows the "read" action; later rows are compact.
 *
 * Interaction: the whole row is one link. Hover only fires on hover-capable
 * pointers (row wash + title/number/arrow accents), focus-visible draws the
 * shared ring, and press gives a 1px settle. All of it is disabled under
 * `prefers-reduced-motion`.
 */
import Icon from '../ui/Icon.astro';
import { formatDate, isoDate, localizePath, useTranslations } from '../../i18n/utils';
import type { TranslationKey } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import type { PostEntry } from '../../lib/posts';

interface Props {
  post: PostEntry;
  lang: Locale;
  /** 1-based position in the index (used for the mono counter). */
  index: number;
  featured?: boolean;
}

const { post, lang, index, featured = false } = Astro.props;
const t = useTranslations(lang);
const href = localizePath(post.path, lang);
const number = String(index).padStart(2, '0');
const categoryKey = (`writing.category.${post.category}`) as TranslationKey;

/** The other language's title, shown as the bilingual subtitle. */
const otherLocale: Locale = lang === 'zh' ? 'en' : 'zh';
const subtitle = post.titleByLocale[otherLocale];
---
<a
  href={href}
  data-featured={featured ? '' : undefined}
  class:list={[
    'essay-row group grid grid-cols-[2.25rem_minmax(0,1fr)] items-start gap-x-4 gap-y-3 border-b border-line py-6 sm:grid-cols-[3rem_minmax(0,1fr)_9rem] sm:gap-x-8',
    featured ? 'py-8 sm:py-11' : 'sm:py-7',
  ]}
>
  <span
    class:list={[
      'essay-number mt-1 font-mono tabular leading-none text-faint',
      featured ? 'text-[0.8125rem] text-accent' : 'text-[0.6875rem]',
    ]}
  >{number}</span>

  <div class="min-w-0">
    <p class="flex flex-wrap items-center gap-x-2 font-sans text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-accent">
      <span>{t(categoryKey)}</span>
      {featured && <span aria-hidden="true" class="text-faint">·</span>}
      {featured && <span class="text-faint">{t('writing.featured')}</span>}
    </p>

    <h2
      class:list={[
        'essay-title mt-2 font-serif font-[540] tracking-[-0.022em] text-ink-strong text-balance',
        featured
          ? 'text-[clamp(1.75rem,3.2vw,2.5rem)] leading-[1.15]'
          : 'text-[1.25rem] leading-[1.3] sm:text-[1.375rem]',
      ]}
    >
      {post.title}
    </h2>

    {
      subtitle && (
        <p
          class:list={[
            'essay-subtitle display-latin mt-1.5 text-muted',
            featured ? 'text-[1.125rem] sm:text-[1.25rem]' : 'text-[0.9375rem]',
          ]}
        >
          {subtitle}
        </p>
      )
    }

    <p
      class:list={[
        'mt-3 font-serif leading-[1.65] text-muted text-pretty',
        featured ? 'max-w-[34rem] text-[1.0625rem]' : 'line-clamp-2 max-w-[34rem] text-[0.9375rem]',
      ]}
    >
      {post.description}
    </p>

    {
      featured && (
        <span class="essay-readmore mt-5 inline-flex items-center gap-2 font-sans text-[0.8125rem] text-ink-strong">
          {t('actions.readMore')}
          <Icon name="arrow-right" size={14} class="essay-readmore-arrow" />
        </span>
      )
    }
  </div>

  <div
    class="col-start-2 mt-1 flex items-center justify-between gap-4 sm:col-start-3 sm:flex-col sm:items-end sm:gap-5"
  >
    <p
      class="flex flex-wrap items-center gap-x-2 font-mono text-[0.6875rem] uppercase tracking-[0.06em] text-subtle sm:flex-col sm:items-end sm:gap-y-1 sm:text-right"
    >
      <time datetime={isoDate(post.date)} class="tabular whitespace-nowrap">
        {formatDate(post.date, lang, 'short')}
      </time>
      <span class="flex items-center gap-2">
        <span aria-hidden="true" class="text-faint sm:hidden">·</span>
        <span class="tabular whitespace-nowrap">{t('common.minRead', { n: post.readingTime })}</span>
      </span>
    </p>
    <Icon
      name="arrow-right"
      size={featured ? 20 : 16}
      class="essay-arrow shrink-0 text-faint"
    />
  </div>
</a>

<style>
  .essay-row {
    position: relative;
    isolation: isolate;
    border-radius: 6px;
    touch-action: manipulation;
    transition: transform 100ms var(--ease-out);
  }

  /* Hover wash sits behind the row and bleeds slightly into the gutter. */
  .essay-row::before {
    content: '';
    position: absolute;
    inset: 0 -0.75rem;
    border-radius: 6px;
    background: var(--hover);
    opacity: 0;
    transition: opacity var(--dur-1) ease-out;
    pointer-events: none;
    z-index: -1;
  }

  .essay-row .essay-title,
  .essay-row .essay-number,
  .essay-row .essay-subtitle {
    transition:
      color var(--dur-1) ease-out,
      transform var(--dur-2) var(--ease-out);
  }

  /* The arrows are SVGs rendered by the Icon component, so they carry their
     own scope attribute — style them through a global descendant rule. */
  :global(.essay-row .essay-arrow),
  :global(.essay-row .essay-readmore-arrow) {
    transition:
      color var(--dur-1) ease-out,
      transform var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .essay-row:hover::before {
      opacity: 1;
    }

    .essay-row:hover .essay-title {
      color: var(--accent-strong);
    }

    .essay-row:hover .essay-number {
      color: var(--accent);
    }

    :global(.essay-row:hover .essay-arrow) {
      color: var(--accent);
      transform: translateX(3px);
    }

    :global(.essay-row:hover .essay-readmore-arrow) {
      transform: translateX(3px);
    }

    /* Featured row earns a slightly warmer wash on hover. */
    .essay-row[data-featured]:hover::before {
      background: var(--accent-soft);
    }
  }

  .essay-row:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .essay-row:active {
    transform: translateY(1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .essay-row,
    .essay-row::before,
    .essay-row .essay-title,
    .essay-row .essay-number,
    .essay-row .essay-subtitle,
    :global(.essay-row .essay-arrow),
    :global(.essay-row .essay-readmore-arrow) {
      transition: none;
    }

    .essay-row:active {
      transform: none;
    }
  }
</style>
