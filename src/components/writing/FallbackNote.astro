---
/**
 * FallbackNote — the honest, quiet note shown when an essay has not been
 * translated into the page's language yet. The page still reads in English,
 * and the visitor is told so once, in their own language.
 */
import Icon from '../ui/Icon.astro';
import { useTranslations, localeMeta } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
  sourceLang: Locale;
  class?: string;
}

const { lang, sourceLang, class: className = '' } = Astro.props;
const t = useTranslations(lang);
const sourceLabel = localeMeta[sourceLang].nativeLabel;
---
<p
  class:list={[
    'inline-flex flex-wrap items-center gap-2 font-sans text-[0.75rem] leading-relaxed text-muted',
    className,
  ]}
>
  <span class="grid size-5 shrink-0 place-items-center rounded-full bg-accent-soft text-accent">
    <Icon name="globe" size={12} />
  </span>
  <span>{t('writing.onlyAvailableIn')}</span>
  <span class="rounded-full bg-hover px-1.5 py-0.5 text-[0.625rem] font-medium uppercase tracking-wide text-subtle">
    {sourceLabel}
  </span>
</p>
