---
/**
 * Pagination — quiet circular arrows with a localized "page N of M" caption.
 * Hidden entirely when there is only one page.
 */
import Icon from '../ui/Icon.astro';
import { localizePath, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { writingPagePath } from '../../lib/posts';

interface Props {
  lang: Locale;
  page: number;
  totalPages: number;
  class?: string;
}

const { lang, page, totalPages, class: className = '' } = Astro.props;
const t = useTranslations(lang);

const hasPrev = page > 1;
const hasNext = page < totalPages;
const prevHref = localizePath(writingPagePath(page - 1), lang);
const nextHref = localizePath(writingPagePath(page + 1), lang);
const buttonClass =
  'grid size-10 place-items-center rounded-full border border-line text-muted transition-colors duration-200 ease-out hover:border-line-strong hover:bg-elevated hover:text-ink';
const disabledClass = 'grid size-10 place-items-center rounded-full text-faint';
---
{
  totalPages > 1 && (
    <nav
      aria-label={t('common.pageOf', { n: page, total: totalPages })}
      class:list={[
        'mt-12 flex items-center justify-between gap-6 border-t border-line pt-6',
        className,
      ]}
    >
      {hasPrev ? (
        <a href={prevHref} aria-label={t('writing.prevPage')} class={buttonClass} rel="prev">
          <Icon name="arrow-left" size={16} class="rotate-180" />
        </a>
      ) : (
        <span class={disabledClass} aria-hidden="true">
          <Icon name="arrow-left" size={16} class="rotate-180 opacity-40" />
        </span>
      )}

      <span class="font-mono text-[0.6875rem] tabular tracking-[0.06em] text-subtle">
        {t('common.pageOf', { n: page, total: totalPages })}
      </span>

      {hasNext ? (
        <a href={nextHref} aria-label={t('writing.nextPage')} class={buttonClass} rel="next">
          <Icon name="arrow-right" size={16} />
        </a>
      ) : (
        <span class={disabledClass} aria-hidden="true">
          <Icon name="arrow-right" size={16} class="opacity-40" />
        </span>
      )}
    </nav>
  )
}
