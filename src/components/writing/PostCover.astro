---
/**
 * PostCover — deterministic, CSS-only editorial cover plate.
 *
 * Sibling of the project plates (src/components/projects/CoverArt.astro): the
 * same layering language — a seeded gradient field, a fading hairline grid,
 * thin SVG rings and an oversized serif initial with an outlined echo at full
 * opacity — rendered from design tokens only, so it follows light and dark mode.
 *
 * No images, no network assets. The composition is derived from a stable hash
 * of the slug, so an essay always gets the same plate across builds and locales.
 */
import { hashString } from '../../lib/format';

interface Props {
  slug: string;
  /** Used for the monogram initial. */
  title?: string;
  /** Mono counter in the top corner, e.g. the publication year. */
  year?: number | string;
  class?: string;
  /** Decorative sizes: `hero` for the article banner, `card` for the list lead. */
  size?: 'hero' | 'card';
}

const { slug, title = '', year, class: className = '', size = 'card' } = Astro.props;

const h = hashString(slug);
const accent = 22 + (h % 20); // 22–41% accent in the main glow
const ink = 6 + ((h >> 4) % 10); // 6–15% ink depth
const muted = 24 + ((h >> 8) % 22); // 24–45% muted counter-glow
const angle = 96 + ((h >> 12) % 88); // 96–183deg sweep
const x1 = 6 + ((h >> 3) % 38); // glow positions (%)
const y1 = 2 + ((h >> 6) % 30);
const x2 = 56 + ((h >> 10) % 38);
const y2 = 48 + ((h >> 14) % 42);
const ringBleed = 8 + ((h >> 17) % 24); // px the ring cluster bleeds off-canvas
const ringTilt = (h % 44) - 22; // degrees
const ghostX = 8 + ((h >> 19) % 12); // px offset of the outlined echo
const ghostRise = 6 + ((h >> 21) % 8);

/** First glyph of the title — works for Latin and CJK titles alike. */
const initial = (title.trim().charAt(0) || slug.charAt(0) || 'S').toUpperCase();

const style = [
  `--pc-angle:${angle}deg`,
  `--pc-accent:${accent}%`,
  `--pc-ink:${ink}%`,
  `--pc-muted:${muted}%`,
  `--pc-x1:${x1}%`,
  `--pc-y1:${y1}%`,
  `--pc-x2:${x2}%`,
  `--pc-y2:${y2}%`,
  `--pc-ring:${ringBleed}px`,
  `--pc-tilt:${ringTilt}deg`,
  `--pc-ghost-x:${ghostX}px`,
  `--pc-ghost-rise:${ghostRise}px`,
].join(';');
---
<div
  class:list={[
    'post-cover relative isolate flex flex-col justify-between overflow-hidden rounded-xl bg-surface ring-1 ring-line',
    className,
  ]}
  style={style}
  data-post-cover={slug}
  data-cover-size={size}
  aria-hidden="true"
>
  <span class="post-cover__base"></span>
  <span class="post-cover__grid"></span>

  <svg class="post-cover__rings" viewBox="0 0 320 320" fill="none">
    <circle cx="232" cy="88" r="140" stroke="currentColor" stroke-width="1" opacity="0.26"></circle>
    <circle cx="232" cy="88" r="94" stroke="currentColor" stroke-width="1" opacity="0.2"></circle>
    <circle cx="232" cy="88" r="48" stroke="currentColor" stroke-width="1" opacity="0.16"></circle>
    <circle cx="232" cy="88" r="2.5" fill="currentColor" opacity="0.5"></circle>
    <path d="M232 88 320 34" stroke="currentColor" stroke-width="1" opacity="0.16"></path>
  </svg>

  <div class="post-cover__top">
    {year && <span class="post-cover__counter tabular">{year}</span>}
  </div>

  <div class="post-cover__bottom">
    <span class="post-cover__mono">
      <span class="post-cover__ghost">{initial}</span>
      <span class="post-cover__initial">{initial}</span>
    </span>
  </div>
</div>

<style>
  .post-cover {
    container-type: inline-size;
    color: var(--ink);
  }

  .post-cover__base {
    position: absolute;
    inset: -12%;
    background:
      radial-gradient(
        115% 92% at var(--pc-x1) var(--pc-y1),
        color-mix(in oklab, var(--accent) var(--pc-accent), transparent) 0%,
        transparent 64%
      ),
      radial-gradient(
        82% 76% at var(--pc-x2) var(--pc-y2),
        color-mix(in oklab, var(--ink) var(--pc-ink), transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        95% 85% at 82% 104%,
        color-mix(in oklab, var(--muted) var(--pc-muted), transparent) 0%,
        transparent 68%
      ),
      linear-gradient(
        var(--pc-angle),
        color-mix(in oklab, var(--elevated) 82%, var(--canvas)) 0%,
        var(--surface) 52%,
        color-mix(in oklab, var(--canvas) 72%, var(--surface)) 100%
      );
  }

  .post-cover__grid {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        0deg,
        color-mix(in oklab, var(--ink) 7%, transparent) 0 1px,
        transparent 1px 30px
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in oklab, var(--ink) 7%, transparent) 0 1px,
        transparent 1px 30px
      );
    -webkit-mask-image: linear-gradient(180deg, black 0%, transparent 76%);
    mask-image: linear-gradient(180deg, black 0%, transparent 76%);
  }

  .post-cover__rings {
    position: absolute;
    top: calc(-1 * var(--pc-ring));
    right: calc(-1 * var(--pc-ring));
    width: min(72%, 420px);
    height: auto;
    color: var(--muted);
    rotate: var(--pc-tilt);
  }

  .post-cover__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: clamp(0.85rem, 4.5cqw, 1.4rem) clamp(1rem, 5cqw, 1.6rem) 0;
  }

  .post-cover__counter {
    font-family: var(--font-mono);
    font-size: clamp(0.625rem, 2.1cqw, 0.6875rem);
    font-weight: 450;
    letter-spacing: 0.06em;
    color: var(--subtle);
  }

  .post-cover__bottom {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    min-height: clamp(3.75rem, 30cqw, 9rem);
    padding: 0 clamp(0.85rem, 4cqw, 1.4rem) clamp(0.8rem, 4cqw, 1.25rem);
  }

  .post-cover__mono {
    position: relative;
    z-index: 1;
    line-height: 0;
  }

  .post-cover__initial {
    position: relative;
    z-index: 1;
    display: block;
    font-family: var(--font-serif);
    font-weight: 520;
    font-size: clamp(3.25rem, 34cqw, 10rem);
    line-height: 0.7;
    letter-spacing: -0.055em;
    margin-bottom: -0.085em;
    margin-left: -0.06em;
    color: color-mix(in oklab, var(--ink-strong) 84%, var(--accent));
    text-shadow: 0 1px 0 color-mix(in oklab, var(--canvas) 36%, transparent);
    user-select: none;
  }

  .post-cover__ghost {
    position: absolute;
    z-index: 0;
    left: var(--pc-ghost-x);
    bottom: var(--pc-ghost-rise);
    display: block;
    font-family: var(--font-serif);
    font-weight: 520;
    font-size: clamp(3.25rem, 34cqw, 10rem);
    line-height: 0.7;
    letter-spacing: -0.055em;
    color: transparent;
    -webkit-text-stroke: 1.25px color-mix(in oklab, var(--ink) 26%, transparent);
    user-select: none;
  }
</style>
