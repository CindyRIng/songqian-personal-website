---
/**
 * PostFooterBio — the author card that closes every essay.
 * Short identity lines from profile.ts; no long biography.
 */
import Icon from '../ui/Icon.astro';
import { localizePath, useTranslations } from '../../i18n/utils';
import { profile, lt } from '../../data/profile';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);

const name = lt(profile.name, lang) || profile.latinName;
const role = lt(profile.role, lang);
const tagline = lt(profile.tagline, lang);
const github = profile.socials.find((social) => social.label === 'GitHub');
---
<aside class:list={['bio-card mt-16 border-t border-line pt-8', className]}>
  <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex items-start gap-4">
      <span
        aria-hidden="true"
        class="grid size-11 shrink-0 place-items-center rounded-full bg-sage-tint font-serif text-[0.875rem] font-[560] tracking-[0.02em] text-accent ring-1 ring-line"
      >
        {profile.monogram}
      </span>
      <div class="flex min-w-0 flex-col gap-1.5">
        <p class="font-sans text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-subtle">
          {t('writing.author')}
        </p>
        <p
          class="font-serif text-[1.125rem] font-[560] leading-none tracking-[-0.01em] text-ink-strong"
        >
          {name}
        </p>
        <p class="font-sans text-[0.8125rem] leading-relaxed text-subtle">{role}</p>
        <p class="mt-1 max-w-[26rem] font-serif text-[0.9375rem] leading-[1.6] text-muted">
          {tagline}
        </p>
      </div>
    </div>

    <div
      class="flex flex-wrap items-center gap-x-5 gap-y-1 font-sans text-[0.8125rem] sm:flex-col sm:items-end sm:gap-0.5 sm:text-right"
    >
      <a href={localizePath('/about', lang)} class="bio-link bio-link--strong group">
        <span class="bio-link-text">{t('nav.about')}</span>
        <Icon name="arrow-right" size={13} class="bio-link-arrow" />
      </a>
      {
        github && (
          <a href={github.href} target="_blank" rel="noopener noreferrer" class="bio-link group">
            <span class="bio-link-text">GitHub</span>
            <span class="sr-only">{t('a11y.external')}</span>
          </a>
        )
      }
      <a href={`mailto:${profile.email}`} class="bio-link group">
        <span class="bio-link-text">{profile.email}</span>
      </a>
    </div>
  </div>
</aside>

<style>
  .bio-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--muted);
    touch-action: manipulation;
    transition: color var(--dur-1) ease-out;
  }

  .bio-link--strong {
    color: var(--ink);
  }

  .bio-link .bio-link-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 calc(100% - 0.15em);
    transition:
      background-size var(--dur-2) var(--ease-out),
      color var(--dur-1) ease-out;
  }

  :global(.bio-link .bio-link-arrow) {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .bio-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .bio-link:hover {
      color: var(--ink);
    }

    .bio-link--strong:hover {
      color: var(--accent-strong);
    }

    .bio-link:hover .bio-link-text {
      background-size: 100% 1px;
    }

    :global(.bio-link:hover .bio-link-arrow) {
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bio-link,
    .bio-link .bio-link-text,
    :global(.bio-link .bio-link-arrow) {
      transition: color var(--dur-1) ease-out;
    }
  }
</style>
