---
/**
 * PostHeader — the article opener (A+ direction).
 *
 * Category / date / reading time label, an oversized serif title, the other
 * language's title as an italic subtitle, then the lede.
 */
import { formatDate, isoDate, useTranslations } from '../../i18n/utils';
import type { TranslationKey } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import type { PostEntry } from '../../lib/posts';

interface Props {
  post: PostEntry;
  lang: Locale;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const categoryKey = (`writing.category.${post.category}`) as TranslationKey;
const otherLocale: Locale = lang === 'zh' ? 'en' : 'zh';
const subtitle = post.titleByLocale[otherLocale];
---
<header class="flex flex-col">
  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-accent">
    <span>{t(categoryKey)}</span>
    <span aria-hidden="true" class="text-faint">·</span>
    <time datetime={isoDate(post.date)} class="tabular text-subtle">
      {formatDate(post.date, lang, 'long')}
    </time>
    <span aria-hidden="true" class="text-faint">·</span>
    <span class="tabular text-subtle">{t('common.minRead', { n: post.readingTime })}</span>
  </p>

  <h1
    class="mt-6 font-serif text-[clamp(2rem,5vw,3.25rem)] font-[520] leading-[1.1] tracking-[-0.028em] text-ink-strong text-balance"
  >
    {post.title}
  </h1>

  {
    subtitle && (
      <p class="display-latin mt-4 text-[1.25rem] leading-[1.4] text-muted sm:text-[1.5rem]">
        {subtitle}
      </p>
    )
  }

  <p class="lede mt-7 max-w-[35rem]">{post.description}</p>

  <div class="mt-8 h-px w-full bg-line"></div>
</header>
