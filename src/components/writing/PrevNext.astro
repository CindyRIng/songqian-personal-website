---
/**
 * PrevNext — previous / next essay links at the foot of an article.
 * `older` is the previous essay in time, `newer` is the next one.
 *
 * The whole card is a link: hover lifts it 2px and draws an accent border,
 * focus-visible gets the shared ring, press settles 1px. Hover is restricted to
 * hover-capable pointers; reduced motion keeps colour state only.
 */
import Icon from '../ui/Icon.astro';
import { formatDate, isoDate, localizePath, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import type { PostEntry } from '../../lib/posts';

interface Props {
  lang: Locale;
  older?: PostEntry;
  newer?: PostEntry;
}

const { lang, older, newer } = Astro.props;
const t = useTranslations(lang);
---
{
  (older || newer) && (
    <nav aria-label={t('writing.related')} class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {older && (
        <a
          href={localizePath(older.path, lang)}
          rel="prev"
          class="pn-card group flex flex-col gap-2 rounded-xl border border-line bg-canvas p-5 sm:p-6"
        >
          <span class="pn-label flex items-center gap-1.5 font-sans text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-subtle">
            <Icon name="arrow-left" size={12} class="pn-arrow" />
            {t('writing.prev')}
          </span>
          <span class="pn-title font-serif text-[1.0625rem] font-[540] leading-snug tracking-[-0.012em] text-ink-strong text-balance">
            {older.title}
          </span>
          <time
            datetime={isoDate(older.date)}
            class="mt-auto pt-1 font-mono text-[0.6875rem] tabular text-subtle"
          >
            {formatDate(older.date, lang, 'short')}
          </time>
        </a>
      )}

      {newer && (
        <a
          href={localizePath(newer.path, lang)}
          rel="next"
          class="pn-card group flex flex-col gap-2 rounded-xl border border-line bg-canvas p-5 sm:items-end sm:p-6 sm:text-right"
        >
          <span class="pn-label flex items-center gap-1.5 font-sans text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-subtle">
            {t('writing.next')}
            <Icon name="arrow-right" size={12} class="pn-arrow" />
          </span>
          <span class="pn-title font-serif text-[1.0625rem] font-[540] leading-snug tracking-[-0.012em] text-ink-strong text-balance">
            {newer.title}
          </span>
          <time
            datetime={isoDate(newer.date)}
            class="mt-auto pt-1 font-mono text-[0.6875rem] tabular text-subtle"
          >
            {formatDate(newer.date, lang, 'short')}
          </time>
        </a>
      )}
    </nav>
  )
}

<style>
  .pn-card {
    touch-action: manipulation;
    transition:
      border-color var(--dur-1) ease-out,
      background-color var(--dur-1) ease-out,
      transform var(--dur-2) var(--ease-out);
  }

  .pn-card .pn-title,
  .pn-card .pn-label {
    transition: color var(--dur-1) ease-out;
  }

  /* Arrow SVG is rendered by <Icon>; style it globally. */
  :global(.pn-card .pn-arrow) {
    transition:
      color var(--dur-1) ease-out,
      transform var(--dur-2) var(--ease-out);
  }

  .pn-card:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .pn-card:active {
    transform: translateY(1px);
  }

  @media (hover: hover) and (pointer: fine) {
    .pn-card:hover {
      border-color: var(--accent-line);
      background: var(--elevated);
      transform: translateY(-2px);
    }

    .pn-card:hover .pn-title {
      color: var(--accent-strong);
    }

    .pn-card:hover .pn-label {
      color: var(--muted);
    }

    :global(.pn-card:hover .pn-arrow) {
      color: var(--accent);
      transform: translateX(-3px);
    }

    :global(.pn-card[rel='next']:hover .pn-arrow) {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pn-card,
    .pn-card .pn-title,
    .pn-card .pn-label,
    :global(.pn-card .pn-arrow) {
      transition:
        color var(--dur-1) ease-out,
        border-color var(--dur-1) ease-out,
        background-color var(--dur-1) ease-out;
    }

    .pn-card:hover {
      transform: none;
    }

    .pn-card:active {
      transform: none;
    }
  }
</style>
