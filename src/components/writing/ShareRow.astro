---
/**
 * ShareRow — quiet sharing: copy the current URL, or subscribe via RSS.
 * Works without JavaScript (the RSS link is a real link); the copy button
 * simply does nothing harmful when the clipboard API is unavailable.
 */
import Icon from '../ui/Icon.astro';
import { localizePath, useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
  /** Absolute or root-relative URL of the article, used as a fallback. */
  url: string;
  class?: string;
}

const { lang, url, class: className = '' } = Astro.props;
const t = useTranslations(lang);
const rssHref = localizePath('/rss.xml', lang);
const controlClass =
  'inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 font-sans text-[0.75rem] text-muted transition-colors duration-200 ease-out hover:bg-hover hover:text-ink';
---
<div class:list={['flex flex-wrap items-center justify-between gap-3', className]}>
  <div class="flex flex-wrap items-center gap-2">
    <button
      type="button"
      class={controlClass}
      data-copy-link
      data-copied-label={t('writing.copied')}
      data-url={url}
    >
      <Icon name="copy" size={13} class="text-subtle" />
      <span data-copy-label>{t('writing.copyLink')}</span>
    </button>

    <a href={rssHref} class={controlClass}>
      <Icon name="rss" size={13} class="text-subtle" />
      <span>{t('home.rss')}</span>
    </a>
  </div>
</div>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-link]');

  for (const button of copyButtons) {
    button.addEventListener('click', async () => {
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      const copiedLabel = button.dataset.copiedLabel ?? 'Copied';
      const target = button.dataset.url || window.location.href;

      try {
        await navigator.clipboard.writeText(new URL(target, window.location.href).href);
      } catch {
        return;
      }

      if (!label || label.dataset.busy === 'true') return;
      const original = label.textContent ?? '';
      label.dataset.busy = 'true';
      label.textContent = copiedLabel;
      window.setTimeout(() => {
        label.textContent = original;
        label.dataset.busy = 'false';
      }, 1800);
    });
  }
</script>
