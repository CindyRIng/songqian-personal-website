---
/**
 * Toc — a quiet table of contents built from the rendered MDX headings.
 * Renders nothing when there are fewer than two top-level sections.
 */
import type { MarkdownHeading } from 'astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  headings: MarkdownHeading[];
  lang: Locale;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);
const items = headings.filter((heading) => heading.depth === 2);
---
{
  items.length >= 2 && (
    <nav aria-label={t('writing.contents')} class="my-9 border-y border-line py-5">
      <p class="eyebrow mb-3">{t('writing.contents')}</p>
      <ol class="flex flex-col gap-1.5">
        {items.map((heading, index) => (
          <li class="flex items-baseline gap-3">
            <span class="w-4 shrink-0 font-sans text-[0.625rem] tabular text-faint">
              {String(index + 1).padStart(2, '0')}
            </span>
            <a
              href={`#${heading.slug}`}
              class="font-sans text-[0.8125rem] leading-snug text-muted transition-colors duration-200 hover:text-ink"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
