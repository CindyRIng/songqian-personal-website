---
/**
 * BaseLayout — the single page shell.
 *
 * CONTRACT (do not change without telling the team):
 *   <BaseLayout lang={lang} title? description? image? type? noindex? path? wide? head?>
 *     ...page sections...
 *     <Fragment slot="scripts">...</Fragment>   (optional page scripts)
 *   </BaseLayout>
 *
 * It owns: <html>/<head> metadata, theme bootstrapping, skip link, floating
 * navigation, main landmark + content column, footer, scroll-reveal observer.
 */
import '../styles/global.css';

import SiteNav from '../components/chrome/SiteNav.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import ReadingEnhancements from '../components/writing/ReadingEnhancements.astro';
import { SITE } from '../i18n/config';
import { defaultLocale, localeMeta, type Locale } from '../i18n/config';
import { getAlternates, useTranslations, localizePath, stripLocale } from '../i18n/utils';
import { profile, lt } from '../data/profile';
import { ClientRouter } from 'astro:transitions';

interface Props {
  lang: Locale;
  /** Page title without the site suffix. Home can omit it to use the full SEO title. */
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Locale-free pathname, e.g. "/about". Defaults to current URL. */
  path?: string;
  /** Wide column for special pages (project grids, galleries). */
  wide?: boolean;
}

const {
  lang = defaultLocale,
  title,
  description,
  image = '/og/default.png',
  type = 'website',
  noindex = false,
  wide = false,
} = Astro.props;

const t = useTranslations(lang);
const meta = localeMeta[lang];

// Pages may pass a locale-free `path`; otherwise derive it from the URL and
// strip any locale prefix so `localizePath()` never doubles it (/de/de/writing).
const rawPath = Astro.props.path ?? Astro.url.pathname;
const { path: localeFreePath } = stripLocale(rawPath);
const currentPath = localeFreePath === '' ? '/' : localeFreePath.replace(/\/$/, '') || '/';
const alternates = getAlternates(currentPath);

const siteUrl = Astro.site ?? new URL(SITE.url);
const canonical = new URL(localizePath(currentPath, lang), siteUrl).href;

const siteName = lt(profile.name, lang) || profile.latinName;
const role = lt(profile.role, lang);

/**
 * Title rules:
 *  - no title        -> "<Name> — <Role>" (localized home title)
 *  - title === name   -> "<Name> — <Role>"
 *  - title has the brand name already -> keep as-is (never duplicate)
 *  - otherwise        -> "<Title> — Song Qian"
 */
const fullTitle = (() => {
  if (!title || title === siteName || title === profile.latinName) {
    return `${siteName} — ${role}`;
  }
  return title.includes(profile.latinName) ? title : `${title} — ${profile.latinName}`;
})();

const desc = description ?? lt(profile.seo.description, lang);
const ogImage = new URL(image, siteUrl).href;

const jsonLdPerson = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteName,
  alternateName: profile.latinName,
  url: siteUrl.href,
  jobTitle: lt(profile.role, lang),
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: lt(profile.location, lang) },
  sameAs: profile.socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};
---

<!doctype html>
<html
  lang={meta.htmlLang}
  dir={meta.dir}
  class="bg-canvas text-ink"
  data-lang={lang}
  data-initial
  transition:animate="none"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <!-- Client-side routing + view transitions (SPA-grade navigation) -->
    <ClientRouter />

    <!-- Theme bootstrap: runs before paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      // ClientRouter: re-apply the persisted theme before the swapped page
      // paints, so client-side navigation never flashes the wrong theme.
      document.addEventListener('astro:after-swap', function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch (e) {}
      });
    </script>

    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f7f2ed"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0e1611"
    />
    <meta name="color-scheme" content="light dark" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={profile.latinName} />

    <!-- Feeds -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'en' ? 'Song Qian — RSS' : `${siteName} — RSS`}
      href={localizePath('/rss.xml', lang)}
    />

    <!-- Language alternates -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={localeMeta[alt.lang].htmlLang} href={new URL(alt.href, siteUrl).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, siteUrl).href} />

    <!-- Social -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.latinName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${lt(profile.tagline, lang)}`} />
    <meta property="og:locale" content={meta.ogLocale} />
    {alternates
      .filter((alt) => alt.lang !== lang)
      .map((alt) => <meta property="og:locale:alternate" content={localeMeta[alt.lang].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${siteName} — ${lt(profile.tagline, lang)}`} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
  </head>

  <body class="grain relative min-h-dvh overflow-x-clip">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded-full focus:bg-ink-strong focus:px-4 focus:py-2 focus:font-sans focus:text-sm focus:text-canvas"
    >
      {t('a11y.skip')}
    </a>

    <SiteNav lang={lang} />

    <main
      id="main"
      tabindex="-1"
      transition:name="page-main"
      class:list={[
        'relative z-10 mx-auto w-full px-6 pb-16 pt-24 sm:px-8 sm:pb-24 sm:pt-32',
        wide ? 'max-w-3xl' : 'max-w-[calc(var(--content)+3rem)]',
      ]}
    >
      <slot />
    </main>

    <SiteFooter lang={lang} />

    {type === 'article' && <ReadingEnhancements lang={lang} />}

    <script>
      /* ------------------------------------------------------------------
       * All client behaviour is page-aware: with <ClientRouter />, bundled
       * module scripts execute only once, so every per-page effect is
       * (re)initialised on `astro:page-load`. A one-time `load` fallback keeps
       * the site working even if the router itself fails to boot.
       * ------------------------------------------------------------------ */

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* --- Scroll reveal --------------------------------------------------- */
      let revealObserver: IntersectionObserver | null = null;

      function initReveal() {
        revealObserver?.disconnect();
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (reducedMotion || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-revealed'));
          return;
        }
        revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              (entry.target as HTMLElement).style.willChange = 'auto';
              revealObserver?.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => revealObserver!.observe(el));
      }

      /* --- Reading progress ------------------------------------------------ */
      let progressEl: HTMLElement | null = null;

      function updateProgress() {
        if (!progressEl) return;
        const scrollable = document.documentElement.scrollHeight - innerHeight;
        const ratio = scrollable > 0 ? Math.min(1, Math.max(0, scrollY / scrollable)) : 0;
        progressEl.style.setProperty('--progress', String(ratio));
      }

      function initProgress() {
        progressEl = document.getElementById('reading-progress');
        updateProgress();
      }

      addEventListener('scroll', updateProgress, { passive: true });
      addEventListener('resize', updateProgress, { passive: true });

      /* --- Theme toggle with radial reveal from the click point -------------- */
      function applyTheme(next: 'light' | 'dark') {
        const root = document.documentElement;
        root.classList.toggle('dark', next === 'dark');
        root.dataset.theme = next;
        document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
          toggle.setAttribute('aria-pressed', String(next === 'dark'));
        });
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      }

      function syncThemeToggles() {
        const isDark = document.documentElement.classList.contains('dark');
        document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
          toggle.setAttribute('aria-pressed', String(isDark));
        });
      }

      document.addEventListener('click', (event) => {
        const trigger = (event.target as Element | null)?.closest('[data-theme-toggle]');
        if (!trigger) return;
        const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void> } };

        if (!doc.startViewTransition || prefersReduced) {
          applyTheme(next);
          return;
        }

        const rect = trigger.getBoundingClientRect();
        const x = rect.left + rect.width / 2;
        const y = rect.top + rect.height / 2;
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

        document.documentElement.classList.add('theme-transition');
        const transition = doc.startViewTransition(() => applyTheme(next));
        transition.ready.then(() => {
          document.documentElement.animate(
            {
              clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`],
            },
            {
              duration: 600,
              easing: 'cubic-bezier(0.22, 0.68, 0.24, 1)',
              pseudoElement: '::view-transition-new(root)',
            }
          );
        });
        transition.ready.finally?.(() => {
          window.setTimeout(() => document.documentElement.classList.remove('theme-transition'), 680);
        });
      });

      /* --- Intent prefetch -------------------------------------------------
       * The router fetches the next document when a link is clicked; warming the
       * cache on hover / focus / touch means that fetch is usually already done
       * by the time the view transition starts, which is what makes client-side
       * navigation feel instant rather than merely animated.
       * -------------------------------------------------------------------- */
      const prefetched = new Set<string>();

      function prefetchLink(anchor: HTMLAnchorElement) {
        if (anchor.hasAttribute('data-astro-reload') || anchor.hasAttribute('download')) return;
        if (anchor.target && anchor.target !== '_self') return;

        let url: URL;
        try {
          url = new URL(anchor.href, location.href);
        } catch {
          return;
        }
        if (url.origin !== location.origin) return;
        if (url.pathname === location.pathname && url.search === location.search) return;
        // Never prefetch files (feeds, images, downloads) — only page documents.
        if (/\.[a-z0-9]+$/i.test(url.pathname)) return;

        const key = url.pathname + url.search;
        if (prefetched.has(key)) return;
        prefetched.add(key);

        try {
          void fetch(url.href, {
            credentials: 'same-origin',
            priority: 'low' as RequestPriority,
            headers: { 'X-Prefetch': '1' },
          }).catch(() => {});
        } catch {
          /* prefetch is an optimisation — never let it break navigation */
        }
      }

      const anchorFromEvent = (event: Event): HTMLAnchorElement | null => {
        const target = event.target as Element | null;
        const anchor = target?.closest?.('a[href]');
        return anchor instanceof HTMLAnchorElement ? anchor : null;
      };

      document.addEventListener('pointerover', (event) => {
        const anchor = anchorFromEvent(event);
        if (anchor) prefetchLink(anchor);
      }, { passive: true });

      document.addEventListener('focusin', (event) => {
        const anchor = anchorFromEvent(event);
        if (anchor) prefetchLink(anchor);
      }, { passive: true });

      document.addEventListener('touchstart', (event) => {
        const anchor = anchorFromEvent(event);
        if (anchor) prefetchLink(anchor);
      }, { passive: true });

      /* --- Boot / re-boot on every client-side navigation -------------------
       * Guard on the <body> node rather than the pathname: a navigation to the
       * same URL (e.g. re-selecting the current language) still swaps the body,
       * so its scripts must be re-initialised. A stable body means the initial
       * load double-event (page-load + load) is only booted once.
       * -------------------------------------------------------------------- */
      let lastBootedBody: HTMLElement | null = null;

      function bootPage() {
        if (document.body === lastBootedBody) return;
        lastBootedBody = document.body;

        initReveal();
        initProgress();
        syncThemeToggles();
        document.documentElement.classList.add('js');

        // Warm the nav destinations while the reader is still reading.
        const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
        if (!connection?.saveData) {
          const idle = window.requestIdleCallback ?? ((cb: IdleRequestCallback) => window.setTimeout(() => cb({ didTimeout: false, timeRemaining: () => 0 } as IdleDeadline), 1200));
          idle(() => {
            document
              .querySelectorAll<HTMLAnchorElement>('nav a[href]:not([hreflang])')
              .forEach((anchor) => prefetchLink(anchor));
          });
        }

        const root = document.documentElement;
        if (root.hasAttribute('data-initial')) {
          // The initial-load entrance is a one-shot: remove the flag once the
          // chrome has settled so navigations use the view transition only.
          window.setTimeout(() => root.removeAttribute('data-initial'), 520);
        }
      }

      document.addEventListener('astro:page-load', bootPage);
      // Fallback: if the router never boots, the first load still works.
      window.addEventListener('load', bootPage);
    </script>

    <slot name="scripts" />
  </body>
</html>
