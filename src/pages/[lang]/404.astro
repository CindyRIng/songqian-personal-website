---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFoundView from '../../components/NotFoundView.astro';
import { secondaryLocales, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return secondaryLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title="404" description={t('notFound.text')} noindex path="/404" wide>
  <NotFoundView lang={lang} />
</BaseLayout>
