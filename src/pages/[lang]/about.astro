---
import AboutView from '../../views/AboutView.astro';
import { defaultLocale, isLocale, secondaryLocales, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return secondaryLocales.map((lang) => ({ params: { lang } }));
}

const { lang: rawLang } = Astro.params;
const lang = (isLocale(rawLang) ? rawLang : defaultLocale) as Locale;
---

<AboutView lang={lang} />
