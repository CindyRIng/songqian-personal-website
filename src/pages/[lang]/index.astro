---
/**
 * English home page — the only secondary locale: /en/
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeView from '../../views/HomeView.astro';
import { secondaryLocales, type Locale } from '../../i18n/config';
import { copy, c } from '../../data/copy';

export function getStaticPaths() {
  return secondaryLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<BaseLayout
  lang={lang}
  path="/"
  wide={true}
  description={c(copy.meta.homeDescription, lang)}
>
  <HomeView lang={lang} />
</BaseLayout>
