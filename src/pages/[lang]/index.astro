---
/**
 * Localized home pages: /zh, /ja, /es, /fr, /de.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeView from '../../views/HomeView.astro';
import { secondaryLocales, type Locale } from '../../i18n/config';
import { profile, lt } from '../../data/profile';

export function getStaticPaths() {
  return secondaryLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<BaseLayout
  lang={lang}
  path="/"
  title={lt(profile.name, lang) || profile.latinName}
  description={lt(profile.tagline, lang)}
>
  <HomeView lang={lang} />
</BaseLayout>
