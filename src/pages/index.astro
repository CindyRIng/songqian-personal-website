---
/**
 * Chinese home page (root URL, default locale).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeView from '../views/HomeView.astro';
import { defaultLocale } from '../i18n/config';
import { copy, c } from '../data/copy';
---

<BaseLayout
  lang={defaultLocale}
  path="/"
  wide={true}
  description={c(copy.meta.homeDescription, defaultLocale)}
>
  <HomeView lang={defaultLocale} />
</BaseLayout>
