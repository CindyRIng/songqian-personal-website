---
/**
 * AboutView — /about and /[lang]/about.
 *
 * Fully data-driven: every persona fact comes from src/data/profile.ts and
 * src/data/timeline.ts, and every UI label from src/i18n/ui.ts. Nothing about
 * the owner is hardcoded here — edit the data files, not this view.
 *
 * Layout: greeting → generated portrait plate → bio (drop cap) → CV ledger →
 * elsewhere → colophon + the six-language row.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PortraitCard from '../components/about/PortraitCard.astro';
import Icon from '../components/ui/Icon.astro';
import { profile, lt } from '../data/profile';
import { timeline } from '../data/timeline';
import { locales, localeMeta, type Locale } from '../i18n/config';
import { getAlternates, useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const name = lt(profile.name, lang);
const role = lt(profile.role, lang);
const tagline = lt(profile.tagline, lang);
const location = lt(profile.location, lang);
const bio = profile.aboutBio.map((paragraph) => lt(paragraph, lang));
const present = t('common.present');
const isCjk = lang === 'zh' || lang === 'ja';

/** Build year of this site — keeps the portrait caption data-driven. */
const siteYear = profile.siteLaunch.slice(0, 4);
const portraitCaption = `${location} · ${siteYear}`;

/**
 * Short CV ledger, derived from the canonical, fully localized timeline data:
 * one row per organisation (the longest span wins), current roles first, then
 * past roles, with education at the end. The full stories live on /timeline.
 */
const yearsOf = (start: string, end: string | null): string => {
  const startYear = start.slice(0, 4);
  if (!end) return `${startYear} — ${present}`;
  const endYear = end.slice(0, 4);
  return endYear === startYear ? startYear : `${startYear} — ${endYear}`;
};

const spanLength = (start: string, end: string | null): number => {
  const startValue = Number(start.slice(0, 4)) * 12 + Number(start.slice(5, 7));
  const endValue = end ? Number(end.slice(0, 4)) * 12 + Number(end.slice(5, 7)) : 999912;
  return endValue - startValue;
};

/**
 * Prefer explicitly curated CV rows (`cv: true` in timeline.ts). Fall back to
 * work + education + leadership entries so the page never renders empty.
 */
const curatedCv = timeline.filter((entry) => entry.cv === true);
const cvSource =
  curatedCv.length > 0
    ? curatedCv
    : timeline.filter(
        (entry) =>
          entry.type === 'work' ||
          entry.type === 'education' ||
          (entry.tags ?? []).includes('Leadership')
      );

/** One row per organisation — longest span represents that organisation. */
const cvByOrg = new Map<string, (typeof cvSource)[number]>();
for (const entry of cvSource) {
  const key = entry.org.en;
  const existing = cvByOrg.get(key);
  if (!existing || spanLength(entry.start, entry.end) > spanLength(existing.start, existing.end)) {
    cvByOrg.set(key, entry);
  }
}
const cvRows = [...cvByOrg.values()]
  .map((entry) => ({
    id: entry.id,
    kind: entry.type,
    start: entry.start,
    end: entry.end,
    org: lt(entry.org, lang),
    role: lt(entry.role, lang),
    years: yearsOf(entry.start, entry.end),
  }))
  .sort((a, b) => {
    // Current roles first (earliest start = primary role), then past roles and
    // leadership by most recent end, with education last.
    const aCurrent = a.end === null ? 0 : 1;
    const bCurrent = b.end === null ? 0 : 1;
    if (aCurrent !== bCurrent) return aCurrent - bCurrent;
    if (aCurrent === 0 && bCurrent === 0) return a.start.localeCompare(b.start);
    const aEducation = a.kind === 'education' ? 1 : 0;
    const bEducation = b.kind === 'education' ? 1 : 0;
    if (aEducation !== bEducation) return aEducation - bEducation;
    return (b.end ?? '').localeCompare(a.end ?? '');
  });

const colophon = profile.colophon.map((paragraph) => lt(paragraph, lang));
const alternates = getAlternates('/about');
---

<BaseLayout lang={lang} title={t('about.title')} description={tagline} path="/about">
  <!-- Intro ---------------------------------------------------------------- -->
  <header class="flex max-w-[34rem] flex-col gap-4">
    <p class="eyebrow">{t('about.hello')}</p>
    <h1 class="text-balance font-serif text-[2.25rem] font-[550] leading-[1.06] tracking-[-0.03em] text-ink-strong sm:text-[2.75rem]">
      {t('about.title')}
    </h1>
    <p class="max-w-[46ch] text-pretty text-[1.0625rem] leading-[1.65] text-muted">
      {role}
    </p>
    <p class="max-w-[46ch] text-pretty text-[0.9375rem] leading-[1.6] text-subtle">{tagline}</p>
  </header>

  <!-- Portrait ------------------------------------------------------------- -->
  <div class="mt-10" data-reveal>
    <PortraitCard
      name={name}
      monogram={profile.monogram}
      caption={portraitCaption}
      class="shadow-md"
    />
  </div>

  <!-- Bio + drop cap -------------------------------------------------------- -->
  <div
    class:list={['prose about-bio mt-12', isCjk && 'is-cjk']}
    data-reveal
    style="--reveal-delay: 60ms"
  >
    {bio.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <!-- CV ledger ------------------------------------------------------------- -->
  <section class="mt-16 border-t border-line pt-8" aria-labelledby="about-experience" data-reveal>
    <div class="mb-6 flex items-baseline gap-3">
      <span class="font-mono text-[0.6875rem] tabular text-faint">01</span>
      <h2 id="about-experience" class="font-sans text-[0.8125rem] font-[560] tracking-[0.01em] text-ink-strong">
        {t('about.experience')}
      </h2>
      <span class="h-px flex-1 translate-y-[-0.15em] bg-line"></span>
    </div>

    <ul class="divide-y divide-line">
      {
        cvRows.map((row) => (
          <li class="group flex items-baseline justify-between gap-6 rounded-md px-2 py-3.5 transition-colors duration-200 hover:bg-hover">
            <div class="min-w-0">
              <p class="font-serif text-[1rem] font-[550] leading-snug tracking-[-0.01em] text-ink-strong">
                {row.org}
              </p>
              <p class="mt-0.5 text-pretty text-[0.875rem] leading-snug text-muted">{row.role}</p>
            </div>
            <span class="shrink-0 font-sans text-[0.75rem] tabular tracking-[0.01em] text-subtle">
              {row.years}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Elsewhere ------------------------------------------------------------- -->
  <section class="mt-16 border-t border-line pt-8" aria-labelledby="about-elsewhere" data-reveal>
    <div class="mb-4 flex items-baseline gap-3">
      <span class="font-mono text-[0.6875rem] tabular text-faint">02</span>
      <h2 id="about-elsewhere" class="font-sans text-[0.8125rem] font-[560] tracking-[0.01em] text-ink-strong">
        {t('about.elsewhere')}
      </h2>
      <span class="h-px flex-1 translate-y-[-0.15em] bg-line"></span>
    </div>

    <ul class="divide-y divide-line">
      {
        profile.elsewhere.map((link) => (
          <li>
            <a
              href={link.href}
              class="group flex items-center justify-between gap-4 rounded-md px-2 py-3 transition-colors duration-200 hover:bg-hover"
              rel="me"
              target="_blank"
            >
              <span class="font-serif text-[1rem] font-[550] tracking-[-0.01em] text-ink-strong transition-colors duration-200 group-hover:text-accent">
                {link.label}
              </span>
              <Icon
                name="arrow-up-right"
                size={15}
                class="text-subtle transition duration-200 ease-[var(--ease-out)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Colophon -------------------------------------------------------------- -->
  <section class="mt-16 border-t border-line pt-8" aria-labelledby="about-colophon" data-reveal>
    <div class="mb-5 flex items-baseline gap-3">
      <span class="font-mono text-[0.6875rem] tabular text-faint">03</span>
      <h2 id="about-colophon" class="font-sans text-[0.8125rem] font-[560] tracking-[0.01em] text-ink-strong">
        {t('about.site')}
      </h2>
      <span class="h-px flex-1 translate-y-[-0.15em] bg-line"></span>
    </div>

    <div class="prose text-[0.9375rem] leading-[1.72]">
      {colophon.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <!-- Languages: generated from the locale registry, never hardcoded. -->
    <div class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-line pt-4">
      <span class="eyebrow mr-2">{t('lang.switch')}</span>
      {
        alternates.map((alternate) => (
          <span class="inline-flex items-baseline gap-2">
            {alternate.lang !== locales[0] && <span class="text-faint" aria-hidden="true">·</span>}
            <a
              href={alternate.href}
              class:list={[
                'font-sans text-[0.8125rem] leading-relaxed transition-colors duration-150 hover:text-accent',
                alternate.lang === lang
                  ? 'text-ink-strong underline decoration-line-strong underline-offset-[3px]'
                  : 'text-muted',
              ]}
              hreflang={localeMeta[alternate.lang].htmlLang}
              aria-current={alternate.lang === lang ? 'page' : undefined}
            >
              {localeMeta[alternate.lang].nativeLabel}
            </a>
          </span>
        ))
      }
    </div>
  </section>

  <!-- Signature -------------------------------------------------------------- -->
  <p class="mt-16 text-pretty font-serif text-[0.9375rem] italic leading-relaxed text-subtle" data-reveal>
    — {name}, {location}
  </p>
</BaseLayout>

<style>
  /* Drop cap — the small editorial flourish at the top of the bio. */
  .about-bio > p:first-child::first-letter {
    float: left;
    font-family: var(--font-serif);
    font-size: 3.45em;
    line-height: 0.78;
    font-weight: 520;
    padding-right: 0.11em;
    padding-top: 0.055em;
    color: var(--accent);
  }

  .about-bio.is-cjk > p:first-child::first-letter {
    font-size: 2.6em;
    line-height: 0.95;
    padding-top: 0.1em;
    font-weight: 560;
  }
</style>
