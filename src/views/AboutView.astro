---
/**
 * AboutView — `/about` (zh) and `/en/about` (en).
 *
 * V4: a letter, not a landing page. Written first-person from real records
 * (`src/data/about.ts`, `timeline.ts`, `/now`). Single-language headings, a
 * date stamp, thin rules — no numbered section labels, no bilingual italic
 * subtitles. English is condensed: one summary paragraph, the ledger, the CV
 * and the FAQ.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, localeMeta } from '../i18n/config';
import PortraitPlate from '../components/about/PortraitPlate.astro';
import { profile, lt } from '../data/profile';
import { timeline } from '../data/timeline';
import { about } from '../data/about';
import { copy, c } from '../data/copy';
import type { Locale } from '../i18n/config';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const name = lt(profile.name, lang);
const role = lt(profile.role, lang);
const location = lt(profile.location, lang);
const present = t('common.present');
const updated = about.updated.replaceAll('-', '.');
const isZh = lang === 'zh';

/** Short CV ledger from timeline entries marked `cv: true`. */
const cvRows = timeline
  .filter((entry) => entry.cv === true)
  .map((entry) => {
    const startYear = entry.start.slice(0, 4);
    const endYear = entry.end ? entry.end.slice(0, 4) : present;
    return {
      id: entry.id,
      period: !entry.end
        ? `${startYear} — ${present}`
        : endYear === startYear
          ? startYear
          : `${startYear} — ${endYear}`,
      org: lt(entry.org, lang),
      role: lt(entry.role, lang),
    };
  })
  .sort((a, b) => b.period.localeCompare(a.period));

/** FAQ (kept quiet; also emitted as FAQPage structured data). */
const emailAddress = profile.contact.email;
const faq = copy.faq.items.map((item) => {
  const answer = c(item.a, lang);
  const [before, ...rest] = answer.split(emailAddress);
  return {
    q: c(item.q, lang),
    a: answer,
    before: before ?? answer,
    after: rest.join(''),
    hasEmail: rest.length > 0,
  };
});

const siteUrl = Astro.site ?? new URL(SITE.url);
const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      name: c(copy.about.title, lang),
      description: c(copy.meta.aboutDescription, lang),
      url: new URL(localizePath('/about', lang), siteUrl).href,
      inLanguage: localeMeta[lang].htmlLang,
      mainEntity: { '@id': `${siteUrl.href}#person` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={c(copy.about.title, lang)}
  description={c(copy.meta.aboutDescription, lang)}
  path="/about"
  wide
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutJsonLd)} />
  </Fragment>

  <article class="wrap">
    <!-- Header ------------------------------------------------------------ -->
    <header class="max-w-[46rem] border-t border-line pt-5" data-reveal>
      <p class="mono flex items-center gap-3 text-[0.6875rem] uppercase tracking-[0.14em] text-subtle">
        <span>{isZh ? '关于' : 'About'}</span>
        <span class="h-px w-8 bg-[var(--line-strong)]" aria-hidden="true"></span>
        <time datetime={about.updated}>{updated}</time>
      </p>
      <h1 class="mt-6 font-serif text-[clamp(2.5rem,5vw,3.75rem)] font-[540] leading-[1.05] tracking-[-0.03em] text-ink-strong">
        {isZh ? '关于' : 'About'}
      </h1>
      <p class="mt-6 max-w-[44rem] text-pretty text-[1.0625rem] leading-[1.8] text-ink">{lt(about.intro, lang)}</p>
      <p class="mono mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.6875rem] uppercase tracking-[0.12em] text-subtle">
        <span>{role}</span>
        <span class="size-0.5 rounded-full bg-[var(--faint)]" aria-hidden="true"></span>
        <span>{location}</span>
      </p>
    </header>

    <!-- Portrait + short links ------------------------------------------- -->
    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-[minmax(0,18rem)_1fr] md:gap-12">
      <div data-reveal>
        <PortraitPlate name={name} monogram={profile.monogram} alt={t('about.portraitAlt')} />
      </div>
      <div class="flex flex-col justify-end gap-5 pb-1" data-reveal style="--reveal-delay: 60ms">
        <p class="max-w-[40ch] font-serif text-[1.3125rem] leading-[1.6] text-ink-strong">
          {isZh
            ? '白天卖外贸软件，晚上把重复的部分写成工具。写这个站，是想把记录整理成能给别人看的东西。'
            : 'Selling foreign-trade software by day, writing tools for the repetitive parts by night. This site is an attempt to make my records readable by someone else.'}
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="/now/" class="focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted hover:text-ink">
            {isZh ? '现在' : 'Now'}<span aria-hidden="true">→</span>
          </a>
          <a href="/reading/" class="focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted hover:text-ink">
            {isZh ? '书桌' : 'Reading'}<span aria-hidden="true">→</span>
          </a>
          <a href={localizePath('/timeline', lang)} class="focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted hover:text-ink">
            {isZh ? '时间线' : 'Timeline'}<span aria-hidden="true">→</span>
          </a>
          {isZh && (
            <a href="/consulting/" class="focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted hover:text-ink">
              咨询<span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Letter body ------------------------------------------------------- -->
    {
      isZh ? (
        <>
          {/* Three threads */}
          <section class="mt-14 max-w-[46rem]" aria-labelledby="about-threads">
            <h2 id="about-threads" class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle">
              {lt(about.threads.label, lang)}
            </h2>
            <div class="mt-6 flex flex-col gap-7">
              {about.threads.items.map((thread) => (
                <div data-reveal>
                  <h3 class="font-serif text-[1.1875rem] font-[540] leading-snug tracking-[-0.015em] text-ink-strong">
                    {lt(thread.label, lang)}
                  </h3>
                  <p class="mt-2 max-w-[60ch] text-pretty text-[1rem] leading-[1.8] text-muted">{lt(thread.body, lang)}</p>
                </div>
              ))}
            </div>
          </section>

          {/* A normal week */}
          <section class="mt-14 max-w-[46rem]" aria-labelledby="about-daily">
            <h2 id="about-daily" class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle">
              {lt(about.daily.label, lang)}
            </h2>
            <p class="mt-4 max-w-[58ch] text-[1rem] leading-[1.8] text-muted">{lt(about.daily.intro, lang)}</p>
            <dl class="mt-6">
              {about.daily.items.map((item) => (
                <div class="grid grid-cols-[4rem_1fr] gap-4 border-t border-line py-3 md:grid-cols-[5rem_1fr] md:gap-6" data-reveal>
                  <dt class="mono pt-0.5 text-[0.6875rem] tracking-[0.06em] text-subtle">{item.time}</dt>
                  <dd class="max-w-[58ch] text-pretty text-[0.9375rem] leading-[1.7] text-muted">{lt(item.text, lang)}</dd>
                </div>
              ))}
            </dl>
          </section>

          {/* Principles */}
          <section class="mt-14 max-w-[46rem]" aria-labelledby="about-principles">
            <h2 id="about-principles" class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle">
              {lt(about.principles.label, lang)}
            </h2>
            <p class="mt-4 max-w-[58ch] text-[1rem] leading-[1.8] text-muted">{lt(about.principles.intro, lang)}</p>
            <ul class="mt-6">
              {about.principles.items.map((item) => (
                <li class="grid grid-cols-[3.25rem_1fr] gap-3 border-t border-line py-4 md:grid-cols-[4rem_1fr] md:gap-5" data-reveal>
                  <span class="mono pt-1 text-[0.6875rem] tracking-[0.06em] text-subtle">{item.code}</span>
                  <div>
                    <h3 class="font-serif text-[1.0625rem] font-[540] leading-snug text-ink-strong">{lt(item.title, lang)}</h3>
                    <p class="mt-1 max-w-[58ch] text-pretty text-[0.9375rem] leading-[1.75] text-muted">{lt(item.line, lang)}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>

          {/* Failures */}
          <section class="mt-14 max-w-[46rem]" aria-labelledby="about-failures">
            <h2 id="about-failures" class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle">
              {lt(about.failures.label, lang)}
            </h2>
            <p class="mt-4 max-w-[58ch] text-[1rem] leading-[1.8] text-muted">{lt(about.failures.intro, lang)}</p>
            <ul class="mt-6">
              {about.failures.items.map((item) => (
                <li class="border-t border-line py-4" data-reveal>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 class="font-serif text-[1.0625rem] font-[540] leading-snug text-ink-strong">{lt(item.title, lang)}</h3>
                    <span class="mono text-[0.6875rem] tracking-[0.06em] text-subtle">{item.period}</span>
                  </div>
                  <p class="mt-1.5 max-w-[58ch] text-pretty text-[0.9375rem] leading-[1.75] text-muted">{lt(item.line, lang)}</p>
                </li>
              ))}
            </ul>
          </section>

          {/* Ledger */}
          <section class="mt-14 max-w-[46rem]" aria-labelledby="about-ledger">
            <h2 id="about-ledger" class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle">
              {lt(about.ledger.label, lang)}
            </h2>
            <p class="mt-4 max-w-[58ch] text-[1rem] leading-[1.8] text-muted">{lt(about.ledger.intro, lang)}</p>
            <dl class="mt-6 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-line pt-6 sm:grid-cols-4">
              {about.ledger.items.map((item) => (
                <div class="flex flex-col-reverse" data-reveal>
                  <dt class="mt-2 font-sans text-[0.75rem] uppercase tracking-[0.1em] text-subtle">{lt(item.label, lang)}</dt>
                  <dd class="ledger-value mono text-[clamp(2rem,3.4vw,2.75rem)] font-[380] leading-none tracking-[-0.02em] text-ink-strong">{item.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        </>
      ) : (
        <>
          {/* English: one condensed summary + the ledger */}
          <section class="mt-14 max-w-[46rem]" aria-labelledby="about-summary">
            <h2 id="about-summary" class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle">
              In short
            </h2>
            <p class="mt-5 max-w-[60ch] text-pretty text-[1rem] leading-[1.85] text-ink">{about.english}</p>
            <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-line pt-6 sm:grid-cols-4">
              {about.ledger.items.map((item) => (
                <div class="flex flex-col-reverse">
                  <dt class="mt-2 font-sans text-[0.75rem] uppercase tracking-[0.1em] text-subtle">{lt(item.label, lang)}</dt>
                  <dd class="ledger-value mono text-[clamp(2rem,3.4vw,2.75rem)] font-[380] leading-none tracking-[-0.02em] text-ink-strong">{item.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        </>
      )
    }

    <!-- CV (simplified) --------------------------------------------------- -->
    <section class="mt-14 max-w-[46rem]" aria-labelledby="about-cv">
      <h2 id="about-cv" class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle">
        {isZh ? '履历' : 'Experience'}
      </h2>
      <ol class="mt-2">
        {
          cvRows.map((row) => (
            <li class="grid grid-cols-[7rem_1fr] gap-4 border-b border-line py-3 md:grid-cols-[9rem_1fr] md:gap-6" data-reveal>
              <span class="mono pt-0.5 text-[0.6875rem] text-subtle">{row.period}</span>
              <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-serif text-[1rem] font-[540] leading-snug text-ink-strong">{row.org}</span>
                <span class="text-[0.875rem] text-muted">{row.role}</span>
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- FAQ --------------------------------------------------------------- -->
    <section class="mt-14 max-w-[46rem]" aria-labelledby="about-faq">
      <h2 id="about-faq" class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle">
        {c(copy.faq.title, lang)}
      </h2>
      <div class="mt-2">
        {
          faq.map((item) => (
            <details class="faq-item" data-faq-item data-reveal>
              <summary class="faq-summary focus-ring">
                <span class="faq-q">{item.q}</span>
                <span aria-hidden="true" class="faq-plus">+</span>
              </summary>
              <div class="faq-body">
                <div class="faq-body-inner">
                  <p class="faq-a">
                    {item.hasEmail ? (
                      <>
                        {item.before}
                        <a class="faq-mail" href={`mailto:${emailAddress}`}>{emailAddress}</a>
                        {item.after}
                      </>
                    ) : (
                      item.a
                    )}
                  </p>
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <!-- Signature --------------------------------------------------------- -->
    <p class="mt-14 max-w-[46rem] border-t border-line pt-8 font-serif text-[0.9375rem] italic leading-relaxed text-subtle" data-reveal>
      — {lt(about.signature, lang)}
    </p>
  </article>

  <Fragment slot="scripts">
    <script>
      // FAQ: animate both opening and closing with the CSS grid-rows trick.
      // Without JS (no `html.js` class) <details> keeps its native behaviour.
      function initFaq() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        document.querySelectorAll<HTMLElement>('[data-faq-item]').forEach((item) => {
          if (item.dataset.bound === 'true') return;
          item.dataset.bound = 'true';

          const details = item as HTMLDetailsElement;
          const summary = details.querySelector('summary');
          const body = details.querySelector<HTMLElement>('.faq-body');
          if (!summary || !body) return;

          const setOpen = (open: boolean) => {
            details.classList.toggle('is-open', open);
            if (open) details.open = true;
          };

          setOpen(details.open);

          summary.addEventListener('click', (event) => {
            event.preventDefault();
            const opening = !details.classList.contains('is-open');

            if (reduceMotion.matches) {
              details.open = opening;
              details.classList.toggle('is-open', opening);
              return;
            }

            if (opening) {
              setOpen(true);
              return;
            }

            details.classList.remove('is-open');
            const finish = () => {
              if (!details.classList.contains('is-open')) details.open = false;
            };
            body.addEventListener(
              'transitionend',
              (transitionEvent) => {
                if (transitionEvent.propertyName === 'grid-template-rows') finish();
              },
              { once: true }
            );
            window.setTimeout(finish, 280);
          });
        });
      }

      document.addEventListener('astro:page-load', initFaq);
      initFaq();
    </script>
  </Fragment>
</BaseLayout>

<style>
  .ledger-value {
    margin-inline-start: 0;
  }

  /* FAQ — native <details>, grid-rows animation, plus → ×, focus ring. */
  .faq-item {
    border-top: 1px solid var(--line);
  }

  .faq-item:first-child {
    border-top: 0;
  }

  .faq-summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.75rem;
    padding-block: 0.9rem;
    cursor: pointer;
    list-style: none;
    border-radius: 4px;
    touch-action: manipulation;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 540;
    line-height: 1.4;
    color: var(--ink-strong);
    text-wrap: pretty;
    transition: color var(--dur-1) var(--ease-out);
  }

  .faq-plus {
    margin-top: 0.15rem;
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1;
    color: var(--subtle);
    transition:
      transform 220ms var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .faq-item.is-open .faq-plus {
    transform: rotate(45deg);
    color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-item:hover .faq-q,
    .faq-item:hover .faq-plus {
      color: var(--accent-strong);
    }
  }

  /* Only collapse with JS present, so a no-JS <details> still shows answers. */
  :global(html.js) .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 220ms var(--ease-out);
  }

  :global(html.js) .faq-item.is-open .faq-body {
    grid-template-rows: 1fr;
  }

  .faq-body-inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq-a {
    margin: 0;
    padding-bottom: 1rem;
    max-width: 56ch;
    text-wrap: pretty;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .faq-mail {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    border-radius: 2px;
    transition:
      color var(--dur-1) ease-out,
      text-decoration-color var(--dur-1) ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-mail:hover {
      color: var(--accent-strong);
      text-decoration-color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .faq-body {
      transition: none;
    }

    .faq-q,
    .faq-plus {
      transition: none;
    }
  }
</style>
