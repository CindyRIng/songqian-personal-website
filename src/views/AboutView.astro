---
/**
 * AboutView — `/about` (zh) and `/en/about` (en).
 *
 * A+ direction: an oversized bilingual title, then the three threads
 * (sales / code / writing) straight from profile.aboutBio, a portrait slot
 * (real photo if public/images/portrait.* exists, monogram plate otherwise),
 * the short CV from timeline entries flagged `cv: true`, Now, optional
 * life/notes photo slots, tools & method (from profile.colophon), contact.
 */
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, localeMeta } from '../i18n/config';
import PortraitPlate from '../components/about/PortraitPlate.astro';
import Icon from '../components/ui/Icon.astro';
import { profile, lt } from '../data/profile';
import { timeline } from '../data/timeline';
import { copy, c } from '../data/copy';
import type { Locale } from '../i18n/config';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const name = lt(profile.name, lang);
const role = lt(profile.role, lang);
const location = lt(profile.location, lang);
const present = t('common.present');

/** Three threads: sales → code → writing. Labels are structural UI copy. */
const THREADS = [
  { number: '01', label: { zh: '销售', en: 'Sales' } as const },
  { number: '02', label: { zh: '代码', en: 'Code' } as const },
  { number: '03', label: { zh: '写作', en: 'Writing' } as const },
] as const;

/** Short CV ledger from timeline entries marked `cv: true`. */
const cvRows = timeline
  .filter((entry) => entry.cv === true)
  .map((entry) => {
    const startYear = entry.start.slice(0, 4);
    const endYear = entry.end ? entry.end.slice(0, 4) : present;
    return {
      id: entry.id,
      start: entry.start,
      period: !entry.end
        ? `${startYear} — ${present}`
        : endYear === startYear
          ? startYear
          : `${startYear} — ${endYear}`,
      org: lt(entry.org, lang),
      role: lt(entry.role, lang),
      summary: lt(entry.summary, lang),
    };
  })
  .sort((a, b) => b.start.localeCompare(a.start));

/** Optional media slots (spec §6): show only when the assets exist. */
const imagesDir = join(process.cwd(), 'public', 'images');
const listImages = (prefix: string): string[] => {
  try {
    return readdirSync(imagesDir)
      .filter((file) => file.startsWith(prefix) && /\.(jpe?g|png|webp)$/i.test(file))
      .sort();
  } catch {
    return [];
  }
};
const lifeImages = listImages('life-');
const noteImages = listImages('notes-');
const hasWechatQr = existsSync(join(imagesDir, 'wechat-qr.png'));

const colophon = profile.colophon.map((paragraph) => lt(paragraph, lang));
const quickFacts = copy.home.quickFacts.filter((fact) => ['在读', '网球'].includes(fact.label.zh));

const siteUrl = Astro.site ?? new URL(SITE.url);
const emailAddress = profile.contact.email;
const faq = copy.faq.items.map((item) => {
  const answer = c(item.a, lang);
  const [before, ...rest] = answer.split(emailAddress);
  return {
    q: c(item.q, lang),
    a: answer,
    before: before ?? answer,
    after: rest.join(''),
    hasEmail: rest.length > 0,
  };
});
const aboutJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      name: c(copy.about.title, lang),
      url: new URL(localizePath('/about', lang), siteUrl).href,
      inLanguage: localeMeta[lang].htmlLang,
      mainEntity: { '@id': `${siteUrl.href}#person` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={c(copy.about.title, lang)}
  description={c(copy.meta.aboutDescription, lang)}
  path="/about"
  wide
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutJsonLd)} />
  </Fragment>
  <!-- Hero ---------------------------------------------------------------- -->
  <header class="wrap pt-2 sm:pt-6">
    <p class="label" data-reveal>{c(copy.about.lede, lang)}</p>
    <h1 class="display mt-5 max-w-[14ch]" data-reveal style="--reveal-delay: 40ms">
      {c(copy.about.title, lang)}
      <span class="display-latin ml-4 text-[0.62em] text-muted">{lang === 'zh' ? 'Song Qian' : '关于'}</span>
    </h1>
    <p class="mono mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.75rem] uppercase tracking-[0.1em] text-subtle" data-reveal style="--reveal-delay: 80ms">
      <span>{role}</span>
      <span class="size-0.5 rounded-full bg-[var(--faint)]" aria-hidden="true"></span>
      <span>{location}</span>
    </p>
  </header>

  <!-- Three threads ------------------------------------------------------- -->
  <section class="wrap section" aria-labelledby="about-threads">
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3" data-reveal>
      <h2 id="about-threads" class="label">{c(copy.about.threadsTitle, lang)}</h2>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-3">
      {
        profile.aboutBio.map((paragraph, index) => (
          <article class="flex flex-col gap-3" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <div class="flex items-baseline gap-3">
              <span class="mono text-[0.6875rem] text-[var(--faint)]">
                {THREADS[index]?.number ?? String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="font-serif text-[1.25rem] font-[540] leading-none tracking-[-0.015em] text-ink-strong">
                {lang === 'zh' ? THREADS[index]?.label.zh : THREADS[index]?.label.en}
              </h3>
            </div>
            <p class="max-w-[42ch] text-pretty text-[0.9375rem] leading-[1.75] text-muted">{lt(paragraph, lang)}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Portrait + manifesto ------------------------------------------------ -->
  <section class="wrap" aria-label={`${name} — ${role}`}>
    <div class="grid grid-cols-1 items-end gap-8 md:grid-cols-[minmax(0,20rem)_1fr] md:gap-12">
      <div data-reveal>
        <PortraitPlate
          name={name}
          monogram={profile.monogram}
          alt={t('about.portraitAlt')}
          caption={`${location} · ${profile.siteLaunch.slice(0, 4)}`}
        />
      </div>
      <div class="flex flex-col gap-5 pb-2" data-reveal style="--reveal-delay: 80ms">
        <p class="max-w-[24ch] font-serif text-[clamp(1.75rem,3.2vw,2.5rem)] leading-[1.18] tracking-[-0.02em] text-ink-strong">
          {c(copy.home.plate.quote, lang)}
        </p>
        <p class="mono max-w-[34ch] text-[0.6875rem] uppercase leading-[1.9] tracking-[0.12em] text-subtle">
          {c(copy.home.plate.meta, lang)}
        </p>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          <a
            href={localizePath('/works', lang)}
            class="group inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
          >
            {t('actions.viewWorks')}
            <Icon
              name="arrow-right"
              size={14}
              class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
            />
          </a>
          <a
            href={localizePath('/writing', lang)}
            class="group inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
          >
            {t('actions.readEssays')}
            <Icon
              name="arrow-right"
              size={14}
              class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CV ledger ----------------------------------------------------------- -->
  <section class="wrap section" aria-labelledby="about-experience">
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3" data-reveal>
      <h2 id="about-experience" class="label">{c(copy.about.experienceTitle, lang)}</h2>
    </div>

    <ol class="mt-2">
      {
        cvRows.map((row) => (
          <li class="cv-row grid grid-cols-1 gap-1 border-b border-line py-4 md:grid-cols-[9rem_1fr] md:gap-6" data-reveal>
            <span class="cv-year mono pt-0.5 text-[0.6875rem] text-subtle">{row.period}</span>
            <div class="flex flex-col gap-1">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-serif text-[1.0625rem] font-[540] leading-snug tracking-[-0.01em] text-ink-strong">
                  {row.org}
                </h3>
                <span class="text-[0.875rem] text-muted">{row.role}</span>
              </div>
              <p class="max-w-[62ch] text-pretty text-[0.875rem] leading-[1.65] text-muted">{row.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Now ----------------------------------------------------------------- -->
  <section class="wrap" aria-labelledby="about-now">
    <div
      class="grid grid-cols-1 gap-4 rounded-[6px] border border-line bg-[var(--paper)] p-6 md:grid-cols-[9rem_1fr] md:gap-6 md:p-8"
      data-reveal
    >
      <h2 id="about-now" class="label pt-0.5">{c(copy.about.nowTitle, lang)}</h2>
      <div class="flex flex-col gap-4">
        <p class="max-w-[54ch] text-pretty font-serif text-[1.125rem] leading-[1.7] text-ink">{lt(profile.now, lang)}</p>
        <dl class="flex flex-wrap gap-x-8 gap-y-3">
          {
            quickFacts.map((fact) => (
              <div class="flex flex-col gap-0.5">
                <dt class="label">{lt(fact.label, lang)}</dt>
                <dd class="text-[0.875rem] text-muted">{lt(fact.value, lang)}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Notes & photos (optional assets, spec §6) --------------------------- -->
  {
    (lifeImages.length > 0 || noteImages.length > 0) && (
      <section class="wrap section" aria-labelledby="about-notes">
        <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3" data-reveal>
          <h2 id="about-notes" class="label">{c(copy.about.notesTitle, lang)}</h2>
        </div>
        <p class="mt-3 text-[0.875rem] text-subtle">{c(copy.about.notesHint, lang)}</p>
        <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3">
          {[...lifeImages, ...noteImages].map((file) => (
            <figure class="overflow-hidden rounded-[6px] border border-line bg-[var(--paper)]" data-reveal>
              <img
                src={`/images/${file}`}
                alt={file.replace(/\.(jpe?g|png|webp)$/i, '').replace(/[-_]/g, ' ')}
                width={1200}
                height={900}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
              <figcaption class="mono px-3 py-2 text-[0.625rem] uppercase tracking-[0.12em] text-subtle">
                {file}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- Tools & method ------------------------------------------------------ -->
  <section class="wrap section" aria-labelledby="about-tools">
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3" data-reveal>
      <h2 id="about-tools" class="label">{c(copy.about.toolsTitle, lang)}</h2>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-x-10 gap-y-6 md:grid-cols-3">
      {
        colophon.map((paragraph, index) => (
          <p class="max-w-[44ch] text-pretty text-[0.9375rem] leading-[1.75] text-muted" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
            {paragraph}
          </p>
        ))
      }
    </div>
  </section>

  <!-- FAQ (also emitted as FAQPage structured data) ---------------------- -->
  <section class="wrap section" aria-labelledby="about-faq">
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3" data-reveal>
      <h2 id="about-faq" class="label">{c(copy.faq.title, lang)}</h2>
    </div>
    <div class="mt-2">
      {
        faq.map((item, index) => (
          <details class="faq-item" data-faq-item data-reveal style={`--reveal-delay: ${index * 40}ms`}>
            <summary class="faq-summary focus-ring">
              <span class="faq-q">{item.q}</span>
              <span aria-hidden="true" class="faq-plus">+</span>
            </summary>
            <div class="faq-body">
              <div class="faq-body-inner">
                <p class="faq-a">
                  {item.hasEmail ? (
                    <>
                      {item.before}
                      <a class="faq-mail" href={`mailto:${emailAddress}`}>{emailAddress}</a>
                      {item.after}
                    </>
                  ) : (
                    item.a
                  )}
                </p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Signature — the page ends here; the global footer carries the contact CTA. -->
  <p class="wrap mt-16 border-t border-line pt-8 font-serif text-[0.9375rem] italic leading-relaxed text-subtle" data-reveal>
    — {c(copy.about.signature, lang)}
  </p>
  <Fragment slot="scripts">
    <script>
      // FAQ: animate both opening and closing with the CSS grid-rows trick.
      // Without JS (no `html.js` class) <details> keeps its native behaviour.
      function initFaq() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        document.querySelectorAll<HTMLElement>('[data-faq-item]').forEach((item) => {
          if (item.dataset.bound === 'true') return;
          item.dataset.bound = 'true';

          const details = item as HTMLDetailsElement;
          const summary = details.querySelector('summary');
          const body = details.querySelector<HTMLElement>('.faq-body');
          if (!summary || !body) return;

          const setOpen = (open: boolean) => {
            details.classList.toggle('is-open', open);
            if (open) details.open = true;
          };

          setOpen(details.open);

          summary.addEventListener('click', (event) => {
            event.preventDefault();
            const opening = !details.classList.contains('is-open');

            if (reduceMotion.matches) {
              details.open = opening;
              details.classList.toggle('is-open', opening);
              return;
            }

            if (opening) {
              setOpen(true);
              return;
            }

            details.classList.remove('is-open');
            const finish = () => {
              if (!details.classList.contains('is-open')) details.open = false;
            };
            body.addEventListener(
              'transitionend',
              (transitionEvent) => {
                if (transitionEvent.propertyName === 'grid-template-rows') finish();
              },
              { once: true }
            );
            // Fallback in case the transition never fires.
            window.setTimeout(finish, 280);
          });
        });
      }

      document.addEventListener('astro:page-load', initFaq);
      initFaq();
    </script>
  </Fragment>
</BaseLayout>

<style>
  /* ------------------------------------------------------------------------
     CV ledger — quiet hover wash, year warms to accent, inset hairline ring.
     ---------------------------------------------------------------------- */
  .cv-row {
    position: relative;
    isolation: isolate;
  }

  .cv-row::before {
    content: '';
    position: absolute;
    inset: 0 -0.75rem;
    z-index: -1;
    border-radius: 6px;
    background: var(--hover);
    box-shadow: inset 0 0 0 1px transparent;
    opacity: 0;
    transition: opacity 160ms var(--ease-out);
  }

  .cv-year {
    transition: color var(--dur-1) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .cv-row:hover::before {
      opacity: 1;
      box-shadow: inset 0 0 0 1px var(--line);
    }

    .cv-row:hover .cv-year {
      color: var(--accent);
    }
  }

  /* ------------------------------------------------------------------------
     FAQ — native <details>, animated open/close via grid rows (220ms),
     plus → × rotation, focus ring on the summary, linked e-mail.
     ---------------------------------------------------------------------- */
  .faq-item {
    border-top: 1px solid var(--line);
  }

  .faq-item:first-child {
    border-top: 0;
  }

  .faq-summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.75rem;
    padding-block: 0.9rem;
    cursor: pointer;
    list-style: none;
    border-radius: 4px;
    touch-action: manipulation;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 540;
    line-height: 1.4;
    color: var(--ink-strong);
    text-wrap: pretty;
    transition: color var(--dur-1) var(--ease-out);
  }

  .faq-plus {
    margin-top: 0.15rem;
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1;
    color: var(--subtle);
    transition:
      transform 220ms var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .faq-item.is-open .faq-plus {
    transform: rotate(45deg);
    color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-item:hover .faq-q,
    .faq-item:hover .faq-plus {
      color: var(--accent-strong);
    }
  }

  /* Only collapse with JS present, so a no-JS <details> still shows answers. */
  :global(html.js) .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 220ms var(--ease-out);
  }

  :global(html.js) .faq-item.is-open .faq-body {
    grid-template-rows: 1fr;
  }

  .faq-body-inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq-a {
    margin: 0;
    padding-bottom: 1rem;
    max-width: 56ch;
    text-wrap: pretty;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .faq-mail {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    border-radius: 2px;
    transition:
      color var(--dur-1) ease-out,
      text-decoration-color var(--dur-1) ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-mail:hover {
      color: var(--accent-strong);
      text-decoration-color: var(--accent);
    }
  }

  .faq-mail:active {
    color: var(--accent-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .faq-body {
      transition: none;
    }

    .cv-row::before,
    .cv-year,
    .faq-q,
    .faq-plus {
      transition: none;
    }
  }
</style>
