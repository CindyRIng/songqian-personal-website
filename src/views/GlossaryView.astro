---
/**
 * GlossaryView — `/foreign-trade/glossary/` (Chinese only).
 *
 * A dense, printable cheat sheet for the foreign-trade cluster: 30 terms in
 * four groups, each with a stable #anchor, a plain Chinese definition written
 * for someone actually doing the work, and a link to the relevant long guide
 * where it exists. `DefinedTermSet` + `BreadcrumbList` JSON-LD in the head.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  glossaryGroups,
  glossaryGuides,
  glossaryTerms,
  glossaryUpdated,
  guideForSlug,
} from '../data/glossary';
import { SITE } from '../i18n/config';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const updated = glossaryUpdated;
const updatedLabel = updated.replaceAll('-', '.');
const pageUrl = new URL('/foreign-trade/glossary/', Astro.site ?? new URL(SITE.url)).href;
const title = '外贸术语表：报价、报关与获客常用词';
const description =
  '外贸术语表：按客户与线索、报价与合同、物流与报关、获客与渠道四组，解释 PI、FOB、CIF、MOQ、报关、HS 编码、提单、开发信、电话开发等 30 个常用外贸词。';
const termCount = glossaryTerms.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DefinedTermSet',
      '@id': `${pageUrl}#termset`,
      name: '外贸术语表',
      description,
      url: pageUrl,
      inLanguage: 'zh-CN',
      dateModified: updated,
      hasDefinedTerm: glossaryTerms.map((term) => ({
        '@type': 'DefinedTerm',
        name: term.term,
        alternateName: term.en,
        description: term.definition,
        url: `${pageUrl}#${term.slug}`,
        inDefinedTermSet: { '@id': `${pageUrl}#termset` },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: (Astro.site ?? new URL(SITE.url)).href },
        {
          '@type': 'ListItem',
          position: 2,
          name: '外贸',
          item: new URL('/foreign-trade/', Astro.site ?? new URL(SITE.url)).href,
        },
        { '@type': 'ListItem', position: 3, name: '外贸术语表', item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout lang={lang} title={title} description={description} path="/foreign-trade/glossary" translated={false} wide>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="wrap">
    <!-- Header ------------------------------------------------------------ -->
    <header class="max-w-[46rem] border-t border-line pt-5" data-reveal>
      <nav aria-label="面包屑" class="mono flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.6875rem] uppercase tracking-[0.14em] text-subtle">
        <a href="/foreign-trade/" class="focus-ring hover:text-ink">外贸</a>
        <span aria-hidden="true">/</span>
        <span>术语表</span>
        <span class="h-px w-8 bg-[var(--line-strong)]" aria-hidden="true"></span>
        <time datetime={updated}>{updatedLabel}</time>
      </nav>
      <h1 class="mt-6 font-serif text-[clamp(2.5rem,5vw,3.75rem)] font-[540] leading-[1.05] tracking-[-0.03em] text-ink-strong">
        外贸术语表
      </h1>
      <p class="mt-5 max-w-[40rem] text-pretty text-[1.0625rem] leading-[1.8] text-muted">
        {termCount} 个词，按签单前后和获客渠道分成四组。定义尽量写成能直接用在业务里的话，不搬教科书。每一条都有锚点，可以直接发给同事。
      </p>
      <p class="mono mt-4 text-[0.6875rem] uppercase tracking-[0.14em] text-subtle">
        最后更新 · <time datetime={updated}>{updated}</time>
      </p>
    </header>

    <!-- Group jumps ------------------------------------------------------- -->
    <nav aria-label="术语分组" class="mt-8 flex max-w-[46rem] flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-4">
      {
        glossaryGroups.map((group) => (
          <a
            href={`#${group.id}`}
            class="focus-ring inline-flex min-h-11 items-center gap-1.5 font-sans text-[0.75rem] uppercase tracking-[0.1em] text-subtle hover:text-ink"
          >
            {group.label}
            <span class="mono text-[0.625rem] text-[var(--faint)]">{group.terms.length}</span>
          </a>
        ))
      }
    </nav>

    <!-- Groups ------------------------------------------------------------ -->
    {
      glossaryGroups.map((group, groupIndex) => (
        <section
          id={group.id}
          class="mt-12 max-w-[46rem] scroll-mt-32"
          aria-labelledby={`glossary-${group.id}`}
          data-reveal
          style={`--reveal-delay: ${groupIndex * 40}ms`}
        >
          <h2
            id={`glossary-${group.id}`}
            class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle"
          >
            {group.label}
          </h2>
          <p class="mt-3 text-[0.9375rem] leading-[1.7] text-subtle">{group.intro}</p>

          <dl class="mt-4">
            {group.terms.map((term) => {
              const guide = term.relatedGuide ? guideForSlug(term.relatedGuide) : undefined;
              return (
                <div id={term.slug} class="group scroll-mt-32 border-t border-line py-5">
                  <dt class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="font-serif text-[1.0625rem] font-[540] leading-snug tracking-[-0.01em] text-ink-strong">
                      {term.term}
                    </span>
                    <span class="mono text-[0.6875rem] tracking-[0.04em] text-subtle">{term.en}</span>
                    <a
                      href={`#${term.slug}`}
                      aria-label={`${term.term} 的锚点链接`}
                      class="focus-ring mono text-[0.6875rem] text-[var(--faint)] opacity-0 transition-opacity duration-150 hover:text-accent focus-visible:opacity-100 group-hover:opacity-100"
                    >
                      #
                    </a>
                    {guide && (
                      <a
                        href={guide.url}
                        class="ml-auto inline-flex min-h-6 items-center gap-1 text-[0.75rem] text-muted hover:text-ink"
                      >
                        见「{guide.keyword}」
                        <span aria-hidden="true">→</span>
                      </a>
                    )}
                  </dt>
                  <dd class="mt-2 max-w-[62ch] text-pretty text-[0.9375rem] leading-[1.75] text-muted">
                    {term.definition}
                  </dd>
                </div>
              );
            })}
          </dl>
        </section>
      ))
    }

    <!-- Cross-links: the five long guides -------------------------------- -->
    <section class="mt-14 max-w-[46rem]" aria-labelledby="glossary-guides">
      <h2
        id="glossary-guides"
        class="border-t border-line pt-3 font-sans text-[0.75rem] font-medium uppercase tracking-[0.12em] text-subtle"
      >
        五篇长文
      </h2>
      <p class="mt-3 text-[0.9375rem] leading-[1.7] text-subtle">
        术语只能救急，流程还得看完整的。这个栏目一共五篇，都来自实际业务。
      </p>
      <ul class="mt-2">
        {
          glossaryGuides.map((guide) => (
            <li class="border-b border-line">
              <a
                href={guide.url}
                class="focus-ring group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4 text-muted hover:text-ink"
              >
                <span class="max-w-[36rem] text-pretty font-serif text-[1.0625rem] font-[540] leading-snug tracking-[-0.01em] text-ink-strong">
                  {guide.title}
                </span>
                <span class="mono inline-flex items-center gap-2 text-[0.6875rem] uppercase tracking-[0.1em] text-subtle">
                  {guide.keyword}
                  <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Footer note -------------------------------------------------------- -->
    <div class="mt-12 flex max-w-[46rem] flex-wrap items-baseline justify-between gap-4 border-t border-line pt-5">
      <p class="mono text-[0.6875rem] uppercase tracking-[0.14em] text-subtle">
        最后更新 · <time datetime={updated}>{updated}</time>
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-1">
        <a href="/foreign-trade/" class="focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted hover:text-ink">
          外贸栏目
          <span aria-hidden="true">→</span>
        </a>
        <a href="/consulting/" class="focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted hover:text-ink">
          咨询
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
