---
/**
 * HomeView — V4 content-first home: a person's desk, not a portfolio poster.
 *
 * Order: Hero → StatBar → Recent notes → Now → Works → Writing → Reading →
 * Timeline. The ArtPlate manifesto is gone; sections are headed by a plain
 * label + lede (no numbering, no English italic subtitles).
 *
 * Notes (`../data/notes`) and reading (`../data/reading`) are owned by other
 * agents and may land late: they are loaded through import.meta.glob so a
 * missing module degrades to an empty section instead of a red build.
 */
import { getCollection } from 'astro:content';
import Hero from '../components/home/Hero.astro';
import NotesSection from '../components/home/NotesSection.astro';
import TradeSection from '../components/home/TradeSection.astro';
import type { TradeGuide } from '../components/home/TradeSection.astro';
import NowStrip from '../components/home/NowStrip.astro';
import WorksSection from '../components/home/WorksSection.astro';
import WritingSection from '../components/home/WritingSection.astro';
import type { WritingItem } from '../components/home/WritingSection.astro';
import ReadingStrip from '../components/home/ReadingStrip.astro';
import TimelineStrip from '../components/home/TimelineStrip.astro';
import HomeMotion from '../components/home/HomeMotion.astro';
import StatBar from '../components/ui/StatBar.astro';
import { copy, c } from '../data/copy';
import { getFeaturedProjects, getLocalizedProjects, type ProjectEntry } from '../lib/projects';
import { getAllPosts } from '../lib/posts';
import { getTimeline, homeMilestones } from '../data/timeline';
import { latestNotes } from '../data/notes';
import { currentlyReading } from '../data/reading';
import { now } from '../data/now';
import { localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

/* -------------------------------------------------------------------------- */
/* Projects                                                                   */
/* -------------------------------------------------------------------------- */
const allProjects = await getLocalizedProjects(lang);
const featuredProjects = await getFeaturedProjects(lang, 2);
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));

/* The A+ story order: job boards become leads before the thesis toy. */
const TOOL_ORDER = ['boss-client', 'zhilian-client', 'tanji-client', 'tennis-ball-robot'];
const tools: ProjectEntry[] = allProjects
  .filter((project) => !featuredSlugs.has(project.slug))
  .sort((a, b) => {
    const indexA = TOOL_ORDER.indexOf(a.slug);
    const indexB = TOOL_ORDER.indexOf(b.slug);
    return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
  });

/* -------------------------------------------------------------------------- */
/* Writing — the four newest essays                                           */
/* -------------------------------------------------------------------------- */
const posts = await getAllPosts(lang);
const latestPosts: WritingItem[] = posts.slice(0, 4).map((post) => ({
  title: post.title,
  description: post.description,
  category: post.category,
  dateLabel: post.date.toISOString().slice(0, 10).replaceAll('-', '.'),
  readingTime: post.readingTime,
  href: localizePath(post.path, lang),
}));

/* -------------------------------------------------------------------------- */
/* Notes / reading — Chinese-only source data (live modules)                   */
/* -------------------------------------------------------------------------- */
const recentNotes = latestNotes(4);
const deskBooks = currentlyReading.slice(0, 3);

/* -------------------------------------------------------------------------- */
/* Trade cluster — zh-only guides collection (may be empty while content lands) */
/* -------------------------------------------------------------------------- */
let tradeGuides: TradeGuide[] = [];
try {
  const guideEntries = await getCollection('guides', (entry) => entry.data.draft !== true);
  tradeGuides = guideEntries
    .sort(
      (a, b) =>
        a.data.order - b.data.order || b.data.updated.getTime() - a.data.updated.getTime()
    )
    .slice(0, 3)
    .map((entry) => ({
      title: entry.data.title,
      description: entry.data.description,
      keyword: entry.data.keywords?.[0] ?? '',
      href: `/foreign-trade/${entry.id}/`,
    }));
} catch {
  tradeGuides = [];
}

/* -------------------------------------------------------------------------- */
/* Now — four current lines from the Lead-owned data module                   */
/* -------------------------------------------------------------------------- */
const nowRows = now.sections
  .map((section) => {
    const first = section.items[0];
    if (!first) return null;
    const text = lang === 'en' && first.en ? first.en : first.zh;
    return { label: c(section.label, lang), text };
  })
  .filter((row): row is { label: string; text: string } => row !== null)
  .slice(0, 4);

/* -------------------------------------------------------------------------- */
/* Timeline                                                                   */
/* -------------------------------------------------------------------------- */
const timelineEntries = getTimeline(lang);
const timelineById = new Map(timelineEntries.map((entry) => [entry.id, entry]));
const milestones = homeMilestones
  .map((id) => timelineById.get(id))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

/* -------------------------------------------------------------------------- */
/* Stats                                                                      */
/* -------------------------------------------------------------------------- */
const stats = copy.home.stats.map((stat) => ({
  value: stat.value,
  label: c(stat.label, lang),
}));
const statLabel = lang === 'zh' ? '数字' : 'Numbers';
/* The notes and reading data are written in Chinese only, so they stay on the
 * Chinese home page; /en/ shows the bilingual sections (works, writing, now). */
const showNotes = lang === 'zh' && recentNotes.length > 0;
const showReading = lang === 'zh' && deskBooks.length > 0;
/* The trade cluster is Chinese-only (guides/hub/consulting are zh pages). */
const showTrade = lang === 'zh';
---

<div data-home class="home-page">
  <!-- BaseLayout's reveal observer adds .is-revealed; without JS nothing may
       stay hidden, so the no-JS fallback is declared here. -->
  <noscript>
    <style>
      [data-reveal],
      [data-hero-step] {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>

  <Hero lang={lang} />

  <div class="wrap">
    <StatBar stats={stats} label={statLabel} class="home-stats" />
  </div>

  {showNotes && <NotesSection lang={lang} notes={recentNotes} />}

  <NowStrip lang={lang} rows={nowRows} />

  {showTrade && <TradeSection lang={lang} guides={tradeGuides} />}

  <WorksSection
    lang={lang}
    featured={featuredProjects}
    tools={tools}
    total={allProjects.length}
    class="home-block"
  />

  <WritingSection lang={lang} posts={latestPosts} class="home-block" />

  {showReading && <ReadingStrip lang={lang} books={deskBooks} />}

  <TimelineStrip lang={lang} entries={milestones} class="home-block" />

  <HomeMotion />
</div>

<style>
  /* BaseLayout's main already owns the page top padding; trim it so the hero
     sits close to the masthead. */
  .home-page {
    margin-top: calc(var(--space-8) * -1);
  }

  .home-stats {
    margin-top: clamp(2.25rem, 3.5vw, 3rem);
  }

  /* Denser than the editorial `.section` rhythm: a desk, not a magazine. */
  .home-block {
    padding-block: clamp(3.25rem, 5.5vw, 4.75rem);
  }

  .home-block.section {
    padding-block: clamp(3.25rem, 5.5vw, 4.75rem);
  }

  @media (min-width: 640px) {
    .home-page {
      margin-top: calc(var(--space-9) * -1);
    }
  }
</style>
