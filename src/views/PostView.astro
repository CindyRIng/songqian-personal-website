---
/**
 * PostView — the essay page (A+ direction).
 *
 * Oversized serif title with the other language's title as an italic subtitle,
 * category / date / reading time, cover, table of contents, prose body, tags,
 * previous/next essay and the author card. Reading enhancements (heading
 * anchors, code copy, image lightbox, progress bar) are wired by BaseLayout
 * for `type="article"` pages.
 */
import type { MarkdownHeading } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import PostHeader from '../components/writing/PostHeader.astro';
import Toc from '../components/writing/Toc.astro';
import PrevNext from '../components/writing/PrevNext.astro';
import PostFooterBio from '../components/writing/PostFooterBio.astro';
import { formatDate, isoDate, localizePath, useTranslations, localeMeta } from '../i18n/utils';
import { SITE, type Locale } from '../i18n/config';
import { hasCoverAsset, type PostEntry } from '../lib/posts';
import { profile, lt } from '../data/profile';

interface Props {
  lang: Locale;
  post: PostEntry;
  Content: any;
  headings: MarkdownHeading[];
  related: PostEntry[];
  older?: PostEntry;
  newer?: PostEntry;
}

const { lang, post, Content, headings, related } = Astro.props;
const t = useTranslations(lang);

const siteUrl = Astro.site ?? new URL(SITE.url);
const canonical = new URL(localizePath(post.path, lang), siteUrl).href;
const cover = hasCoverAsset(post.cover) ? post.cover : undefined;
const writingHref = localizePath('/writing', lang);
const authorName = lt(profile.name, lang) || profile.latinName;
const otherLocale: Locale = lang === 'zh' ? 'en' : 'zh';

const ogImage = cover ? `/og/posts/${post.slug}.jpg` : '/og/default.png';

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${canonical}#article`,
      headline: post.title,
      name: post.title,
      description: post.description,
      url: canonical,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      datePublished: post.date.toISOString(),
      dateModified: (post.updated ?? post.date).toISOString(),
      inLanguage: localeMeta[lang].htmlLang,
      articleSection: t(`writing.category.${post.category}` as never),
      keywords: post.tags.join(', '),
      timeRequired: `PT${post.readingTime}M`,
      image: new URL(ogImage, siteUrl).href,
      author: { '@id': `${siteUrl.href}#person` },
      publisher: { '@id': `${siteUrl.href}#person` },
      isPartOf: { '@type': 'Blog', '@id': `${siteUrl.href}#blog`, name: '宋谦 · 写作 / Song Qian · Writing' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: lang === 'zh' ? '首页' : 'Home', item: siteUrl.href },
        {
          '@type': 'ListItem',
          position: 2,
          name: lang === 'zh' ? '写作' : 'Writing',
          item: new URL(localizePath('/writing', lang), siteUrl).href,
        },
        { '@type': 'ListItem', position: 3, name: post.title, item: canonical },
      ],
    },
  ],
};
---
<BaseLayout
  lang={lang}
  title={post.title}
  description={post.description}
  image={cover ? `/og/posts/${post.slug}.jpg` : '/og/default.png'}
  imageWidth={1200}
  imageHeight={630}
  type="article"
  path={post.path}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.date.toISOString()} />
    <meta property="article:modified_time" content={(post.updated ?? post.date).toISOString()} />
    <meta property="article:section" content={t(`writing.category.${post.category}` as never)} />
    {post.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  </Fragment>

  <div id="reading-progress" class="progress" aria-hidden="true"></div>

  <article>
    <a
      href={writingHref}
      class="group inline-flex items-center gap-2 font-sans text-[0.8125rem] text-subtle transition-colors hover:text-ink"
    >
      <Icon
        name="arrow-left"
        size={14}
        class="transition-transform duration-200 ease-out motion-safe:group-hover:-translate-x-1"
      />
      {t('writing.all')}
    </a>

    <div class="mt-10 sm:mt-14">
      <PostHeader post={post} lang={lang} />
    </div>

    {
      cover && (
        <figure class="mt-10 overflow-hidden rounded-lg border border-line bg-surface sm:mt-14">
          <img
            src={cover}
            alt={post.coverAlt ?? ''}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
            class="aspect-[16/9] w-full object-cover"
          />
        </figure>
      )
    }

    <Toc headings={headings} lang={lang} />

    <div class="post-body prose">
      <Content />
    </div>

    {
      post.tags.length > 0 && (
        <div class="mt-12 flex flex-wrap items-center gap-2">
          {post.tags.map((tag) => (
            <span class="inline-flex items-center rounded-full border border-line px-2.5 py-1 font-sans text-[0.6875rem] tracking-[0.02em] text-subtle">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <PrevNext lang={lang} older={Astro.props.older} newer={Astro.props.newer} />

    <PostFooterBio lang={lang} />

    {
      related.length > 0 && (
        <section class="mt-16" aria-labelledby="related-title">
          <h2
            id="related-title"
            class="font-sans text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-subtle"
          >
            {t('writing.related')}
          </h2>
          <ul class="mt-5 border-t border-line">
            {related.map((item) => (
              <li>
                <a
                  href={localizePath(item.path, lang)}
                  class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-line py-4 transition-colors hover:text-accent-strong"
                >
                  <span class="font-serif text-[1.0625rem] font-[540] leading-snug tracking-[-0.012em] text-ink-strong transition-colors group-hover:text-accent-strong">
                    {item.title}
                  </span>
                  <span class="font-mono text-[0.6875rem] tabular uppercase tracking-[0.06em] text-subtle">
                    {formatDate(item.date, lang, 'short')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
