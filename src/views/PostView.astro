---
/**
 * PostView — the shared essay template for all six locales.
 *
 * A book page, not a landing page: back link, category · date eyebrow, large
 * serif title, muted lede, the abstract cover, a quiet contents list, the MDX
 * body in .prose, then tags, share controls, the author card, neighbours and a
 * short "more writing" list. Reading progress is wired by BaseLayout through
 * the #reading-progress element.
 */
import type { MarkdownHeading } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import PostHeader from '../components/writing/PostHeader.astro';
import PostCover from '../components/writing/PostCover.astro';
import Toc from '../components/writing/Toc.astro';
import ShareRow from '../components/writing/ShareRow.astro';
import PostFooterBio from '../components/writing/PostFooterBio.astro';
import PrevNext from '../components/writing/PrevNext.astro';
import PostRow from '../components/writing/PostRow.astro';
import { localizePath, useTranslations, localeMeta } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import { lt, profile } from '../data/profile';
import { hasCoverAsset, type PostEntry } from '../lib/posts';
import type { TranslationKey } from '../i18n/ui';

interface Props {
  lang: Locale;
  post: PostEntry;
  Content: any;
  headings: MarkdownHeading[];
  related: PostEntry[];
  older?: PostEntry;
  newer?: PostEntry;
}

const { lang, post, Content, headings, related, older, newer } = Astro.props;
const t = useTranslations(lang);

const siteUrl = Astro.site ?? new URL('https://songqian.dev');
const cover = hasCoverAsset(post.cover) ? post.cover : undefined;
const canonical = new URL(localizePath(post.path, lang), siteUrl).href;
const writingHref = localizePath('/writing', lang);
const authorName = lt(profile.name, lang) || profile.latinName;
const categoryKey = `writing.category.${post.category}` as TranslationKey;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  datePublished: post.date.toISOString(),
  dateModified: (post.updated ?? post.date).toISOString(),
  author: { '@type': 'Person', name: authorName, url: siteUrl.href },
  publisher: { '@type': 'Person', name: authorName, url: siteUrl.href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  image: new URL('/og/default.png', siteUrl).href,
  inLanguage: localeMeta[lang].htmlLang,
  articleSection: t(categoryKey),
  keywords: post.tags.join(', '),
  timeRequired: `PT${post.readingTime}M`,
};
---
<BaseLayout
  lang={lang}
  title={post.title}
  description={post.description}
  type="article"
  path={post.path}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  </Fragment>

  <div id="reading-progress" class="progress" aria-hidden="true"></div>

  <article class="flex flex-col gap-8">
    <a
      href={writingHref}
      class="group inline-flex w-fit items-center gap-1.5 font-sans text-[0.75rem] text-subtle transition-colors duration-200 ease-out hover:text-ink"
    >
      <Icon
        name="arrow-left"
        size={13}
        class="transition-transform duration-200 ease-out motion-safe:group-hover:-translate-x-0.5"
      />
      {t('writing.backToWriting')}
    </a>

    <PostHeader post={post} lang={lang} />

    {cover ? (
      <figure class="overflow-hidden rounded-xl bg-surface ring-1 ring-line">
        <img
          src={cover}
          alt={post.coverAlt ?? ''}
          class="aspect-[16/9] w-full object-cover sm:aspect-[2/1]"
          loading="eager"
          decoding="async"
        />
      </figure>
    ) : (
      <PostCover
        slug={post.slug}
        title={post.title}
        year={post.date.getUTCFullYear()}
        size="hero"
        class="aspect-[16/9] sm:aspect-[2/1]"
      />
    )}

    <Toc headings={headings} lang={lang} />

    <div class="post-body prose">
      <Content />
    </div>

    {
      post.tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 border-t border-line pt-5">
          <span class="eyebrow me-1">{t('common.tags')}</span>
          {post.tags.map((tag) => (
            <span class="chip">{tag}</span>
          ))}
        </div>
      )
    }

    <ShareRow
      lang={lang}
      url={canonical}
      class="border-b border-line pb-6"
    />

    <PostFooterBio lang={lang} />

    <PrevNext lang={lang} older={older} newer={newer} />

    {
      related.length > 0 && (
        <section class="flex flex-col gap-3" aria-labelledby="more-writing">
          <h2 id="more-writing" class="eyebrow">
            {t('writing.moreWriting')}
          </h2>
          <div class="flex flex-col border-t border-line divide-y divide-line">
            {related.map((item) => (
              <PostRow post={item} lang={lang} />
            ))}
          </div>
        </section>
      )
    }
  </article>

  <style>
    .post-body {
      hanging-punctuation: first last;
    }
  </style>
</BaseLayout>
