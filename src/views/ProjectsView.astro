---
/**
 * ProjectsView — /projects and /[lang]/projects.
 *
 * Editorial single column: intro, quiet category filter (progressive
 * enhancement — hidden without JS), then full-width project cards with the
 * first project presented larger.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import Icon from '../components/ui/Icon.astro';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import {
  PROJECT_CATEGORIES,
  PROJECT_CATEGORY_LABELS,
  countByCategory,
  getLocalizedProjects,
} from '../lib/projects';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getLocalizedProjects(lang);
const counts = countByCategory(projects);

/** Page-specific copy (content, not chrome). */
const copy: Record<
  Locale,
  { eyebrow: string; filter: string; empty: string; continue: string; readMore: string }
> = {
  en: {
    eyebrow: 'Selected work',
    filter: 'Filter',
    empty: 'Nothing in this category yet — try another one.',
    continue: 'Keep looking',
    readMore: 'View project',
  },
  zh: {
    eyebrow: '作品集',
    filter: '筛选',
    empty: '这个分类下暂时没有内容，换一个看看。',
    continue: '继续浏览',
    readMore: '查看项目',
  },
  ja: {
    eyebrow: '作品集',
    filter: '絞り込み',
    empty: 'このカテゴリにはまだ何もありません。別のものを選んでください。',
    continue: '続けて見る',
    readMore: 'プロジェクトを見る',
  },
  es: {
    eyebrow: 'Trabajo seleccionado',
    filter: 'Filtrar',
    empty: 'Aún no hay nada en esta categoría; prueba otra.',
    continue: 'Seguir mirando',
    readMore: 'Ver proyecto',
  },
  fr: {
    eyebrow: 'Travaux choisis',
    filter: 'Filtrer',
    empty: 'Rien dans cette catégorie pour l’instant — essayez-en une autre.',
    continue: 'Continuer à regarder',
    readMore: 'Voir le projet',
  },
  de: {
    eyebrow: 'Ausgewählte Arbeiten',
    filter: 'Filtern',
    empty: 'In dieser Kategorie ist noch nichts — probiere eine andere.',
    continue: 'Weiterschauen',
    readMore: 'Projekt ansehen',
  },
};

const c = copy[lang];
const total = String(projects.length).padStart(2, '0');
---

<BaseLayout
  lang={lang}
  title={t('projects.title')}
  description={t('projects.subtitle')}
  path="/projects"
>
  <header class="flex flex-col gap-4">
    <p class="eyebrow">{total} — {c.eyebrow}</p>
    <h1 class="text-balance font-serif text-[2.25rem] font-[550] leading-[1.06] tracking-[-0.03em] text-ink-strong sm:text-[2.75rem]">
      {t('projects.title')}
    </h1>
    <p class="max-w-[46ch] text-pretty text-[1.0625rem] leading-[1.65] text-muted">
      {t('projects.subtitle')}
    </p>
  </header>

  <!-- Filter chips: hidden until the tiny filter script runs. -->
  <div
    class="mt-9 flex flex-wrap items-center gap-1.5"
    data-project-filters
    style="display: none;"
    role="group"
    aria-label={c.filter}
  >
    <span class="eyebrow mr-2">{c.filter}</span>
    <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">
      {t('common.all')}
      <span class="filter-count">{projects.length}</span>
    </button>
    {
      PROJECT_CATEGORIES.filter((category) => counts[category] > 0).map((category) => (
        <button
          type="button"
          class="filter-chip"
          data-filter={category}
          aria-pressed="false"
        >
          {PROJECT_CATEGORY_LABELS[category][lang]}
          <span class="filter-count">{counts[category]}</span>
        </button>
      ))
    }
  </div>

  <p
    class="mt-10 text-pretty text-[0.9375rem] leading-relaxed text-subtle"
    data-project-empty
    style="display: none;"
    role="status"
  >
    {c.empty}
  </p>

  <!-- Cards: single column, first one larger. -->
  <div class="mt-10 flex flex-col gap-9 sm:mt-12 sm:gap-12" data-project-list>
    {
      projects.map((project, index) => (
        <ProjectCard
          lang={lang}
          project={project}
          index={index + 1}
          featured={index === 0}
          delay={Math.min(index * 70, 280)}
        />
      ))
    }
  </div>

  <!-- Tail navigation -->
  <div class="mt-16 flex items-center justify-between border-t border-line pt-6" data-reveal>
    <a
      href={localizePath('/about', lang)}
      class="group inline-flex items-center gap-2 font-sans text-[0.8125rem] font-medium text-muted transition-colors duration-200 hover:text-ink"
    >
      <Icon
        name="arrow-left"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:-translate-x-0.5"
      />
      {t('nav.about')}
    </a>
    <a
      href={localizePath('/timeline', lang)}
      class="group inline-flex items-center gap-2 font-sans text-[0.8125rem] font-medium text-muted transition-colors duration-200 hover:text-ink"
    >
      {t('nav.timeline')}
      <Icon
        name="arrow-right"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
      />
    </a>
  </div>
<Fragment slot="scripts">
  <script>
    // Quiet category filter — progressive enhancement over a full list.
    const filters = document.querySelector<HTMLElement>('[data-project-filters]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
    const empty = document.querySelector<HTMLElement>('[data-project-empty]');

    if (filters && cards.length > 0) {
      filters.style.display = '';

      const buttons = Array.from(
        filters.querySelectorAll<HTMLButtonElement>('[data-filter]')
      );

      const apply = (value: string) => {
        let visible = 0;
        for (const card of cards) {
          const tags = (card.dataset.tags ?? '').split(/\s+/).filter(Boolean);
          const show = value === 'all' || tags.includes(value);
          card.hidden = !show;
          if (show) visible += 1;
        }
        if (empty) empty.style.display = visible === 0 ? '' : 'none';
        for (const button of buttons) {
          const active = button.dataset.filter === value;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(active));
        }
      };

      for (const button of buttons) {
        button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
      }
    }
  </script>
</Fragment>
</BaseLayout>



<style>
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    padding: 0.3125rem 0.6875rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--dur-1) ease-out,
      background-color var(--dur-1) ease-out,
      border-color var(--dur-1) ease-out;
  }

  .filter-chip:hover {
    color: var(--ink);
    background: var(--hover);
    border-color: var(--line-strong);
  }

  .filter-chip.is-active {
    color: var(--canvas);
    background: var(--ink-strong);
    border-color: var(--ink-strong);
  }

  .filter-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    color: var(--subtle);
  }

  .filter-chip.is-active .filter-count {
    color: color-mix(in oklab, var(--canvas) 70%, transparent);
  }
</style>
