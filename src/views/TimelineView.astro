---
/**
 * TimelineView — /timeline and /[lang]/timeline.
 *
 * One continuous hairline rail with a dot per entry, grouped by year. The
 * segmented control filters by type in place (progressive enhancement — it is
 * hidden until the tiny script runs, so the no-JS page is a complete list).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineEntry from '../components/timeline/TimelineEntry.astro';
import Icon from '../components/ui/Icon.astro';
import { profile, lt } from '../data/profile';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import {
  TIMELINE_TYPES,
  TIMELINE_TYPE_KEYS,
  countTimelineByType,
  getTimeline,
  groupTimelineByYear,
  type TimelineType,
} from '../data/timeline';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = getTimeline(lang);
const groups = groupTimelineByYear(entries);
const counts = countTimelineByType(entries);
const now = profile.now.map((paragraph) => lt(paragraph, lang));
const nowYear = new Date().getUTCFullYear();

const copy: Record<
  Locale,
  {
    eyebrow: string;
    filter: string;
    entries: (n: number) => string;
    nowNote: string;
    empty: string;
  }
> = {
  en: {
    eyebrow: 'A life in dates',
    filter: 'Filter',
    entries: (n) => `${n} entries`,
    nowNote: 'What I am doing right now',
    empty: 'Nothing here yet.',
  },
  zh: {
    eyebrow: '以日期丈量',
    filter: '筛选',
    entries: (n) => `${n} 条记录`,
    nowNote: '此刻在做的事',
    empty: '暂时没有内容。',
  },
  ja: {
    eyebrow: '日付でたどる',
    filter: '絞り込み',
    entries: (n) => `${n}件`,
    nowNote: 'いまやっていること',
    empty: 'まだ何もありません。',
  },
  es: {
    eyebrow: 'Una vida en fechas',
    filter: 'Filtrar',
    entries: (n) => `${n} entradas`,
    nowNote: 'Lo que hago ahora mismo',
    empty: 'Nada por aquí todavía.',
  },
  fr: {
    eyebrow: 'Une vie en dates',
    filter: 'Filtrer',
    entries: (n) => `${n} entrées`,
    nowNote: 'Ce que je fais en ce moment',
    empty: 'Rien ici pour l’instant.',
  },
  de: {
    eyebrow: 'Ein Leben in Daten',
    filter: 'Filtern',
    entries: (n) => `${n} Einträge`,
    nowNote: 'Was ich gerade mache',
    empty: 'Noch nichts hier.',
  },
};

const c = copy[lang];

const TYPE_ICONS: Record<TimelineType, 'layers' | 'book' | 'sparkle' | 'camera'> = {
  work: 'layers',
  education: 'book',
  milestone: 'sparkle',
  life: 'camera',
};
---

<BaseLayout
  lang={lang}
  title={t('timeline.title')}
  description={t('timeline.subtitle')}
  path="/timeline"
>
  <header class="flex flex-col gap-4">
    <p class="eyebrow">{String(entries.length).padStart(2, '0')} — {c.eyebrow}</p>
    <h1 class="text-balance font-serif text-[2.25rem] font-[550] leading-[1.06] tracking-[-0.03em] text-ink-strong sm:text-[2.75rem]">
      {t('timeline.title')}
    </h1>
    <p class="max-w-[46ch] text-pretty text-[1.0625rem] leading-[1.65] text-muted">
      {t('timeline.subtitle')}
    </p>
    <p class="font-sans text-[0.75rem] tracking-[0.01em] text-subtle">{c.entries(entries.length)}</p>
  </header>

  <!-- Segmented type filter: hidden until the script runs. -->
  <div
    class="mt-8"
    data-timeline-filters
    style="display: none;"
    role="group"
    aria-label={c.filter}
  >
    <div class="inline-flex flex-wrap items-center gap-1 rounded-[1.25rem] border border-line bg-surface p-1 sm:rounded-full">
      <button type="button" class="timeline-filter is-active" data-filter="all" aria-pressed="true">
        {t('timeline.filterAll')}
      </button>
      {
        TIMELINE_TYPES.filter((type) => counts[type] > 0).map((type) => (
          <button
            type="button"
            class="timeline-filter"
            data-filter={type}
            aria-pressed="false"
          >
            <Icon name={TYPE_ICONS[type]} size={11} />
            {t(TIMELINE_TYPE_KEYS[type])}
            <span class="timeline-filter-count">{counts[type]}</span>
          </button>
        ))
      }
    </div>
  </div>

  <p
    class="mt-8 text-[0.9375rem] leading-relaxed text-subtle"
    data-timeline-empty
    style="display: none;"
    role="status"
  >
    {c.empty}
  </p>

  <!-- The rail ------------------------------------------------------------- -->
  <div class="relative mt-10" data-timeline-rail>
    <div class="absolute inset-y-2 left-0 w-px bg-line" aria-hidden="true"></div>

    {
      groups.map((group, groupIndex) => (
        <section
          class="relative"
          data-timeline-group
          style={`margin-top: ${groupIndex === 0 ? '0' : '2.75rem'}`}
        >
          <header class="relative flex items-baseline gap-3 pl-8">
            <span class="year-marker" aria-hidden="true"></span>
            <h2 class="font-serif text-[1.3125rem] font-[550] leading-none tracking-[-0.02em] text-ink-strong tabular">
              {group.year}
            </h2>
            <span class="h-px flex-1 translate-y-[-0.18em] bg-line" aria-hidden="true"></span>
            <span class="font-mono text-[0.625rem] tabular text-faint">
              {String(group.entries.length).padStart(2, '0')}
            </span>
          </header>

          <div class="mt-5 flex flex-col gap-7">
            {group.entries.map((entry, entryIndex) => (
              <TimelineEntry
                lang={lang}
                entry={entry}
                delay={Math.min((groupIndex * 2 + entryIndex) * 45, 270)}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <!-- Now ------------------------------------------------------------------ -->
  <section class="mt-16" aria-labelledby="timeline-now" data-reveal>
    <div class="rounded-lg border border-line bg-surface p-5 shadow-sm sm:p-6">
      <div class="flex items-center gap-2">
        <span class="relative flex size-2 items-center justify-center" aria-hidden="true">
          <span class="absolute inline-flex size-2 rounded-full bg-accent opacity-60 motion-safe:animate-ping"></span>
          <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
        </span>
        <h2 id="timeline-now" class="font-sans text-[0.75rem] font-[560] uppercase tracking-[0.12em] text-muted">
          {t('timeline.now')}
        </h2>
        <span class="h-px flex-1 translate-y-0 bg-line"></span>
        <span class="font-mono text-[0.625rem] tabular text-faint">{nowYear}</span>
      </div>

      <p class="mt-4 text-pretty font-serif text-[1.125rem] leading-[1.6] text-ink">
        {now.join(' ')}
      </p>
      <p class="mt-2 font-sans text-[0.6875rem] text-subtle">{c.nowNote}</p>

      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-4">
        <a
          href={localizePath('/about', lang)}
          class="group inline-flex items-center gap-1.5 font-sans text-[0.75rem] font-medium text-muted transition-colors duration-200 hover:text-ink"
        >
          {t('nav.about')}
          <Icon
            name="arrow-right"
            size={12}
            class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
          />
        </a>
        <span class="size-0.5 rounded-full bg-faint" aria-hidden="true"></span>
        <a
          href={localizePath('/projects', lang)}
          class="group inline-flex items-center gap-1.5 font-sans text-[0.75rem] font-medium text-muted transition-colors duration-200 hover:text-ink"
        >
          {t('projects.allProjects')}
          <Icon
            name="arrow-right"
            size={12}
            class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- Tail navigation -------------------------------------------------------- -->
  <div class="mt-14 flex items-center justify-between border-t border-line pt-6" data-reveal>
    <a
      href={localizePath('/about', lang)}
      class="group inline-flex items-center gap-2 font-sans text-[0.8125rem] font-medium text-muted transition-colors duration-200 hover:text-ink"
    >
      <Icon
        name="arrow-left"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:-translate-x-0.5"
      />
      {t('nav.about')}
    </a>
    <a
      href={localizePath('/projects', lang)}
      class="group inline-flex items-center gap-2 font-sans text-[0.8125rem] font-medium text-muted transition-colors duration-200 hover:text-ink"
    >
      {t('nav.projects')}
      <Icon
        name="arrow-right"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
      />
    </a>
  </div>

  <Fragment slot="scripts">
    <script>
      // Quiet type filter — the no-JS page is already complete.
      const filters = document.querySelector<HTMLElement>('[data-timeline-filters]');
      const rail = document.querySelector<HTMLElement>('[data-timeline-rail]');
      const empty = document.querySelector<HTMLElement>('[data-timeline-empty]');

      if (filters && rail) {
        filters.style.display = '';

        const buttons = Array.from(
          filters.querySelectorAll<HTMLButtonElement>('[data-filter]')
        );
        const groups = Array.from(rail.querySelectorAll<HTMLElement>('[data-timeline-group]'));

        const apply = (value: string) => {
          let visible = 0;
          for (const group of groups) {
            const items = Array.from(
              group.querySelectorAll<HTMLElement>('[data-timeline-item]')
            );
            let groupVisible = 0;
            for (const item of items) {
              const show = value === 'all' || item.dataset.type === value;
              item.hidden = !show;
              if (show) groupVisible += 1;
            }
            group.hidden = groupVisible === 0;
            visible += groupVisible;
          }
          if (empty) empty.style.display = visible === 0 ? '' : 'none';
          for (const button of buttons) {
            const active = button.dataset.filter === value;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          }
        };

        for (const button of buttons) {
          button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
        }
      }
    </script>
  </Fragment>
</BaseLayout>

<style>
  .timeline-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    padding: 0.3125rem 0.6875rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--dur-1) ease-out,
      background-color var(--dur-1) ease-out;
  }

  .timeline-filter:hover {
    color: var(--ink);
    background: var(--hover);
  }

  .timeline-filter.is-active {
    color: var(--ink-strong);
    background: var(--elevated);
    box-shadow: var(--shadow-sm);
  }

  .timeline-filter-count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }

  .timeline-filter.is-active .timeline-filter-count {
    color: var(--subtle);
  }

  .year-marker {
    position: absolute;
    left: 0;
    top: 0.45rem;
    height: 8px;
    width: 8px;
    translate: -50% 0;
    rotate: 45deg;
    border: 1px solid var(--line-strong);
    background: var(--canvas);
  }
</style>
