---
/**
 * TimelineView — `/timeline` (zh) and `/en/timeline` (en).
 *
 * A+ direction: one big serif year on the left (sticky on desktop), the entry
 * cards on the right, hairline rules between year groups. Type filtering is
 * progressive enhancement — the no-JS page is the complete timeline.
 *
 * TODO(forge): `ui/SectionHeading.astro` follows rebuild-spec §3.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import TimelineEntry from '../components/timeline/TimelineEntry.astro';
import { copy, c } from '../data/copy';
import { localizePath, useTranslations } from '../i18n/utils';
import { SITE, localeMeta, type Locale } from '../i18n/config';
import {
  TIMELINE_TYPES,
  TIMELINE_TYPE_KEYS,
  countTimelineByType,
  getTimeline,
  groupTimelineByYear,
} from '../data/timeline';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = getTimeline(lang);
const groups = groupTimelineByYear(entries);
const counts = countTimelineByType(entries);
const activeTypes = TIMELINE_TYPES.filter((type) => counts[type] > 0);

const siteUrl = Astro.site ?? new URL(SITE.url);
const timelineJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: c(copy.timeline.title, lang),
      description: c(copy.meta.timelineDescription, lang),
      url: new URL(localizePath('/timeline', lang), siteUrl).href,
      inLanguage: localeMeta[lang].htmlLang,
    },
    {
      '@type': 'ItemList',
      itemListElement: entries.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${entry.org} · ${entry.role}`,
        description: entry.summary,
        startDate: entry.start,
        endDate: entry.end ?? undefined,
      })),
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={c(copy.timeline.title, lang)}
  description={c(copy.meta.timelineDescription, lang)}
  path="/timeline"
  wide
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(timelineJsonLd)} />
  </Fragment>
  <header class="wrap pt-2 sm:pt-6">
    <SectionHeading
      number="03"
      title={c(copy.timeline.title, lang)}
      en={lang === 'zh' ? 'Timeline' : '时间线'}
      lede={c(copy.timeline.lede, lang)}
      id="timeline-title"
    />

    <!-- Type filter (hidden until the script runs) -->
    <div class="mt-8 flex flex-wrap items-center gap-1.5" data-timeline-filters style="display: none;" role="group" aria-label={t('timeline.filterAll')}>
      <button type="button" class="tl-filter is-active" data-filter="all" aria-pressed="true">
        {t('timeline.filterAll')}
        <span class="mono text-[0.625rem] text-subtle">{entries.length}</span>
      </button>
      {
        activeTypes.map((type) => (
          <button type="button" class="tl-filter" data-filter={type} aria-pressed="false">
            {t(TIMELINE_TYPE_KEYS[type])}
            <span class="mono text-[0.625rem] text-subtle">{counts[type]}</span>
          </button>
        ))
      }
    </div>

    <p class="mt-8 hidden text-[0.9375rem] leading-relaxed text-subtle" data-timeline-empty role="status">
      {t('common.noResults')}
    </p>
  </header>

  <div class="wrap mt-10 sm:mt-14">
    {
      groups.map((group) => (
        <section
          class="grid grid-cols-[4.5rem_1fr] gap-x-4 border-t border-line py-10 first:border-t-0 md:grid-cols-[10rem_1fr] md:gap-x-12 md:py-14"
          data-timeline-group
          aria-label={String(group.year)}
        >
          <div class="md:sticky md:top-28 md:self-start">
            <h2 class="font-serif text-[clamp(1.75rem,6vw,3.5rem)] font-[520] leading-none tracking-[-0.03em] text-ink-strong tabular">
              {group.year}
            </h2>
            <span class="mono mt-2 hidden text-[0.625rem] uppercase tracking-[0.14em] text-subtle md:block">
              {String(group.entries.length).padStart(2, '0')} {lang === 'zh' ? '条' : 'entries'}
            </span>
          </div>

          <div class="flex min-w-0 flex-col">
            {group.entries.map((entry, index) => (
              <TimelineEntry lang={lang} entry={entry} delay={Math.min(index * 60, 240)} />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <!-- Cross-navigation ----------------------------------------------------- -->
  <div class="wrap mt-4 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
    <a
      href={localizePath('/about', lang)}
      class="group inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
    >
      <Icon
        name="arrow-left"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:-translate-x-0.5"
      />
      {t('nav.about')}
    </a>
    <a
      href={localizePath('/works', lang)}
      class="group inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
    >
      {t('nav.works')}
      <Icon
        name="arrow-right"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
      />
    </a>
  </div>

  <Fragment slot="scripts">
    <script>
      // Quiet type filter — the no-JS page already lists everything.
      const filters = document.querySelector<HTMLElement>('[data-timeline-filters]');
      const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-group]'));
      const empty = document.querySelector<HTMLElement>('[data-timeline-empty]');

      if (filters && groups.length > 0) {
        filters.style.display = '';
        const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-filter]'));

        const apply = (value: string) => {
          let visible = 0;
          for (const group of groups) {
            const items = Array.from(group.querySelectorAll<HTMLElement>('[data-timeline-item]'));
            let groupVisible = 0;
            for (const item of items) {
              const show = value === 'all' || item.dataset.type === value;
              item.hidden = !show;
              if (show) groupVisible += 1;
            }
            group.hidden = groupVisible === 0;
            visible += groupVisible;
          }
          if (empty) empty.classList.toggle('hidden', visible > 0);
          for (const button of buttons) {
            const active = button.dataset.filter === value;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          }
        };

        for (const button of buttons) {
          button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
        }
      }
    </script>
  </Fragment>
</BaseLayout>

<style>
  .tl-filter {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.375rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    padding: 0.3rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--dur-1) ease-out,
      background-color var(--dur-1) ease-out,
      border-color var(--dur-1) ease-out;
  }

  .tl-filter:hover {
    color: var(--ink);
    background: var(--hover);
    border-color: var(--line-strong);
  }

  .tl-filter.is-active {
    color: var(--canvas);
    background: var(--ink-strong);
    border-color: var(--ink-strong);
  }

  .tl-filter.is-active .mono {
    color: color-mix(in oklab, var(--canvas) 72%, transparent);
  }
</style>
