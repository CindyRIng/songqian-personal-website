---
/**
 * TimelineView — `/timeline` (zh) and `/en/timeline` (en).
 *
 * A+ direction: one big serif year on the left (sticky on desktop), the entry
 * cards on the right, hairline rules between year groups. Type filtering is
 * progressive enhancement — the no-JS page is the complete timeline.
 *
 * Polish: sticky year marks the current band while scrolling (IntersectionObserver,
 * no scroll listeners), type dots match the filter chips, chips have
 * hover/press/focus/44px-touch states, entering entries fade with a 20ms
 * stagger, everything re-binds after client-side navigation and is
 * reduced-motion safe.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import TimelineEntry from '../components/timeline/TimelineEntry.astro';
import { TIMELINE_TYPE_DOTS } from '../components/timeline/type-colors';
import { copy, c } from '../data/copy';
import { localizePath, useTranslations } from '../i18n/utils';
import { SITE, localeMeta, type Locale } from '../i18n/config';
import {
  TIMELINE_TYPES,
  TIMELINE_TYPE_KEYS,
  countTimelineByType,
  getTimeline,
  groupTimelineByYear,
} from '../data/timeline';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = getTimeline(lang);
const groups = groupTimelineByYear(entries);
const counts = countTimelineByType(entries);
const activeTypes = TIMELINE_TYPES.filter((type) => counts[type] > 0);

const siteUrl = Astro.site ?? new URL(SITE.url);
const timelineJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: c(copy.timeline.title, lang),
      description: c(copy.meta.timelineDescription, lang),
      url: new URL(localizePath('/timeline', lang), siteUrl).href,
      inLanguage: localeMeta[lang].htmlLang,
    },
    {
      '@type': 'ItemList',
      itemListElement: entries.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${entry.org} · ${entry.role}`,
        description: entry.summary,
        startDate: entry.start,
        endDate: entry.end ?? undefined,
      })),
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={c(copy.timeline.title, lang)}
  description={c(copy.meta.timelineDescription, lang)}
  path="/timeline"
  wide
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(timelineJsonLd)} />
  </Fragment>
  <header class="wrap pt-2 sm:pt-6">
    <SectionHeading
      title={c(copy.timeline.title, lang)}
      lede={c(copy.timeline.lede, lang)}
      id="timeline-title"
      headingLevel="h1"
    />

    <!-- Type filter (hidden until the script runs) -->
    <div
      class="mt-8 flex flex-wrap items-center gap-1.5"
      data-timeline-filters
      style="display: none;"
      role="group"
      aria-label={t('timeline.filterAll')}
    >
      <button type="button" class="tl-filter focus-ring is-active" data-filter="all" aria-pressed="true">
        {t('timeline.filterAll')}
        <span class="mono text-[0.625rem] text-subtle">{entries.length}</span>
      </button>
      {
        activeTypes.map((type) => (
          <button type="button" class="tl-filter focus-ring" data-filter={type} aria-pressed="false">
            <span class="type-dot" style={`background: ${TIMELINE_TYPE_DOTS[type]}`} aria-hidden="true"></span>
            {t(TIMELINE_TYPE_KEYS[type])}
            <span class="mono text-[0.625rem] text-subtle">{counts[type]}</span>
          </button>
        ))
      }
    </div>

    <p class="mt-8 hidden text-[0.9375rem] leading-relaxed text-subtle" data-timeline-empty role="status">
      {t('common.noResults')}
    </p>
  </header>

  <div class="wrap mt-10 sm:mt-14">
    {
      groups.map((group) => (
        <section
          class="grid grid-cols-[4.5rem_1fr] gap-x-4 border-t border-line py-10 first:border-t-0 md:grid-cols-[10rem_1fr] md:gap-x-12 md:py-14"
          data-timeline-group
          data-year={String(group.year)}
          aria-label={String(group.year)}
        >
          <div class="tl-year md:sticky md:top-28 md:self-start">
            <h2 class="tl-year-num font-serif text-[clamp(1.75rem,6vw,3.5rem)] font-[520] leading-none tracking-[-0.03em] text-ink-strong tabular">
              {group.year}
            </h2>
            <span class="tl-year-marker" aria-hidden="true"></span>
            <span class="mono mt-2 hidden text-[0.625rem] uppercase tracking-[0.14em] text-subtle md:block">
              {String(group.entries.length).padStart(2, '0')} {lang === 'zh' ? '条' : 'entries'}
            </span>
          </div>

          <div class="flex min-w-0 flex-col">
            {group.entries.map((entry, index) => (
              <TimelineEntry lang={lang} entry={entry} delay={Math.min(index * 60, 240)} />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <!-- Cross-navigation ----------------------------------------------------- -->
  <div class="wrap mt-4 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
    <a
      href={localizePath('/about', lang)}
      class="group focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
    >
      <Icon
        name="arrow-left"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:-translate-x-0.5"
      />
      {t('nav.about')}
    </a>
    <a
      href={localizePath('/works', lang)}
      class="group focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
    >
      {t('nav.works')}
      <Icon
        name="arrow-right"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
      />
    </a>
  </div>

  <Fragment slot="scripts">
    <script>
      // Quiet type filter + sticky-year highlight. Both re-bind after Astro's
      // client-side navigation; all motion is skipped under reduced-motion.
      let yearObserver: IntersectionObserver | undefined;

      function initTimeline() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const filters = document.querySelector<HTMLElement>('[data-timeline-filters]');
        const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-timeline-group]'));

        /* ---- Type filter ------------------------------------------------- */
        if (filters && groups.length > 0) {
          filters.style.display = '';
          if (filters.dataset.bound !== 'true') {
            filters.dataset.bound = 'true';

            const empty = document.querySelector<HTMLElement>('[data-timeline-empty]');
            const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-filter]'));

            // Fade + 6px rise with a 20ms stagger. Web Animations is used so
            // the effect also applies to entries rendered by a child component.
            const stagger = (elements: HTMLElement[]) => {
              if (reduceMotion.matches || elements.length === 0) return;
              elements.forEach((el, index) => {
                const animation = el.animate(
                  [
                    { opacity: 0, transform: 'translateY(6px)' },
                    { opacity: 1, transform: 'none' },
                  ],
                  {
                    duration: 200,
                    delay: index * 20,
                    easing: 'cubic-bezier(0.22, 0.68, 0.24, 1)',
                    fill: 'both',
                  }
                );
                animation.finished
                  .then(() => animation.cancel())
                  .catch(() => {
                    /* navigation cancelled the animation — nothing to clean up */
                  });
              });
            };

            const apply = (value: string) => {
              let visible = 0;
              const entering: HTMLElement[] = [];
              for (const group of groups) {
                const items = Array.from(group.querySelectorAll<HTMLElement>('[data-timeline-item]'));
                let groupVisible = 0;
                for (const item of items) {
                  const show = value === 'all' || item.dataset.type === value;
                  const wasHidden = item.hidden;
                  item.hidden = !show;
                  if (show) {
                    groupVisible += 1;
                    if (wasHidden) entering.push(item);
                  }
                }
                group.hidden = groupVisible === 0;
                visible += groupVisible;
              }
              if (empty) empty.classList.toggle('hidden', visible > 0);
              for (const button of buttons) {
                const active = button.dataset.filter === value;
                button.classList.toggle('is-active', active);
                button.setAttribute('aria-pressed', String(active));
              }
              stagger(entering);
            };

            for (const button of buttons) {
              button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
            }
          }
        }

        /* ---- Sticky year highlight (no scroll listeners) ----------------- */
        yearObserver?.disconnect();
        const yearEls = new Map<string, HTMLElement>();
        for (const group of groups) {
          const yearEl = group.querySelector<HTMLElement>('.tl-year');
          const year = group.dataset.year ?? '';
          if (yearEl) yearEls.set(year, yearEl);
        }
        if (groups.length > 0 && typeof IntersectionObserver !== 'undefined') {
          const visibleYears = new Set<string>();
          yearObserver = new IntersectionObserver(
            (observed) => {
              for (const entry of observed) {
                const year = (entry.target as HTMLElement).dataset.year ?? '';
                if (entry.isIntersecting) visibleYears.add(year);
                else visibleYears.delete(year);
              }
              let active = '';
              for (const group of groups) {
                const year = group.dataset.year ?? '';
                if (visibleYears.has(year)) {
                  active = year;
                  break;
                }
              }
              for (const [year, element] of yearEls) {
                element.classList.toggle('is-current', year === active);
              }
            },
            { rootMargin: '-30% 0px -55% 0px', threshold: 0 }
          );
          for (const group of groups) yearObserver.observe(group);
        }
      }

      document.addEventListener('astro:page-load', initTimeline);
      initTimeline();
    </script>
  </Fragment>
</BaseLayout>

<style>
  .tl-filter {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill, 999px);
    background: transparent;
    padding: 0.3rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--muted);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color var(--dur-1) ease-out,
      background-color var(--dur-1) ease-out,
      border-color var(--dur-1) ease-out,
      transform var(--dur-press, 100ms) var(--ease-out);
  }

  @media (hover: none) {
    .tl-filter {
      min-height: 2.75rem;
      padding-inline: 0.85rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .tl-filter:hover {
      color: var(--ink);
      background: var(--hover);
      border-color: var(--line-strong);
    }
  }

  .tl-filter:active {
    transform: translateY(1px) scale(0.985);
  }

  .tl-filter.is-active {
    color: var(--canvas);
    background: var(--ink-strong);
    border-color: var(--ink-strong);
  }

  .tl-filter.is-active .mono {
    color: color-mix(in oklab, var(--canvas) 72%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .tl-filter.is-active:hover {
      background: var(--accent-strong);
      border-color: var(--accent-strong);
    }
  }

  .type-dot {
    display: inline-block;
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    transform: translateY(-1px);
  }

  /* Sticky year: hairline marker + accent when the band is in focus. */
  .tl-year {
    position: relative;
    padding-left: 1rem;
    margin-left: -1rem;
    border-left: 1px solid transparent;
    transition:
      border-color var(--dur-3) var(--ease-out),
      color var(--dur-3) var(--ease-out);
  }

  .tl-year-num {
    transition: color var(--dur-3) var(--ease-out);
  }

  .tl-year-marker {
    display: block;
    width: 1.25rem;
    height: 2px;
    margin-top: 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0;
    transform: scaleX(0.4);
    transform-origin: left center;
    transition:
      opacity var(--dur-3) var(--ease-out),
      transform var(--dur-3) var(--ease-out);
  }

  .tl-year.is-current {
    border-left-color: var(--accent-line);
  }

  .tl-year.is-current .tl-year-num {
    color: var(--accent-strong);
  }

  .tl-year.is-current .tl-year-marker {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-filter,
    .tl-filter:active {
      transition: none;
      transform: none;
    }

    .tl-year,
    .tl-year-num,
    .tl-year-marker {
      transition: none;
    }

    .tl-year-marker {
      transform: none;
    }

  }
</style>
