---
/**
 * WorksView — `/works` (zh) and `/en/works` (en).
 *
 * A+ direction: one numbered section heading, two featured projects rendered
 * as credible CLI windows (TerminalCard), then the four remaining tools as
 * compact editorial rows. Category filtering is progressive enhancement — the
 * no-JS page is the complete list.
 *
 * Polish: chips have hover/press/focus states and a 44px touch target; filtering
 * fades the entering cards in with a 20ms stagger (motion-off under
 * reduced-motion); the filter script re-binds after client-side navigation.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import FeaturedWorkCard from '../components/projects/FeaturedWorkCard.astro';
import WorkRow from '../components/projects/WorkRow.astro';
import { terminalFor } from '../components/projects/terminal';
import { copy, c } from '../data/copy';
import { localizePath, useTranslations } from '../i18n/utils';
import { SITE, localeMeta, type Locale } from '../i18n/config';
import { getLocalizedProjects, PROJECT_CATEGORIES, type ProjectCategory } from '../lib/projects';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getLocalizedProjects(lang);
const featured = projects.filter((project) => project.featured);
const tools = projects.filter((project) => !project.featured);

const FILTERABLE: ProjectCategory[] = ['product', 'tool', 'experiment'];
const counts = Object.fromEntries(
  FILTERABLE.map((category) => [category, projects.filter((project) => project.tags.includes(category)).length])
) as Record<ProjectCategory, number>;
const activeFilters = FILTERABLE.filter((category) => counts[category] > 0);

const siteUrl = Astro.site ?? new URL(SITE.url);
const worksJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: c(copy.works.title, lang),
      description: c(copy.works.lede, lang),
      url: new URL(localizePath('/works', lang), siteUrl).href,
      inLanguage: localeMeta[lang].htmlLang,
    },
    {
      '@type': 'ItemList',
      itemListElement: projects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: project.title,
        description: project.tagline,
        url: new URL(localizePath(`/works/${project.slug}`, lang), siteUrl).href,
      })),
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={c(copy.works.title, lang)}
  description={c(copy.meta.worksDescription, lang)}
  path="/works"
  wide
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(worksJsonLd)} />
  </Fragment>
  <!-- Page heading --------------------------------------------------------- -->
  <header class="wrap pt-2 sm:pt-6">
    <SectionHeading
      title={c(copy.works.title, lang)}
      lede={c(copy.works.lede, lang)}
      id="works-title"
      headingLevel="h1"
      data-reveal
    />
    {lang === 'zh' && (
      <p class="mt-2">
        <a class="works-trade-link focus-ring" href="/foreign-trade/">
          这些工具服务于外贸获客与客户管理
          <span aria-hidden="true">→</span>
        </a>
      </p>
    )}
  </header>

  <!-- Category filter (progressive enhancement; hidden until the script runs) -->
  <div
    class="wrap mt-8 flex flex-wrap items-center gap-1.5"
    data-work-filters
    style="display: none;"
    role="group"
    aria-label={c(copy.works.filterLabel, lang)}
  >
    <span class="label mr-2">{c(copy.works.filterLabel, lang)}</span>
    <button type="button" class="work-filter focus-ring is-active" data-filter="all" aria-pressed="true">
      {t('filter.all')}
      <span class="mono text-[0.625rem] text-subtle">{projects.length}</span>
    </button>
    {
      activeFilters.map((category) => (
        <button type="button" class="work-filter focus-ring" data-filter={category} aria-pressed="false">
          {t(`filter.${category}` as never)}
          <span class="mono text-[0.625rem] text-subtle">{counts[category]}</span>
        </button>
      ))
    }
  </div>

  <p class="wrap mt-8 hidden text-[0.9375rem] leading-relaxed text-subtle" data-work-empty role="status">
    {t('common.noResults')}
  </p>

  <!-- Featured work -------------------------------------------------------- -->
  <section class="wrap mt-12 sm:mt-16" aria-labelledby="works-featured" data-works-block="featured">
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3" data-reveal>
      <h2 id="works-featured" class="label">{c(copy.works.featuredTitle, lang)}</h2>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-8">
      {
        featured.map((project, index) => {
          const terminal = terminalFor(project.slug, lang);
          if (!terminal) return null;
          return (
            <FeaturedWorkCard lang={lang} project={project} terminal={terminal} delay={index * 80} />
          );
        })
      }
    </div>
  </section>

  <!-- Tools ---------------------------------------------------------------- -->
  <section class="wrap mt-16 sm:mt-24" aria-labelledby="works-tools" data-works-block="tools">
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3" data-reveal>
      <h2 id="works-tools" class="label">{c(copy.works.toolsTitle, lang)}</h2>
    </div>

    <div class="mt-2">
      {
        tools.map((project) => (
          <WorkRow
            lang={lang}
            project={project}
            index={projects.findIndex((entry) => entry.slug === project.slug) + 1}
          />
        ))
      }
    </div>
  </section>

  <!-- Quiet cross-navigation ------------------------------------------------ -->
  <div class="wrap mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6" data-reveal>
    <a
      href={localizePath('/about', lang)}
      class="group focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
    >
      {t('nav.about')}
      <Icon
        name="arrow-right"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
      />
    </a>
    <a
      href={localizePath('/writing', lang)}
      class="group focus-ring inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
    >
      {t('nav.writing')}
      <Icon
        name="arrow-right"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
      />
    </a>
  </div>

  <Fragment slot="scripts">
    <script>
      // Quiet category filter — the no-JS page already lists everything.
      // Re-binds after client-side navigation; entering cards fade in with a
      // 20ms stagger (skipped under prefers-reduced-motion).
      function initWorkFilters() {
        const filters = document.querySelector<HTMLElement>('[data-work-filters]');
        const items = Array.from(document.querySelectorAll<HTMLElement>('[data-work-item]'));
        if (!filters || items.length === 0) return;

        filters.style.display = '';
        if (filters.dataset.bound === 'true') return;
        filters.dataset.bound = 'true';

        const empty = document.querySelector<HTMLElement>('[data-work-empty]');
        const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-filter]'));
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        // Fade + 6px rise with a 20ms stagger. Web Animations is used instead
        // of a CSS class because the cards live in child components, where a
        // scoped CSS class would not match.
        const stagger = (elements: HTMLElement[]) => {
          if (reduceMotion.matches || elements.length === 0) return;
          elements.forEach((el, index) => {
            const animation = el.animate(
              [
                { opacity: 0, transform: 'translateY(6px)' },
                { opacity: 1, transform: 'none' },
              ],
              {
                duration: 200,
                delay: index * 20,
                easing: 'cubic-bezier(0.22, 0.68, 0.24, 1)',
                fill: 'both',
              }
            );
            animation.finished
              .then(() => animation.cancel())
              .catch(() => {
                /* navigation cancelled the animation — nothing to clean up */
              });
          });
        };

        const apply = (value: string, animate = true) => {
          let visible = 0;
          const entering: HTMLElement[] = [];
          for (const item of items) {
            const tags = (item.dataset.tags ?? '').split(/\s+/).filter(Boolean);
            const show = value === 'all' || tags.includes(value);
            const wasHidden = item.hidden;
            item.hidden = !show;
            if (show) visible += 1;
            if (show && wasHidden) entering.push(item);
          }
          if (empty) empty.classList.toggle('hidden', visible > 0);
          // Hide an entire sub-block when the active filter leaves it empty.
          for (const block of Array.from(document.querySelectorAll<HTMLElement>('[data-works-block]'))) {
            const blockItems = Array.from(block.querySelectorAll<HTMLElement>('[data-work-item]'));
            block.hidden = !blockItems.some((item) => !item.hidden);
          }
          for (const button of buttons) {
            const active = button.dataset.filter === value;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          }
          if (animate) stagger(entering);
        };

        for (const button of buttons) {
          button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
        }
      }

      document.addEventListener('astro:page-load', initWorkFilters);
      initWorkFilters();
    </script>
  </Fragment>
</BaseLayout>

<style>
  /* One-line pointer to the foreign-trade cluster under the Works title. */
  .works-trade-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin-block: -0.6875rem;
    padding-block: 0.6875rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--muted);
    text-decoration: none;
    touch-action: manipulation;
    transition: color var(--dur-1, 120ms) ease-out;
  }

  .works-trade-link span {
    color: var(--accent);
    display: inline-block;
    transition: transform var(--dur-2, 200ms) var(--ease-out, ease-out);
  }

  .works-trade-link:active {
    transform: translateY(1px);
  }

  .works-trade-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: var(--ring-offset, 3px);
    border-radius: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .works-trade-link:hover {
      color: var(--accent-strong);
    }

    .works-trade-link:hover span {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .works-trade-link,
    .works-trade-link span {
      transition: none;
    }

    .works-trade-link:active,
    .works-trade-link:hover span {
      transform: none;
    }
  }

  .work-filter {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill, 999px);
    background: transparent;
    padding: 0.3rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--muted);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      color var(--dur-1) ease-out,
      background-color var(--dur-1) ease-out,
      border-color var(--dur-1) ease-out,
      transform var(--dur-press, 100ms) var(--ease-out);
  }

  /* Touch: keep a comfortable 44px hit area. */
  @media (hover: none) {
    .work-filter {
      min-height: 2.75rem;
      padding-inline: 0.85rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .work-filter:hover {
      color: var(--ink);
      background: var(--hover);
      border-color: var(--line-strong);
    }
  }

  .work-filter:active {
    transform: translateY(1px) scale(0.985);
  }

  .work-filter.is-active {
    color: var(--canvas);
    background: var(--ink-strong);
    border-color: var(--ink-strong);
  }

  .work-filter.is-active .mono {
    color: color-mix(in oklab, var(--canvas) 72%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-filter.is-active:hover {
      background: var(--accent-strong);
      border-color: var(--accent-strong);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-filter,
    .work-filter:active {
      transition: none;
      transform: none;
    }

  }
</style>
