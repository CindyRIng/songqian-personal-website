---
/**
 * WorksView — `/works` (zh) and `/en/works` (en).
 *
 * A+ direction: one numbered section heading, two featured projects rendered
 * as credible CLI windows (TerminalCard), then the four remaining tools as
 * compact editorial rows. Category filtering is progressive enhancement — the
 * no-JS page is the complete list.
 *
 * TODO(forge): imports below follow rebuild-spec §3 and will resolve once
 * `ui/SectionHeading.astro` and `ui/TerminalCard.astro` land.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Icon from '../components/ui/Icon.astro';
import FeaturedWorkCard from '../components/projects/FeaturedWorkCard.astro';
import WorkRow from '../components/projects/WorkRow.astro';
import { terminalFor } from '../components/projects/terminal';
import { copy, c } from '../data/copy';
import { localizePath, useTranslations } from '../i18n/utils';
import { SITE, localeMeta, type Locale } from '../i18n/config';
import { getLocalizedProjects, PROJECT_CATEGORIES, type ProjectCategory } from '../lib/projects';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getLocalizedProjects(lang);
const featured = projects.filter((project) => project.featured);
const tools = projects.filter((project) => !project.featured);

const FILTERABLE: ProjectCategory[] = ['product', 'tool', 'experiment'];
const counts = Object.fromEntries(
  FILTERABLE.map((category) => [category, projects.filter((project) => project.tags.includes(category)).length])
) as Record<ProjectCategory, number>;
const activeFilters = FILTERABLE.filter((category) => counts[category] > 0);

const siteUrl = Astro.site ?? new URL(SITE.url);
const worksJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: c(copy.works.title, lang),
      description: c(copy.works.lede, lang),
      url: new URL(localizePath('/works', lang), siteUrl).href,
      inLanguage: localeMeta[lang].htmlLang,
    },
    {
      '@type': 'ItemList',
      itemListElement: projects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: project.title,
        description: project.tagline,
        url: new URL(localizePath(`/works/${project.slug}`, lang), siteUrl).href,
      })),
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={c(copy.works.title, lang)}
  description={c(copy.meta.worksDescription, lang)}
  path="/works"
  wide
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(worksJsonLd)} />
  </Fragment>
  <!-- Page heading --------------------------------------------------------- -->
  <header class="wrap pt-2 sm:pt-6">
    <SectionHeading
      number="01"
      title={c(copy.works.title, lang)}
      en={lang === 'zh' ? 'Works' : '作品'}
      lede={c(copy.works.lede, lang)}
      id="works-title"
      data-reveal
    />
  </header>

  <!-- Category filter (progressive enhancement; hidden until the script runs) -->
  <div class="wrap mt-8 flex flex-wrap items-center gap-1.5" data-work-filters style="display: none;" role="group" aria-label={c(copy.works.filterLabel, lang)}>
    <span class="label mr-2">{c(copy.works.filterLabel, lang)}</span>
    <button type="button" class="work-filter is-active" data-filter="all" aria-pressed="true">
      {t('filter.all')}
      <span class="mono text-[0.625rem] text-subtle">{projects.length}</span>
    </button>
    {
      activeFilters.map((category) => (
        <button type="button" class="work-filter" data-filter={category} aria-pressed="false">
          {t(`filter.${category}` as never)}
          <span class="mono text-[0.625rem] text-subtle">{counts[category]}</span>
        </button>
      ))
    }
  </div>

  <p class="wrap mt-8 hidden text-[0.9375rem] leading-relaxed text-subtle" data-work-empty role="status">
    {t('common.noResults')}
  </p>

  <!-- Featured work -------------------------------------------------------- -->
  <section class="wrap mt-12 sm:mt-16" aria-labelledby="works-featured">
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3" data-reveal>
      <h2 id="works-featured" class="label">{c(copy.works.featuredTitle, lang)}</h2>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-8">
      {
        featured.map((project, index) => {
          const terminal = terminalFor(project.slug, lang);
          if (!terminal) return null;
          return (
            <FeaturedWorkCard
              lang={lang}
              project={project}
              terminal={terminal}
              delay={index * 80}
            />
          );
        })
      }
    </div>
  </section>

  <!-- Tools ---------------------------------------------------------------- -->
  <section class="wrap mt-16 sm:mt-24" aria-labelledby="works-tools">
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3" data-reveal>
      <h2 id="works-tools" class="label">{c(copy.works.toolsTitle, lang)}</h2>
    </div>

    <div class="mt-2">
      {
        tools.map((project) => (
          <WorkRow
            lang={lang}
            project={project}
            index={projects.findIndex((entry) => entry.slug === project.slug) + 1}
          />
        ))
      }
    </div>
  </section>

  <!-- Quiet cross-navigation ------------------------------------------------ -->
  <div class="wrap mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6" data-reveal>
    <a
      href={localizePath('/about', lang)}
      class="group inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
    >
      {t('nav.about')}
      <Icon
        name="arrow-right"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
      />
    </a>
    <a
      href={localizePath('/writing', lang)}
      class="group inline-flex min-h-11 items-center gap-2 text-[0.875rem] text-muted transition-colors duration-200 hover:text-ink"
    >
      {t('nav.writing')}
      <Icon
        name="arrow-right"
        size={14}
        class="transition duration-200 ease-[var(--ease-out)] group-hover:translate-x-0.5"
      />
    </a>
  </div>

  <Fragment slot="scripts">
    <script>
      // Quiet category filter — the no-JS page already lists everything.
      const filters = document.querySelector<HTMLElement>('[data-work-filters]');
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-work-item]'));
      const empty = document.querySelector<HTMLElement>('[data-work-empty]');

      if (filters && items.length > 0) {
        filters.style.display = '';
        const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-filter]'));

        const apply = (value: string) => {
          let visible = 0;
          for (const item of items) {
            const tags = (item.dataset.tags ?? '').split(/\s+/).filter(Boolean);
            const show = value === 'all' || tags.includes(value);
            item.hidden = !show;
            if (show) visible += 1;
          }
          if (empty) empty.classList.toggle('hidden', visible > 0);
          for (const button of buttons) {
            const active = button.dataset.filter === value;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          }
        };

        for (const button of buttons) {
          button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
        }
      }
    </script>
  </Fragment>
</BaseLayout>

<style>
  .work-filter {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    gap: 0.375rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    padding: 0.3rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--dur-1) ease-out,
      background-color var(--dur-1) ease-out,
      border-color var(--dur-1) ease-out;
  }

  .work-filter:hover {
    color: var(--ink);
    background: var(--hover);
    border-color: var(--line-strong);
  }

  .work-filter.is-active {
    color: var(--canvas);
    background: var(--ink-strong);
    border-color: var(--ink-strong);
  }

  .work-filter.is-active .mono {
    color: color-mix(in oklab, var(--canvas) 72%, transparent);
  }
</style>
