---
/**
 * WritingView — the numbered writing index (A+ direction).
 *
 * Header: section number + bilingual title + lede + RSS.
 * List: 01 featured entry set larger, 02–05 compact rows with the other
 * language's title as an italic subtitle, category · date meta and an arrow.
 * Pagination (8 per page) is kept; it only renders when there is more than one
 * page.
 */
import type { Page } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import EssayRow from '../components/writing/EssayRow.astro';
import Pagination from '../components/writing/Pagination.astro';
import { localizePath, useTranslations } from '../i18n/utils';
import { copy, c, pair } from '../data/copy';
import type { Locale } from '../i18n/config';
import type { PostEntry } from '../lib/posts';

interface Props {
  lang: Locale;
  page: Page<PostEntry>;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);

const posts = page.data;
const title = pair(copy.writing.title, lang);
const lede = c(copy.writing.lede, lang);
const rssHref = localizePath('/rss.xml', lang);
const label = `${copy.sections.writing.number} / ${copy.sections.writing.title[lang]}`;

/** Index numbers continue across paginated pages. */
const startIndex = (page.currentPage - 1) * page.size + 1;
const pageTitle =
  page.currentPage > 1
    ? `${title.title} · ${t('common.pageOf', { n: page.currentPage, total: page.lastPage })}`
    : `${copy.writing.title.zh} · ${copy.writing.title.en}`;
---
<BaseLayout lang={lang} title={pageTitle} description={c(copy.meta.writingDescription, lang)} wide>
  <div class="wrap">
    <header class="flex flex-col gap-6 pb-10 sm:pb-14">
      <p class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-subtle">{label}</p>

      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-6">
        <h1 class="display">
          {title.title}
          <span
            class:list={[
              'ml-2 inline-block align-baseline sm:ml-4',
              lang === 'zh'
                ? 'display-latin text-[0.62em] text-muted'
                : 'font-serif text-[0.55em] font-[420] tracking-[-0.02em] text-muted',
            ]}
          >
            {title.secondary}
          </span>
        </h1>

        <a
          href={rssHref}
          class="group inline-flex items-center gap-2 border-b border-line pb-1 font-sans text-[0.8125rem] text-subtle transition-colors hover:border-line-strong hover:text-ink"
        >
          <Icon name="rss" size={13} />
          <span class="hidden sm:inline">{t('footer.rss')}</span>
        </a>
      </div>

      <p class="lede max-w-[36rem]">{lede}</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="border-t border-line py-10 font-serif text-[1.0625rem] text-muted">
          {t('common.noResults')}
        </p>
      ) : (
        <ol class="border-t border-line">
          {posts.map((post, i) => (
            <li>
              <EssayRow
                post={post}
                lang={lang}
                index={startIndex + i}
                featured={page.currentPage === 1 && i === 0}
              />
            </li>
          ))}
        </ol>
      )
    }

    <Pagination lang={lang} page={page.currentPage} totalPages={page.lastPage} />
  </div>
</BaseLayout>
