---
/**
 * WritingView — the numbered writing index (A+ direction).
 *
 * Header: single-language title, one-line lede, last-updated date + essay count
 * and RSS — no bilingual pairs in the page chrome.
 * List: 01 featured entry set larger, 02–05 compact rows with category · date
 * meta and an arrow. Numbering stays: it reads like a table of contents.
 * Pagination (8 per page) only renders when there is more than one page.
 */
import type { Page } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import EssayRow from '../components/writing/EssayRow.astro';
import Pagination from '../components/writing/Pagination.astro';
import { isoDate, localizePath, useTranslations } from '../i18n/utils';
import { copy, c } from '../data/copy';
import { SITE, localeMeta, type Locale } from '../i18n/config';
import { getAllPosts, type PostEntry } from '../lib/posts';

interface Props {
  lang: Locale;
  page: Page<PostEntry>;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);

const posts = page.data;
const title = c(copy.writing.title, lang);
const lede = c(copy.writing.lede, lang);
const rssHref = localizePath('/rss.xml', lang);

/* Dated notebook meta: when the shelf was last touched and how much is on it. */
const allPosts = await getAllPosts(lang);
const lastUpdated = allPosts.reduce<Date | null>((latest, post) => {
  const stamp = post.updated ?? post.date;
  return !latest || stamp > latest ? stamp : latest;
}, null);
const updatedLabel = lastUpdated ? isoDate(lastUpdated).replaceAll('-', '.') : '';
const countLabel =
  lang === 'zh'
    ? `最后更新 ${updatedLabel} · 共 ${allPosts.length} 篇`
    : `Last updated ${updatedLabel} · ${allPosts.length} ${allPosts.length === 1 ? 'essay' : 'essays'}`;

/** Index numbers continue across paginated pages. */
const startIndex = (page.currentPage - 1) * page.size + 1;
const listingJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: title,
      description: lede,
      url: new URL(localizePath(page.currentPage > 1 ? `/writing/${page.currentPage}` : '/writing', lang), Astro.site ?? new URL(SITE.url)).href,
      inLanguage: localeMeta[lang].htmlLang,
      isPartOf: { '@type': 'WebSite', url: (Astro.site ?? new URL(SITE.url)).href },
    },
    {
      '@type': 'ItemList',
      itemListElement: posts.map((post, index) => ({
        '@type': 'ListItem',
        position: startIndex + index,
        url: new URL(localizePath(post.path, lang), Astro.site ?? new URL(SITE.url)).href,
        name: post.title,
      })),
    },
  ],
};

const pageTitle =
  page.currentPage > 1
    ? `${title} · ${t('common.pageOf', { n: page.currentPage, total: page.lastPage })}`
    : title;
---
<BaseLayout lang={lang} title={pageTitle} description={c(copy.meta.writingDescription, lang)} wide>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(listingJsonLd)} />
  </Fragment>
  <div class="wrap">
    <header class="border-t border-line pt-5 pb-10 sm:pb-12">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
        <p class="font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-subtle">
          {countLabel}
        </p>
        <a href={rssHref} class="rss-link group">
          <Icon name="rss" size={13} class="rss-link-icon" />
          <span class="rss-link-text">{t('footer.rss')}</span>
        </a>
      </div>

      <h1 class="display mt-6">{title}</h1>

      <p class="lede mt-5 max-w-[36rem]">{lede}</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="border-t border-line py-10 font-serif text-[1.0625rem] text-muted">
          {t('common.noResults')}
        </p>
      ) : (
        <ol class="border-t border-line">
          {posts.map((post, i) => (
            <li>
              <EssayRow
                post={post}
                lang={lang}
                index={startIndex + i}
                featured={page.currentPage === 1 && i === 0}
              />
            </li>
          ))}
        </ol>
      )
    }

    <Pagination lang={lang} page={page.currentPage} totalPages={page.lastPage} />
  </div>
</BaseLayout>

<style>
  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-block: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--subtle);
    touch-action: manipulation;
    transition: color var(--dur-1) ease-out;
  }

  .rss-link .rss-link-text {
    border-bottom: 1px solid var(--line);
    padding-bottom: 1px;
    transition:
      border-color var(--dur-1) ease-out,
      color var(--dur-1) ease-out;
  }

  .rss-link .rss-link-icon {
    transition: color var(--dur-1) ease-out;
  }

  .rss-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: var(--ring-offset);
    border-radius: 4px;
  }

  .rss-link:active {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .rss-link:hover {
      color: var(--ink);
    }

    .rss-link:hover .rss-link-text {
      border-color: var(--line-strong);
    }

    .rss-link:hover .rss-link-icon {
      color: var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rss-link,
    .rss-link .rss-link-text,
    .rss-link .rss-link-icon {
      transition: color var(--dur-1) ease-out;
    }
  }
</style>
