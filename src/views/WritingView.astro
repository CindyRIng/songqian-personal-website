---
/**
 * WritingView — the shared writing index template for all six locales.
 *
 * Page 1 opens with the featured essay set as an editorial lead (large CSS
 * cover art, serif title, muted lede), followed by quiet rows. Later pages are
 * pure rows. Pagination is two circular arrows plus a localized "Page N of M".
 */
import type { Page } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import PostCover from '../components/writing/PostCover.astro';
import PostMeta from '../components/writing/PostMeta.astro';
import PostRow from '../components/writing/PostRow.astro';
import Pagination from '../components/writing/Pagination.astro';
import { localizePath, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import type { TranslationKey } from '../i18n/ui';
import type { PostEntry } from '../lib/posts';

interface Props {
  lang: Locale;
  page: Page<PostEntry>;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);

const posts = page.data;
const isFirstPage = page.currentPage === 1;
const lead = isFirstPage ? posts.find((post) => post.featured) : undefined;
const rest = lead ? posts.filter((post) => post.slug !== lead.slug) : posts;

const rssHref = localizePath('/rss.xml', lang);
const categoryKey = (category: PostEntry['category']) =>
  `writing.category.${category}` as TranslationKey;

const title = page.currentPage === 1 ? t('writing.title') : `${t('writing.title')} · ${page.currentPage}/${page.lastPage}`;
---
<BaseLayout lang={lang} title={title} description={t('writing.subtitle')}>
  <div class="flex flex-col gap-12 sm:gap-14">
    <header class="flex flex-col gap-4">
      <div class="flex items-start justify-between gap-6">
        <div class="flex min-w-0 flex-col gap-3">
          <h1
            class="font-serif text-[1.875rem] font-[550] leading-[1.1] tracking-[-0.022em] text-ink-strong sm:text-[2rem]"
          >
            {t('writing.title')}
          </h1>
          <p class="max-w-[30rem] font-serif text-[1.0625rem] leading-[1.65] text-muted text-pretty">
            {t('writing.subtitle')}
          </p>
        </div>

        <a
          href={rssHref}
          class="mt-1 inline-flex shrink-0 items-center gap-1.5 rounded-full border border-line px-3 py-1.5 font-sans text-[0.75rem] text-subtle transition-colors duration-200 ease-out hover:bg-hover hover:text-ink"
          aria-label={t('home.rss')}
        >
          <Icon name="rss" size={13} />
          <span class="hidden sm:inline">{t('home.rss')}</span>
        </a>
      </div>

      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-[0.75rem] text-subtle">
        <span class="tabular">{t('writing.essayCount', { n: page.total })}</span>
      </p>
    </header>

    {
      posts.length === 0 && (
        <p class="py-4 font-serif text-[1rem] text-muted">{t('writing.empty')}</p>
      )
    }

    {
      lead && (
        <a href={localizePath(lead.path, lang)} class="group flex flex-col gap-5">
          <PostCover
            slug={lead.slug}
            title={lead.title}
            year={lead.date.getUTCFullYear()}
            size="hero"
            class="aspect-[16/9] transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.012] sm:aspect-[16/7]"
          />
          <div class="flex flex-col gap-2.5">
            <p class="eyebrow flex flex-wrap items-center gap-x-2 gap-y-1">
              <span class="text-accent">{t(categoryKey(lead.category))}</span>
              <span aria-hidden="true" class="text-faint">·</span>
              <span class="inline-flex items-center gap-1.5 text-faint">
                <Icon name="sparkle" size={11} />
                {t('writing.featured')}
              </span>
              {
                lead.isFallback && (
                  <span class="font-sans text-[0.625rem] font-medium uppercase tracking-[0.08em] text-faint" title={t('writing.onlyAvailableIn')}>
                    {lead.lang}
                  </span>
                )
              }
            </p>
            <h2 class="font-serif text-[1.375rem] font-[550] leading-[1.22] tracking-[-0.018em] text-ink-strong text-balance sm:text-[1.5rem]">
              {lead.title}
            </h2>
            <p class="max-w-[30rem] font-serif text-[1rem] leading-[1.6] text-muted text-pretty">
              {lead.description}
            </p>
            <PostMeta post={lead} lang={lang} class="pt-0.5" />
          </div>
        </a>
      )
    }

    {
      rest.length > 0 && (
        <div class="flex flex-col border-y border-line divide-y divide-line">
          {rest.map((post) => (
            <PostRow post={post} lang={lang} />
          ))}
        </div>
      )
    }

    {
      page.lastPage > 1 && (
        <Pagination lang={lang} page={page.currentPage} totalPages={page.lastPage} />
      )
    }
  </div>
</BaseLayout>
